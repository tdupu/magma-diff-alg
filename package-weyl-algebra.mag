/*

This is a package for working with Weyl Algebras for a general
differential ring (R,delta). The Weyl algebra is the ring R[delta]
which is non-commutative. Every D-Module is some R[delta]-module by
definition.

The fundamental commutation rule is
    delta r = delta(r) + r delta
where delta(r) is understood as the derivation of delta on R. We think
of the ring R[delta] as the ring of linear differential operators so
that r in this ring is really thought of as multiplication by r.

In Magma these are given as a type with element types.

    AlgWeyl[AlgWeylElt].


Created By:
    Taylor Dupuy June 2024
    David Zurieck-Brown June 2024

*/

declare verbose Weyl, 6;


//###############################
//###############################
//      HEAD
//###############################
//###############################


// Declare types and attributes
declare type AlgWeyl[AlgWeylElt];
declare attributes AlgWeyl: rngdiff,weyl_action,weyltup_to_weyldict,weyldict_to_weyltup,derivation,weyl_sum,weyl_prod,der_name;
declare attributes AlgWeylElt: parent, array,tup;

// Constructor for AlgWeyl

//###############################
//###############################
//      AUXILLARY FUNCTIONS
//###############################
//###############################


//######################
function DictEq(dict1,dict2)
//######################
    K1:=Keys(dict1);
    K2:=Keys(dict2);
    if K1 eq K2 then
        return &and[ dict1[k] eq dict2[k] : k in K1];
    else
        return false;
    end if;
end function;

//%%%%%%%%%%%%%%%%%%%%%%%%%%%
function weyl_action(L,A)
//%%%%%%%%%%%%%%%%%%%%%%%%%%%
/*
The action of a Weyl algebra element on a differential polynomial.
    INPUT:
        --L, an element of R[d] represented as a tuple
        --A, an element of R
    OUTPUT:
        --B, an element of R
*/
    B:=&+[(pair[1])*Diff(A,pair[2]) : pair in L];
    return B;
end function;

//%%%%%%%%%%%%%%%%%%%%%%%%%%%
intrinsic weyldict_to_weyltup(example::Assoc)->SeqEnum
//%%%%%%%%%%%%%%%%%%%%%%%%%%%
{}
    return [ <example[k],k>: k in Keys(example)];
end intrinsic;

//%%%%%%%%%%%%%%%%%%%%%%%%%%%
intrinsic clean_weyldict(example::Assoc)->Assoc
//%%%%%%%%%%%%%%%%%%%%%%%%%%%
{}
    my_keys:=Keys(example);
    clean_dict:=AssociativeArray();
    for k in my_keys do
        if example[k] ne 0 then
            clean_dict[k]:=example[k];
        end if;
    end for;
    return clean_dict;
end intrinsic;


//%%%%%%%%%%%%%%%%%%%%%%%%%%%
function weyltup_to_weyldict(my_tuple)
//%%%%%%%%%%%%%%%%%%%%%%%%%%%
/*
The coercion through Eltseqs goes through this function.
We are careful about not passing tuples corresponding to zero matrices.
Also, the "tuples" here are actually SeqEnum types.
*/
    ass_arr:=AssociativeArray();
    for tup in my_tuple do
        n:=tup[2];
        a:=tup[1];
        if not n in Keys(ass_arr) then
            ass_arr[n]:=a;
        else
            ass_arr[n]:=ass_arr[n]+a;
        end if;
    end for;
    
    return clean_weyldict(ass_arr); //remove excess zeros if there are any
end function;

//%%%%%%%%%%%%%%%%%%%%%%%%%%%
function weyl_sum(dict1,dict2)
//%%%%%%%%%%%%%%%%%%%%%%%%%%%
/*
A function for summing dictionaries.

    EXAMPLES:
        >dict1:=AssociativeArray();
        >dict2:=AssociativeArray();
        >dict1[1]:=1;
        >dict1[3]:=1;
        >dict2[1]:=1;
        >dict2[2]:=1;
        >dict2[4]:=1;
        >dict3:=sum_dicts(dict1,dict2);
        >Keys(dict3);
        >dict3[1],dict3[2],dict3[3],dict3[4];
        { 1, 2, 3, 4 }
        2 1 1 1
*/
    dict3:=AssociativeArray();
    K1:={k: k in Keys(dict1)};
    K2:={k: k in Keys(dict2)};
    K12:= K1 meet K2;
    K1missing:={ k: k in K1 | not k in K12 };
    K2missing:={ k: k in K2 | not k in K12 };

    for k in K12 do
        val:=dict1[k]+dict2[k];
        if val ne 0 then
            dict3[k]:=val;
        end if;
    end for;
    for k in K1missing do
        val:=dict1[k];
        if val ne 0 then
            dict3[k]:=val;
        end if;
    end for;
    for k in K2missing do
        val:=dict2[k];
        if val ne 0 then
            dict3[k]:=val;
        end if;
    end for;
    return clean_weyldict(dict3); //removed excess zeros
end function;



//######################
intrinsic CheckTuple(~E::AlgWeylElt)
//######################
{
If a Weyl algebra element is assigned a tuple, do nothing.
If it isn't, update it.
}
    if not assigned E`tup then
        W:=E`parent;
        E`array:=clean_weyldict(E`array);
        E`tup:=weyldict_to_weyltup(E`array);
    end if;
end intrinsic;


//###############################
//###############################
//      AlgWeyl Type
//###############################
//###############################


//############################
intrinsic WeylAlgebra(R::RngDiff) -> AlgWeyl
//############################
{

    Creates a AlgWeyl object with attribute rngdiff initialized to R.
    
}
    T := New(AlgWeyl);
    D:=Derivation(R);
    T`rngdiff:=R;
    T`derivation:=D;
    
    return T;
    
end intrinsic;

//############################
intrinsic WeylAlgebra(R::RngDiff) -> AlgWeyl
//############################
{

    Creates a WeylAlg object with attribute rngdiff initialized to R.
    
}
    T := New(AlgWeyl);
    D:=Derivation(R);
    T`rngdiff:=R;
    T`derivation:=D;
    
    return T;
    
end intrinsic;

//############################
intrinsic WeylAlgebra(R::RngMPolProlSeq) -> AlgWeyl
//############################
{

    Creates a AlgWeyl object with attribute rngdiff initialized to R.
    

}
    T := New(AlgWeyl);
    T`rngdiff:=R;
    T`derivation:=func<f|Diff(f,1)>;
    
    return T;
    
end intrinsic;
    


//#############################
intrinsic Print(X::AlgWeyl)
//#############################
{Print a Weyl algebra object}
  printf "Weyl Algebra ring for %o ", X`rngdiff;
end intrinsic;

//################################
intrinsic Hash(X::AlgWeyl) -> RngIntElt
//################################
{The hash for AlgWeyl is just the hash underlying differential ring
because every Weyl algebra is determined by its differential ring.
}
   // Code: determine a hash value for the given object
   // NOTE: Objects X and Y of type T for which X eq Y is true
   //       MUST have the same hash value
   return Hash(X`rngdiff);
end intrinsic;

//################################
intrinsic 'eq'(T1::AlgWeyl, T2::AlgWeyl) -> BoolElt
//################################
{Checks if two AlgWeyl objects are equal.}
    return T1`rngdiff eq T2`rngdiff;
end intrinsic;

//################################
intrinsic GetDerivationElt(W::AlgWeyl) -> AlgWeylElt
//################################
{For a Weyl algebra R[d] return the element d.}
    return elt(W,[<1,1>]);
end intrinsic;


//###############################
//###############################
// WeylAlgElt Type
//###############################
//###############################

//############################
intrinsic elt(T::AlgWeyl, x::RngElt) -> AlgWeylElt
//############################
{Creates a AlgWeylElt object with parent T and element x.}
    vprintf Weyl, 5: "Entering MakeAlgWeylElt for RngElt\n";
    E := New(AlgWeylElt);
    R:=T`rngdiff;
    E`parent:=T;
 
    require x in R: "%o is not an element of %o", x, R;

    coeffs:=AssociativeArray();
    coeffs[0]:=R!x;
    E`array :=coeffs;
    E`tup:=[<R!x,0>];
    
    return E;
end intrinsic;

//############################
intrinsic elt(T::AlgWeyl, x::RngMPolProlSeqElt) -> AlgWeylElt
//############################
{Creates a AlgWeylElt object with parent T and element x.}
    vprintf Weyl, 5: "Entering MakeAlgWeylElt for RngMPolProSeqElt\n";
    
    require T`rngdiff eq Parent(x): "x must be in the prolongation sequence associated to T";
    E := New(AlgWeylElt);
    E`parent:=T;
    coeffs:=AssociativeArray();
    coeffs[0]:=x;
    E`array :=coeffs;
    E`tup:=[<x,0>];
    return E;
end intrinsic;

//############################
intrinsic Hash(x::AlgWeylElt) -> RngIntElt
//############################
{

The associative array determines the element.
Given that there is no hash for such things we had to make by hashing the equivalent tuple.

}
    my_array:=x`array;
    K:=Keys;
    data:={<k,my_array[k]> : k in Keys};
    return Hash(data);
end intrinsic;

//############################
intrinsic elt(T::AlgWeyl, coeffs::Assoc) -> AlgWeylElt
//############################
{

Construction from a dictionary. This is the primary way we do this.

}
    E := New(AlgWeylElt);
    R:=T`rngdiff;
    truthvals:=[ (coeffs[k] in R) : k in Keys(coeffs)];
    flag:=&and[ x : x in truthvals];
    require flag: "Not all keys are in the differential ring.";
    new_coeffs:=AssociativeArray();
    for k in Keys(coeffs) do
        new_coeffs[k]:=R!coeffs[k];
    end for;
    E`parent := T;
    E`array := new_coeffs;
    return E;
end intrinsic;


//############################
intrinsic elt(T::AlgWeyl, x::SeqEnum) -> AlgWeylElt
//############################
{

Construction from a tuple of pairs of the form
    <a,i>.
Each pair represents a*d^i in R[d].

}
    weyldict:=weyltup_to_weyldict(x);
    E:=elt(T,weyldict);
    CheckTuple(~E);
    return E;
end intrinsic;



//###############################
intrinsic 'eq'(x::AlgWeylElt, y::AlgWeylElt) -> BoolElt
//###############################
{
Checks if two AlgWeylElt objects are equal.
It does so by checking if the parent object are equal and the associated arrays are equal.

}
    return x`parent eq y`parent and DictEq(x`array,y`array);
end intrinsic;

//###############################
intrinsic Print(E::AlgWeylElt)
//###############################
{

Prints a AlgWeylElt object.

}
    CheckTuple(~E);
    myseq:=Eltseq(E);
    W:=Parent(E);
    if not assigned W`der_name then
        W`der_name:="d";
    end if;

    pieces:=[];
    for pair in myseq do
        if pair[1] ne 1 then
            piece:=Sprintf( "%o*%o^%o", pair[1],Parent(E)`der_name,pair[2]);
        else
            piece:=Sprintf( "%o^%o", Parent(E)`der_name,pair[2]);
        end if;
            Append(~pieces,piece);
    end for;
    
    //debugging
    //if #pieces eq 0 then
    //    myseq;
    //end if;
    
    mystring:=pieces[1];
    for i in [2..#pieces] do
        mystring:=mystring cat "+ " cat pieces[i];
    end for;
    printf mystring;
end intrinsic;

//############################
intrinsic '+'(x::AlgWeylElt, y::AlgWeylElt) -> AlgWeylElt
//############################
{

To add to Weyl algebra elements we wrote a function that adds two associative arrays together.
This does a little inclusion/exclusion on the keys and then handles the cases.
That function is weyl_sum.

}
    W:=Parent(x);
    require W eq Parent(y): "Parents must be the same. This test may be too strong.";
    dictx:=x`array;
    dicty:=y`array;
    dictz:=weyl_sum(dictx,dicty);
    return elt(x`parent, dictz);
end intrinsic;


//############################
intrinsic '+'(x::AlgWeylElt, y::RngElt) -> AlgWeylElt
//############################
{

To add to Weyl algebra elements we wrote a function that adds two associative arrays together.
This does a little inclusion/exclusion on the keys and then handles the cases.
That function is weyl_sum.

}
    W:=x`parent;
    R:=W`rngdiff;
    Ey:=elt(W,R!y);
    return x+Ey;
end intrinsic;

//############################
intrinsic '+'(y::RngElt,x::WeylAlgElt) -> AlgWeylElt
//############################
{

To add to Weyl algebra elements we wrote a function that adds two associative arrays together.
This does a little inclusion/exclusion on the keys and then handles the cases.
That function is weyl_sum.

}
    W:=x`parent;
    R:=W`rngdiff;
    Ey:=elt(W,y);
    return x+Ey;
end intrinsic;

//############################
intrinsic '*'(x::AlgWeylElt, y::AlgWeylElt) -> AlgWeylElt
//############################
{
  The main multiplication function is weyl_prod.
}
/*
The multiplication for Weyl Algebra elements represented as tuples.

    INPUT:
        --L1, a tuple representing a Weyl algebra element.
        --L2, a tuple representing a Weyl algebra element.
    
    OUTPUT:
    
        --tuples3,
        --L3
        
The examples are wrong because of a bug.

        EXAMPLES:
            >L1:=[<x1,2>,<1,2>];
            >L2:=[ <x2^2,1>,<x1*x2,0> ];
            >mult_weyltup(L1,L2);
            [<3*d2x1*x1*x2 + 3*d2x2*x1^2 + 6*d1x1*d1x2*x1 + 2*d1x1*x1*x2^3 + 2*d1x1*x2^2 + 2*d1x2*x1^2*x2^2 + 2*d1x2*x1*x2, 1>, <3*d1x1*x1*x2 + 3*d1x2*x1^2 + x1^2*x2^3 + x1*x2^2, 2>, <6*d2x2*x1*x2 + 6*d1x2^2*x1 + 4*d1x2*x1*x2^3 + 4*d1x2*x2^2 + x1^2*x2, 3>, <6*d1x2*x1*x2 + x1*x2^4 + x2^3, 4>, <x1*x2^2, 5>]
*/
    W:=x`parent;
    require W eq y`parent: "Parents must be the same.";
    R:=W`rngdiff;
    
    L1:=Eltseq(x);
    L2:=Eltseq(y);
    L3:=[];

    for i in [1..#L1] do
        for j in [1..#L2] do
            tup1:=L1[i];
            a1:=tup1[1];
            n1:=tup1[2];
            tup2:=L2[j];
            a2:=tup2[1];
            n2:=tup2[2];
            vprintf Weyl, 5: "Type a2, %o \n",Type(a2);
            new_stuff:=[<a1*Binomial(n1,n1-k)*Diff(a2,n1-k),k+n2>:k in [0..n1]];
            L3:=L3 cat new_stuff;
        end for;
    end for;

    
    return W!L3;

end intrinsic;


//############################
intrinsic '*'(x::., y::AlgWeylElt) -> AlgWeylElt
//############################
{
    Given R[d] and x in R and y in R[d] define x*y.
    The speed can be improved by bypassing the multiplication algorithm.
}
    W:=y`parent;
    R:=W`rngdiff;
    require x in R: "Left scalar multiplication on the Weyl algebra needs scalars in the associated differential algebra";
    Ex:=elt(W,R!x);
    return Ex*y;

end intrinsic;



//############################
intrinsic '@'(L::AlgWeylElt, f::RngElt) -> RngDiffElt
//############################
{
 This is the multiplication that defines the D-module action.
}
    W:=L`parent;
    R:=W`rngdiff;
    require f in R: "The element is not in the differential ring defining the Weyl algebra so the module action is not defined";
    ff:=R!f;
    Ltup:=Eltseq(L);
    return R!weyl_action(Ltup,ff);

end intrinsic;

//############################
intrinsic '@'(L::AlgWeylElt, f::RngMPolProlSeqElt) -> RngMPolProlSeqElt
//############################
{
 This is the multiplication that defines the D-module action.
}
    W:=L`parent;
    R:=W`rngdiff;
    require f in R: "The element is not in the differential ring defining the Weyl algebra so the module action is not defined";
    ff:=R!f;
    Ltup:=Eltseq(L);
    return R!weyl_action(Ltup,ff);

end intrinsic;


//############################
intrinsic '^'(x::AlgWeylElt, n::RngIntElt) -> AlgWeylElt
//############################
{
    Given R[d] and x in R and y in R[d] define x*y.
    The speed can be improved by bypassing the multiplication algorithm.
}
    W:=x`parent;
    
    if n eq 0 then
        return elt(W,1);
    elif n eq 1 then
        return x;
    else
        return x*(x^(n-1));
    end if;
end intrinsic;


//###############################
intrinsic Eltseq(x::AlgWeylElt) -> SeqEnum
//###############################
{
    checks if the tuple is there then returns it if not.
}
    if not assigned x`tup then
        W:=x`parent;
        weyldict:=x`array;
        weyltup:=weyldict_to_weyltup(weyldict);
        x`tup:=weyltup;
        x`tup;
    end if;
    
    return x`tup;
end intrinsic;

//###############################
intrinsic GetArray(x::AlgWeylElt) -> Assoc
//###############################
{
    checks if the tuple is there then returns it if not.
}
    return x`array;
end intrinsic;

//###############################
intrinsic Parent(x::AlgWeylElt) -> AlgWeyl
//###############################
{
    For a AlgWeylElt, return the AlgWeylebra
}
    return x`parent;
end intrinsic;




//###############################
intrinsic IsCoercible(W::AlgWeyl, x::.) -> BoolElt, AlgWeylElt
//###############################
{
Checks if x can be coerced into AlgWeyl and performs the coercion if possible.
Currently, only checks if x is in R for W=R[d].

}
    R:=W`rngdiff;
    //printf "Performing a coercion of x=%o into a WeylAlgebra \n, its type is %o \n",x, Type(x);
    
    if Type(x) eq AlgWeylElt then
        //printf "Weyl Algebra Element Coercion";
        return true, elt(W,Eltseq(x));
    elif Type(x) eq SeqEnum then
        return true, elt(W,x);
    elif x in R then
        return true, elt(W,[<x,0>]);
    else
        return false;
    end if;
   
end intrinsic;

/*
//###############################
intrinsic Eltseq(x::AlgWeylElt) -> SeqEnum
//###############################
{
    INPUT:
        --x, a Weyl algebra elements
            a in a0 + a1 d + a2 d^2 + ... + ar d^r
    OUTPUT:
        --eltseqx, the sequence [a0,a1,a2,...,ar];
}

    dictx:=x`array;
    keysx:=Keys(dictx);
    mx:=Max(keysx);
    eltseqx:=[];
    for i in [0..mx] do
        if i in keysx then
            eltseqx := eltseqx cat [dictx[i]];
        else
            eltseqx := eltseqx cat [0];
        end if;
    end for;
    
    return eltseqx;

end intrinsic;
*/


//###############################
intrinsic Derivation(WR :: AlgWeyl) -> AlgWeylElt
//###############################
{
    This function returns the derivation element of a Weyl Algebra.
}
    dW:=elt(WR,[<1,1>]);
    return dW;
end intrinsic;

//###############################
intrinsic GetOne(WR :: AlgWeyl) -> AlgWeylElt
//###############################
{

This returns the 1 of a Weyl algebra.

}
    one:=elt(WR,1);
    return one;
    
end intrinsic;


////////////////////
intrinsic AssignNames(~P::AlgWeyl,s::SeqEnum)
////////////////////
{}
    P`der_name:=s[1];
end intrinsic;

////////////////////
intrinsic Name(P::AlgWeyl, n::RngIntElt)->AlgWeylElt
////////////////////
{Return the ith generator of a Weyl algebra.
This gives either the derivation elements for n=1 or the constant 1 for n=0}
    return P.n;
end intrinsic;



////////////////////
intrinsic '.'(WR::AlgWeyl,n::RngIntElt)->AlgWeylElt
////////////////////
{Return the generator of the Weyl Algebra}
    if n eq 0 then
        return elt(WR,1);
    elif n eq 1 then
        return Derivation(WR);
    else
        error "The integer n must be 0 or 1.";
    end if;
    
end intrinsic;


//###############################
//      USAGE
//###############################
/*
    Attach the package. Unlike "load" functions inside are only locally accessible.
    
        >Attach("package-weyl-algebra.mag");

    Create a AlgWeyl object.
    
        >Q:=Rationals();
        >P := PolynomialRing(Q);
        >f := map<P->P | a:->5*Derivative(a)>;
        >R := DifferentialRing(P, f,Q);
        >W := WeylAlgebra(R);
        
    Create some elements to test things with.
        >x:=P.1;
        >x:=R!x;
        >E1 := elt(W, x);
        >E2 := elt(W, 20);
        >E1+E2;
        $.1 + 20 d^0
        
    Test the different ways to instantiate Weyl algebra elements and make sure they give the
    right thing back.
    
        >my_array:=AssociativeArray();
        >my_array[0]:=x;
        >E1arr:=elt(W,my_array);
        >E2tup := elt(W, [<20,0>]);
        >E1tup := elt(W, [<x,0>]);
        >dW:= elt(W,[<1,1>]);
        >two:=elt(W,2);
        >E2tup eq E2;
        >E1arr eq E1;
        >2*x*dW+0 eq 2*x*dW;
        >0+2*dW eq 2*dW;
        true
        true
        true
        true
        
    Test that the operations of addition an multiplication are well-defined.

        >E3 := E1 + E2;
        >E4 := E1 * E2;
        >E3+1;
        $.1 + 21 d^0
        
    Test exponentiation and getting the derivation
    
        >dW:=Derivation(W);
        >dW^2;
        0 d^1+ 1 d^2
        
    There are a couple other functions that aren't show.
    One can Eltseq() of an element.
    
        >Q:=Rationals();
        >P := PolynomialRing(Q);
        >f := map<P->P | a:->5*Derivative(a)>;
        >R := DifferentialRing(P, f,Q);
        >x:=P.1;
        >W := WeylAlgebra(R);
        >dW:=elt(W,[<x,1>]);
        >Parent(dW) eq W;
        true

*/
