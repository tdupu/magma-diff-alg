Z:=Integers();
Q:=RationalField();

//############################
intrinsic OrderMatrix(U::SeqEnum[RngMPolProlSeqElt])->AlgMatElt
//############################
{ Give the order matrix of a system of differential polynomials. }
//AlgMatElt
//SeqEnum
    return Matrix([Orders(u) : u in U]);
end intrinsic;

//############################
intrinsic TropicalDet(A::AlgMatElt)->RngIntElt
//############################
{Give the tropical determinant of a matrix with integer entries using max,+}
//AlgMatElt
//SeqEnum
    n:=Nrows(A);
    assert n eq Ncols(A);
    G := SymmetricGroup(n);
    J,freq:=Max([&+[A[i,i^sigma] : i in [1..n]] : sigma in G]);
    return J,freq;
end intrinsic;

//%%%%%%%%%%%%%%%%%%%
intrinsic JacobiBound(U::SeqEnum[RngMPolProlSeqElt]:is_square:=false)->RngIntElt,RngIntElt
//%%%%%%%%%%%%%%%%%%%
{Return the Jacobi bound of a system of differential polynomials.}
//AlgMatElt
//SeqEnum
    P:=Parent(U[1]);
    num_vars:=Ngens(P);
    A:=OrderMatrix(U);
    nrows:=Nrows(A);
    ncols:=Ncols(A);
    if nrows lt ncols then
        U0 := [f : f in U] join [P!0 : i in [1..ncols - nrows]];
    else
        U0 := U;
    end if;
    A0:=OrderMatrix(U0);
    rowchoices:=Subsets({x:x in [1..nrows]},num_vars);
    rows:=RowSequence(A0);
    minors:=[Matrix([rows[i] : i in rowchoice]) : rowchoice in rowchoices];
    return Max([TropicalDet(minor) : minor in minors]);
end intrinsic;


////////////////////
intrinsic JetIdeal(eqns::SeqEnum[RngMPolProlSeqElt],ineqns::SeqEnum[RngMPolProlSeqElt])->RngMPol
////////////////////
{Given a system of equations and inequations consisting of differential polynomial elements return the ideal Sat_ineqns([eqns]) in a finite order jet space.\n \n

If the equation is autoreduced extra divisions of variables which are in the Order(eqns) Jet space are performed. In the case that the system is separant and initial regular then the saturation will remove the Sep factor in these extra relations. \n \n

See: section 3 and section 4 of

Huburt, Factorization-free Decomposition Algorithms in Differential Algebra, J. Symbolic Computation (2000) 29, 641–662 doi:10.1006/jsco.1999.0344

}
    require #eqns gt 0: "Must have a non-empty set of equations.";
   
    r:=Order(eqns cat ineqns);
    Jr:=Jet(Parent(eqns[2]),r);
    P:=Parent(eqns[1]);
    
    new_rels:=[];
    if IsAutoreduced(eqns) then
        leaders:=&cat[Support(Leader(h)) : h in eqns];
        for pair in leaders do
            i,j:=Explode(pair);
            j0:=1;
            while j+j0 le r do
                variable:=Diff(P.i,j+j0);
                Quo,Rem,Sep:=RittDivide(variable,eqns);
                Append(~new_rels,Sep*variable-Rem); //we could get rid of the Sep here if we knew that Sep is in the multiplicative set generated by the ineqns.
                j0:=j0+1;
            end while;
        end for;
    end if;
    
    eqns1:=eqns cat new_rels;
    
    return Saturate(ideal<Jr|Jet(eqns1,r)>,Jet(ineqns,r));
end intrinsic;

////////////////////
intrinsic DifferentialRing(eqns::SeqEnum[RngMPolProlSeqElt],ineqns::SeqEnum[RngMPolProlSeqElt])->RngDiff,Map
////////////////////
{Given a differential ideal defined by differential polynomials defining equations and inequations return the differential ring.
It returns the differential ring, and the derivation on the jet space that lifts it.}
/*
Assumes that everything is over QQ.
*/
    pp:=JetIdeal(eqns,ineqns);
    r:=Order(eqns cat ineqns);
    P:=Parent(eqns[1]);
    num_vars:=Ngens(P);
    
    Jr := Parent(pp.1);
    assert Parent(pp.1) eq Jet(P,r);
    assert IsPrime(pp); //this is not necessary

    function delta_map(f)
        return Jet(RittRemainder(Diff(P!f),eqns),r);
    end function;
    delta:=map<Jr->Jr|f:->delta_map(f)>;
    
    /*
    We can check explicitly that I is a differential ideal with our
    derivation.
    This is done by checking that derivatives of the generators explicitly.
    */
    require &and[delta(g) in pp : g in Generators(pp)]: "The ideal is not a differential ideal"; //This could be made into its own intrinsic maybe.
    
    /*
    We lift to the jet ring and come back to perform the derivation.
    */
    A_pp,quo_map:=Jr/pp;
    delta_2:=map<A_pp->A_pp|f:->quo_map(delta_map(f @@ quo_map))>;
    return DifferentialRing(A_pp,delta_2,Q),delta;
end intrinsic;

intrinsic Linearize(eqns0::SeqEnum[RngMPolProlSeqElt],eqns1::SeqEnum[RngMPolProlSeqElt],ineqns1::SeqEnum[RngMPolProlSeqElt])->SeqEnum[RngMPolProlSeqElt]
{Given an autoreduced set with specified set of inequations defining a prime differential ideal linearize the differential polynomials in eqns0 at the generic point of that prime differential ideal.}
    sys:=[eqns1,ineqns1];
    assert #eqns0 gt 0; //must linearize a nonzero set of eqns
    assert IsAutoreduced(sys[1]); //must linearize at an autoreduced set
    
    P:=Parent(eqns0[1]);
    r:=Order(sys[1]);
    
    A1,quo:=DifferentialRing(sys[1],sys[2]);
    assert IsDomain(A1);
    
    F1,map1:=FieldOfFractions(A1);
    
    //create new differential polynomial ring over F1
    new_names:=[ x cat "1" : x in Names(P)];
    P1:=PolynomialRingProlSeq(F1,2: term_order:=<"dblocks",[[1,2]]>);
    AssignNames(~P1,new_names);
    
    //linearize the equations
    eqns:=Jet(eqns0);
    rows:=Rows(JacobianMatrix(eqns));
    
    //make sure to divide out by the remainder to get into A1
    rows_sp:=[
    [map1(A1!Jet(RittRemainder(P!f,sys[1]),r)) : f in Eltseq(row)]
    : row in rows];
    vars:=&cat[[Diff(P1.i,j) : i in [1..Ngens(P)]] : j in [0..r]];
    
    //linear eqns are the dot product of the two
    new_eqns:=[&+[row[i]*vars[i] : i in [1..#vars]] : row in rows_sp];
    
    return new_eqns;
end intrinsic;

////////////////////
intrinsic LinearDivideStep(L2::RngMPolProlSeqElt,L1::RngMPolProlSeqElt)->AlgWeylElt,RngMPolProlSeqElt
////////////////////
{
For linear differential equations to reduced L2 by L1 we
need to reduce take the LeadingMonomial of L1, then figure out the
max derivative to which is appears.
}
    require Degree(L1) le 1: "L1 must be linear";
    require Degree(L2) le 1: "L2 must be linear";
    
    P1:=Parent(L1);
    WP1<D>:=WeylAlgebra(P1);
    LM1:=LeadingMonomial(L1);
    pair:=Support(LM1)[1];
    pairs:=[x : x in Support(L2)| x[1] eq pair[1] and x[2] ge pair[2]];
    if #pairs eq 0 then
        return WP1!0,L2;
    else
        r:=Max([x[2] : x in pairs]);
        order_diff:=r-pair[1];
        v:=Diff(LM1,order_diff);
        c2:=Coefficients(L2,v)[2];
        c1:=Coefficients(L1,LM1)[2];
        Quo:=(c2/c1)*D^order_diff;
        Rem:=L2-Quo@L1;
        return Quo,Rem;
    end if;
    
end intrinsic;

////////////////////
intrinsic LinearDivide(L2::RngMPolProlSeqElt,L1::RngMPolProlSeqElt)->AlgWeylElt,RngMPolProlSeqElt
////////////////////
{Division algorithm for linear differential equations only}
    Quo1,Rem1:=LinearDivideStep(L2,L1);
    if Rem1 ne L2 then
        Quo2,Rem2:=LinearDivide(Rem1,L1);
        Quo:=Quo2+Quo1;
        Rem:=Rem1;
    else
        Quo:=Quo1;
        Rem:=Rem1;
    end if;
    assert L2 eq Quo@L1+Rem;
    return Quo,Rem;
end intrinsic;

////////////////////
intrinsic LinearDivide(f::RngMPolProlSeqElt,G::SeqEnum[RngMPolProlSeqElt])->SeqEnum[RngMPolProlSeqElt],RngMPolProlSeqElt
////////////////////
{Division algorithm by characteristic sequences for linear}
    assert LinearAutoreduce(G) eq G;
    Quo1,Rem1:=LinearDivide(f,G[2..#G]);
    Quo2,Rem2:=LinearDivide(Rem1,Quo1);
    Quo3,Rem3:=LinearDivide(Rem2,G[2..#G]);
    if Rem3 eq Rem2 then
        Quo:=[Quo2] cat Quo1;
        Rem:=Rem2;
    else
        Quo4,Rem4:=LinearDivide(Rem2,G);
        Quo:=[Quo4[1]+Quo2] cat [Quo4[i]+Quo1[i] : i in [2..#G]];
        Rem:=Rem4;
    end if;
    
    assert f eq &+[Quo[i]@G[i] : i in [1..#G]]+Rem;
    
    return Quo,Rem;
end intrinsic;

////////////////////
intrinsic LinearAutoreduce(linears::SeqEnum[RngMPolProlSeqElt])->SeqEnum[RngMPolProlSeqElt]
////////////////////
{Put a system of linear equations into standard form.}
    if #linears eq 0 then
        return linears;
    else
        assert &and[Degree(f) le 1 : f in linears]; //equations must be linear
        sorted_linears:=Sorted(linears);
        
        if #sorted_linears eq 1 then
            return sorted_linears;
            
        elif #sorted_linears eq 2 then
            L1:=sorted_linears[1];
            L2:=sorted_linears[2];
            Quo1,Rem1:=LinearDivide(L1,L2);
            if Rem1 eq L1 then
                Quo2,Rem2:=LinearDivide(L2,L1);
                if Rem2 eq L2 then
                    return sorted_linears;
                else
                    return LinearAutoreduce([L1,Rem2]);
                end if;
            else
                return LinearAutoreduce([Rem1,L2]);
            end if;
            
        else
            n:=#sorted_linears;
            top:=sorted_linears[2..n];
            top_reduced1:=LinearAutoreduce(top);
            bot:=sorted_linears[1];
            top_reduced2:=[LinearDivide(f,bot):f in top_reduced1];
            sorted_linears_new:=Sorted([bot] cat top_reduced2);
            if sorted_linears eq sorted_linears_new then
                return sorted_linears;
            else
                return LinearAutoreduce(sorted_linears_new);
            end if;
        end if;
    end if;
    
end intrinsic;
