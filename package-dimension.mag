//############################
intrinsic OrderMatrix(U::SeqEnum[RngMPolProlSeqElt])->AlgMatElt
//############################
{ Give the order matrix of a system of differential polynomials. }
//AlgMatElt
//SeqEnum
    return Matrix([Orders(u) : u in U]);
end intrinsic;

//############################
intrinsic TropicalDet(A::AlgMatElt)->RngIntElt
//############################
{Give the tropical determinant of a matrix with integer entries using max,+}
//AlgMatElt
//SeqEnum
    n:=Nrows(A);
    assert n eq Ncols(A);
    G := SymmetricGroup(n);
    J,freq:=Max([&+[A[i,i^sigma] : i in [1..n]] : sigma in G]);
    return J,freq;
end intrinsic;

//%%%%%%%%%%%%%%%%%%%
intrinsic JacobiBound(U::SeqEnum[RngMPolProlSeqElt]:is_square:=false)->RngIntElt,RngIntElt
//%%%%%%%%%%%%%%%%%%%
{Return the Jacobi bound of a system of differential polynomials.}
//AlgMatElt
//SeqEnum
    P:=Parent(U[1]);
    num_vars:=Ngens(P);
    A:=OrderMatrix(U);
    nrows:=Nrows(A);
    ncols:=Ncols(A);
    if nrows lt ncols then
        U0 := [f : f in U] join [P!0 : i in [1..ncols - nrows]];
    else
        U0 := U;
    end if;
    A0:=OrderMatrix(U0);
    rowchoices:=Subsets({x:x in [1..nrows]},num_vars);
    rows:=RowSequence(A0);
    minors:=[Matrix([rows[i] : i in rowchoice]) : rowchoice in rowchoices];
    return Max([TropicalDet(minor) : minor in minors]);
end intrinsic;
