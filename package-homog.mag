////////////////////
intrinsic Nrows(A::SeqEnum[SeqEnum])->RngIntElt
////////////////////
{Return the number of rows of a sequence of elements.}
    return #A[1];
end intrinsic;

////////////////////
intrinsic Ncols(A::SeqEnum[SeqEnum])->RngIntElt
////////////////////
{Return the number of columns of a sequence of elements.}
    return #A;
end intrinsic;

////////////////////
intrinsic IsStrictSeq(seq::SeqEnum[RngIntElt])->BoolElt
////////////////////
{Determines if seq is of the form a_0<a_1<...<a_n}
    return &and[seq[i] lt seq[i+1] : i in [1..#seq-1]];
end intrinsic;

////////////////////
intrinsic IsStrictSeqs(alphas::SeqEnum[SeqEnum[RngIntElt]])->BoolElt
////////////////////
{Determines if each element in the sequence is a strict sequence}
    return &and[IsStrictSeq(alpha) : alpha in alphas];
end intrinsic;

////////////////////
intrinsic IsStrictSeqss(seq0::SeqEnum[SeqEnum[RngIntElt]])->BoolElt
////////////////////
{
Determines if a sequence of sequences is admissible. At any point empty sequences can be inserted.
A sequence of sequences [s(1),...,s(M)] is admissible if and only if \n
1) Each s(i) is a strictly increasing sequence.\
2) For each i, s(i)[1] is greater than or equal to the sum of the lengths of the previous sequences.\n\n

For example a sequences of sequences sequence could have the shape\n
    [a11,a12],[a21,a22],[a31,a32,a33],\n
then we would require that a21>=2 and a31>=2+2.\n \n

Concretely [[3,4],[2,5],[4,7,9]] is such an example. Also, [[3,4],[],[2,5],[],[],[4,7,9]] is an example.
The first corresponds to a Wronskian in four homogeneous coordinates and the second corresponds to a Wronskian in seven homogeneous coordinates.
}
    seq:=[s : s in seq0 | #seq0 gt 0 ];

    lengths:=[#s : s in seq];
    if &and[IsStrictSeq(s): s in seq] then
        for i in [2..#seq] do
            if seq[i][1] lt &+lengths[1..i-1] then
                return false;
            end if;
        end for;
        return true;
    else
        false;
    end if;
end intrinsic;


////////////////////
intrinsic IsWeakSeq(seq::SeqEnum[RngIntElt])->BoolElt
////////////////////
{Determines if seq is of the form a_0 <= a_1 <= ... <= a_n}
    return &and[seq[i] le seq[i+1] : i in [1..#seq-1]];
end intrinsic;

////////////////////
intrinsic WeakToStrict(seq0::SeqEnum[RngIntElt])->SeqEnum[RngIntElt]
////////////////////
{Converts a weakly increasing sequence b_0 <= b_1 <= ... <= b_n to a strictly increasing sequence a_0<a_1<...<a_n}
    require IsWeakSeq(seq0): "input is not weakly increasing.";
    return &+[ seq0[i]+i-1 : i in [1..#seq0] ];
end intrinsic;

////////////////////
intrinsic StrictToWeak(seq0::SeqEnum[RngIntElt])->SeqEnum[RngIntElt]
////////////////////
{Converts a strictly increasing sequence a_0<a_1<...<a_n to a weakly increasing sequence b_0 <= b_1 <= ... <= b_n}
    require IsStrictSeq(seq0): "input is not strictly increasing.";
    return &+[ seq0[i]-i+1 : i in [1..#seq0] ];
end intrinsic;


////////////////////
intrinsic StrictSeqs(l::RngIntElt,bound::RngIntElt : lower:=0)->SeqEnum[SeqEnum[RngIntElt]]
////////////////////
{
All of the sequences of a_i in [0..bound] of length l with
a_1<...<a_l.
}
require l ge 0: "Sequence must be of non-negative length.";
require bound ge l: "There do not exists strictly increasing sequences of with a bound of n of length larger than n";

    if l eq 0 then
        return [[]];
    elif l eq 1 then
        return [[i] : i in [lower..bound]];
    elif l eq bound+1-lower then
        return [ i : i in [lower..bound]];
    else
        /*
        new sequence = (old sequence) + (larger number)
        */
        seqs_prev:=StrictSeqs(l-1,bound:lower:=lower);
        seqs:=[];
        for seq0 in seqs_prev do
            if #seq0 gt 0 then
                last:=seq0[l-1];
                //if last lt bound
                for i in [last+1..bound] do
                    seq:=seq0 cat [i];
                    Append(~seqs,seq);
                end for;
            else
                for i in [lower..bound] do
                    seq :=seq0 cat [i];
                    Append(~seqs,seq);
                end for;
            end if;
        end for;
        return seqs;
    end if;

end intrinsic;

////////////////////
intrinsic WeakToStrict(seq0::SeqEnum[RngIntElt])->SeqEnum[RngIntElt]
////////////////////
{Converts a strictly increasing sequence of integers to a weakly increasing sequence of integers. }
    
    return [ seq0[i]+i-1 : i in [1..#seq0] ];
end intrinsic;


////////////////////
intrinsic StrictToWeak(seq0::SeqEnum[RngIntElt])->SeqEnum[RngIntElt]
////////////////////
{Converts a weakly increasing sequence of integers to a strictly increasing sequence of integers.}
    return [ seq0[i]-i+1 : i in [1..#seq0] ];
end intrinsic;


////////////////////
intrinsic WeakSeqs(l::RngIntElt,n::RngIntElt : lower:=0)->SeqEnum[SeqEnum[RngIntElt]]
////////////////////
{
All of the sequences of a_i in [1..n] of length l with
a_1<=...<=a_l
}
    strict_seqs:=StrictSeqs(l,n:lower:=0);
    seqs:=[];
    for seq0 in strict_seqs do
        Append(~seqs,StrictToWeak(seq0));
    end for;
    return seqs;
end intrinsic;



////////////////////
intrinsic WeakSeqs(l::RngIntElt,n::RngIntElt, weight::RngIntElt :lower:=0)->SeqEnum[SeqEnum[RngIntElt]]
////////////////////
{
All of the sequences of a_i in [1..n] of length l with
a_1<=...<=a_l specified weight.
}
    return [ x : x in WeakSeqs(l,n :lower:=lower) | WeightWeak(x) eq weight];
end intrinsic;

/*
There is a potentially much faster way of enumerating weak sequences of a specified weight by considering the enumerating WeakSeqs(len,bound,last,weight), but there are all sorts of restrictions. The key here is to reduce the empty set when there should be none. Also the observation is that WeakSeqs(len,bound,last,weight) can be obtained from WeakSeqs(len,bound,last0,weight-last) by appending [last] and running over all possible last0 le last. Then WeakSeqs(len,bound,weight)=union WeakSeqs(len,bound,last,weight) for last le minimum of weight and bound.

I fucked this up when I implemented it and then accidentally deleted it, but if this becomes a weird bottleneck we should do it.
*/




////////////////////
intrinsic WeightWeak(alpha::SeqEnum[RngIntElt])->RngIntElt
////////////////////
{returns the sum of the elements}
    require IsWeakSeq(alpha):"input is not weakly increasing.";
    return &+alpha;
end intrinsic;

////////////////////
intrinsic WeightStrict(alpha::SeqEnum[RngIntElt])->RngIntElt
////////////////////
{returns the weight of the corresponding weakly increasing sequence.}
    require IsStrictSeq(alpha):"input is not strictly increasing.";
    return WeightWeak(StrictToWeak(alpha));
end intrinsic;

////////////////////
intrinsic StrictSeqs(u0::SeqEnum[RngIntElt],N::RngIntElt)->SeqEnum[SeqEnum]
////////////////////
{
Given an a sequence of length d in lbrace 1,...,N rbrace produce an admissible sequence of length N consisting of strictly increasing sequences. \n\n

This bijection is used in the Chen-Merker proof of Etesse-Kolchin-Schmidt-Reinhart Theorem that the dimension of the graded piece of differentially homogeneous polynomials of degree d in N+1 variables is (N+1)^d. \n \n

This comes from Chen-Merker Lemma 4.10: \n
The number of sequences of length N strictly increasing sequences which are admissible of maximum order d-1 is equal to (N+1)^d.\n \n

The proof of Lemma 4.10 is a bijection between lbrace 1,...,N rbrace^d and strictly increasing sequences of length d which we implement.\n \n

Let u(0) of lbrace 1,...,N rbrace^d. We take all the indices i such that u(0)[i]=N.\n
Throw them into a pile after subtracting one to get alpha(1). \n
Call the length of this guy n(1).\n
Remove all of those u(0)[i] where u(0)[i]=N\n
and throw them at the beginning of the sequence to get u(1).\n\n

Now u(1) in lbrace 1,...,N-1 rbrace^(d(1)) where d(i)=d-n(1). alpha(2) are all the i such that u(1)[i]=N-1. u(2) is all of those removed.\n \n

Note that any of these alpha(i) could be empty. This is very important.There needs to be exactly N sequences. \n\n

Eventually we get u(i) in lbrace 1,...,N-i rbrace^d(i) where d(i)=d(i-1)-n(i).\n

u(i+1) = (list with the N-i indices popped and put to the front)\n
alpha(i+1) = (indices where we popped)\n
}
    u:=u0;
    alphas:=[];
    small:=u0;
    for j in [0..N-1] do
        M:=N-j;
        small:=[x : x in u | x lt M];
        equal:=[x : x in u | x eq M];
        big:=[x : x in u | x gt M] cat equal;
        alpha:=[i-1 : i in [1..#u] | u[i] eq M];
        Append(~alphas,alpha);
        u:=big cat small;
    end for;
    return alphas;
end intrinsic;


