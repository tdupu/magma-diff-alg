////////////////////
intrinsic WronskianMatrix(alphas::SeqEnum[SeqEnum],variables::SeqEnum[RngMPolProlSeqElt] : affine:=false)->ModMatRngElt0
////////////////////
{
This outputs the homogenization of the affine Wronskian matrix.\n \n \n

Section 4.4 of Merker, Chen, "Global sections of the positively twisted Green-Griffiths bundles
" https://arxiv.org/pdf/2410.12752 \n\n

Given a sequence of stictly increasing sequences alpha =(alpha1,alpha2,...,alphaN) of lengths l(1),l(2),...,l(N) where we require the weak lower bound on alphai to be l(1)+l(2)+...+l(i-1) and variables x(1),x(2),...,x(n) we construct the Reinhart-Wronskian matrix where for the variable x(i) we take Wronskian columns alpha(i)(1), ..., alpha(i)(l(i)) where the length of the column is by definition the sum of the l(i).\n\n

The homogenized version uses an extra variable y (which by convention will be the last one of the input) and adds Wronskian columns of order l(1)+....+l(N) up to the maximum order +1. Also, the Wronskian columns for the "affine part" are adjusted so that they have the same length (which is the maximum order+1).\n\n

 }
    assert IsStrictSeqs(alphas);
    
    lengths:=[#alpha : alpha in alphas];
    sN:=&+lengths;
    M := Maximum(&cat(alphas));
    L:=&+lengths;
    
    if affine then
        assert #alphas eq #variables;
        seq:=[];
        for i in [1..#variables] do
            for a in alphas[i] do
                Append(~seq,WronskCol(variables[i],a,L));
            end for;
        end for;
        
        //no need to append a column
        all:=seq;
    else
        //proj version
        assert #alphas eq #variables-1;
        seq:=[];
        for i in [1..#variables-1] do
            for a in alphas[i] do
                Append(~seq,WronskCol(variables[i],a,M+1));
            end for;
        end for;
        
        //we need to add an extra column
        new:=[WronskCol(variables[#variables],i,M+1) : i in [sN..M]];
        assert #seq[1] eq #seq+#new;
        all:=seq cat new;
    end if;
    
    RW_mat_tr:=Matrix0(all);
    RW_mat:=Transpose(RW_mat_tr);
    return RW_mat;
end intrinsic;

////////////////////
intrinsic Wronskian(alphas::SeqEnum[SeqEnum],variables::SeqEnum[RngMPolProlSeqElt]: affine:=false)->RngMPolProlSeqElt
////////////////////
{See documentation for WronskianMatrix}
    RW_mat:=WronskianMatrix(alphas,variables:affine:=affine);
    return Determinant(RW_mat);
end intrinsic;

