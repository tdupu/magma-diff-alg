/*
Taylor Dupuy -- Spring 2025

This is a package about differentially homogeneous polynomials.

*/


intrinsic Nrows(A::SeqEnum)->RngIntElt
{Return the number of rows of a sequence of elements.}
    return #A[1];
end intrinsic;

intrinsic Ncols(A::SeqEnum)->RngIntElt
{Return the number of columns of a sequence of elements.}
    return #A;
end intrinsic;

intrinsic Jet(f::RngMPolProlSeqElt, r::RngIntElt)->RngMPolElt
{Return the corresponding element of the rth jet space.}
    r0:=Order(f);
    require r ge r0: "Cannot map to a lower order jet space than the order of the element";
    P:=Parent(f);
    elt:=(P!Eltseq(f))`elt;
    assert( elt in Jet(P,r0));
    incl:=map(P,r0,r);
    return incl(elt);
end intrinsic;

intrinsic Jet(f::RngMPolProlSeqElt)->RngMPolElt
{Return the corresponding element of the appropriate jet space.}
    return (Parent(f)!Eltseq(f))`elt;
end intrinsic;

intrinsic Exp(seq::SeqEnum[RngMPolProlSeqElt],r0::RngIntElt)->SeqEnum[RngMPolProlSeqElt]
{Given a sequence of prolongation sequence elements, take the derivatives of each of them up to order r0 and concatenate them into their standard sequence.}
    expseq:=&cat[[ Diff(s,j) : s in seq] : j in [0..r0]];
    return expseq;
end intrinsic;

intrinsic Evaluate(f::RngMPolProlSeqElt,seq::SeqEnum[RngMPolProlSeqElt])->RngMPolProlSeqElt
{Plug in elements of a sequence into the prolongation sequence element.}
    P1:=Parent(f);
    n1:=Ngens(P1);
    r1:=Order(f);
    ft:=Jet(f,r1);
    
    Ps:={Parent(s) : s in seq};
    require n1 eq #seq: "The sequence must be the number of generators";
    require #Ps eq 1: "All the elements of the sequence must have the same parent";
    P2:=[P : P in Ps][1];
    
    exp_seq:=Exp(seq,r1);
    r2:=Maximum([Order(s) : s in exp_seq]);
    exp_seq_tr:=[Jet(f,r2) : f in exp_seq];
    return P2!Evaluate(ft,exp_seq_tr);

end intrinsic;


intrinsic IsHomogeneous(f2::RngMPolProlSeqElt)->BoolElt,RngIntElt
{Return true and the degree if a prolongation sequence element is homogeneous and return false otherwise.}
    P2:=Parent(f2);
    n0:=Ngens(P2);
    F:=BaseRing(P2);
    P3:=PolynomialRingProlSeq(F,n0+1);
    old_gens:=[P2.[i,0] : i in [1..n0]];
    new_gens:=[P3.[i,0] : i in [1..n0]];
    lambda:=P3.[n0+1,0];
    
    f3_lambda:=Evaluate(f2,[lambda*x : x in new_gens]);
    f2_new:=Evaluate(f2,[x : x in new_gens]);
    r0:=Order(f3_lambda);
    lambda_t:=Jet(f2,r0);
    f2_t:=Jet(f2_new,r0);
    f3_t:=Jet(f3_lambda,r0);
    flag:=(f3_t/f2_t in Parent(f2_t));
    if flag then
        return true,Factorization(Parent(f2_t)!(f3_t/f2_t))[1][2];
    else
        return false,-1;
    end if;
end intrinsic;
