//##############################
// WRONSKIANS
//##############################
//##############################

////////////////////
intrinsic WronskCol(f::RngMPolProlSeqElt,l::RngIntElt,n::RngIntElt)->SeqEnum
////////////////////
{}
    P:=Parent(f);
    if n ge l+1 then
        return [Binomial(l,k)*Diff(f,l-k) : k in [0..l]] cat [P|0 : k in [1..n-(l+1)]];
    elif n le l+1 then
        return [Binomial(l,k)*Diff(f,l-k) : k in [0..n-1]];
    end if;
end intrinsic;


////////////////////
intrinsic WronskPieceSeq(alpha::SeqEnum,f::RngMPolProlSeqElt)->SeqEnum
////////////////////
{}
    ord:=Maximum(alpha);
    n:=#alpha;
    A:=[WronskCol(f,alpha[i],n) : i in [1..n]];
    return A;
end intrinsic;

////////////////////
intrinsic WronskPiece(alpha::SeqEnum,x::RngMPolProlSeqElt)->ModMatRngElt0
////////////////////
{}
    ord:=Maximum(alpha);
    n:=#alpha;
    A:=Matrix([ [Jet(y,ord) : y in z] : z in WronskPieceSeq(alpha,x)]);
    return Transpose(A);
end intrinsic;

////////////////////
intrinsic StrictSeqss(lengths::SeqEnum,bound::RngIntElt)->SeqEnum
////////////////////
{}
/*
These are currently not producing the correct sequences.
EXAMPLE:
[[3,4],[2,5],[4,7,9]];

*/

    seqss:=[[] : i in [1..#lengths]];
    seqss[1]:=StrictSeqs(lengths[1],bound);
    for i in [2..#lengths] do
        seqss[i]:=StrictSeqs(lengths[i],bound : lower:=&+lengths[1..i-1]);
    end for;
    alphas:=[ [a[1],a[2],a[3]] : a in CartesianProduct(seqss)];
    return alphas;

end intrinsic;

