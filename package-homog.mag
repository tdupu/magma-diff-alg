// monomials
//##############################
//##############################

////////////////////
intrinsic '^'(x::RngMPolProlSeqElt,seq::SeqEnum[RngIntElt])->RngMPolProlSeqElt
////////////////////
{Given a weakly increasing sequence a_0<=a_1<=...<=a_n return the product of Diff(x,a_j).
}
    require IsWeakSeq(seq):"seq is not weakly increasing";
    
    if #seq eq 0 then
        return Parent(x)!1;
    else
        return &*[Diff(x,i) : i in seq];
    end if;
end intrinsic;

////////////////////
intrinsic WeakSeqs(mon::RngMPolProlSeqElt)->SeqEnum[SeqEnum[RngIntElt]]
////////////////////
{}
    P:=Parent(mon);
    eltseq:=Eltseq(mon);
    require #eltseq eq 1: "mon not a term";

    seq:=Eltseq(mon)[1][2];
    n:=Ngens(P);
    dict:=AssociativeArray();
    for s in seq do
        pair:=s[1];
        len:=s[2];
        if pair[1] in Keys(dict) then
            dict[pair[1]]:=dict[pair[1]] cat [pair[2] : i in [1..len]];
        else
            dict[pair[1]]:=[pair[2] : i in [1..len]];
        end if;
    end for;

    weak_seqs:=[];
    for k in [1..n] do
        if k in Keys(dict) then
            Append(~weak_seqs,Sort(dict[k]));
        else
            Append(~weak_seqs,[]);
        end if;
    end for;
    
    return weak_seqs;
end intrinsic;

