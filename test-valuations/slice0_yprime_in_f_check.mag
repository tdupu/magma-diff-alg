// slice0_yprime_in_f_check.mag
//
// Tests whether y''' is in the polynomial differential ideal generated by
// prolongations of f = x'' + x'y + y. Definitive answer: NO, in two regimes:
//   (A) <Jet(f,5), Jet(f',5), Jet(f'',5)>            -> false
//   (B) <Jet(f,5), Jet(f',5), Jet(f'',5), Jet(f''',5)> -> false
//
// Phase-2 Slice 0 deliverable for the sticky-cone worked example in
// differential-valuations notes.tex (Section 21 / sec:sticky-cones).
// Settles a discrepancy between two Sage notebooks for the same example
// (groebner-fans-finite.ipynb adjoins g = y''' as an extra generator;
// groebner-fans-infinite.ipynb does not). Since y''' is not in the
// polynomial differential ideal generated by f, the two notebooks produce
// genuinely different ideals; the infinite notebook is canonical.
//
// Dependencies: package-dimension.mag, package-prolongations.mag, package-reduction.mag
// Reproduces:
//   f    = Diff(x,2) + y*Diff(x,1) + y
//   f''' has coefficient (Diff(x,1) + 1) on Diff(y,3); cannot isolate y'''
//   without saturating by (1 + x'), which the polynomial ideal does not do.
//
// Expected output (last two lines):
//   y''' in <f, f', f''>?                    false
//   y''' in <f, f', f'', f'''>?              false

SetQuitOnError(true);
AttachSpec("/Users/tdupuy/repos/magma-diff-alg/diffalg.spec");

Q := Rationals();
R<t> := PolynomialRing(Q, 1);
deriv := map<R -> R | f :-> Derivative(f, t)>;
A := DifferentialRing(R, deriv, Q);
F<tt> := FieldOfFractions(A);

P<x, y> := PolynomialRingProlSeq(F, 2 : term_order := <"dblocks", [[1, 2]]>);
Extend(P, 5);

f    := Diff(x, 2) + Diff(x, 1) * y + y;
fp   := Diff(f, 1);
fpp  := Diff(f, 2);
fppp := Diff(f, 3);
g    := Diff(y, 3);

print "f    =", f;
print "f'   =", fp;
print "f''  =", fpp;
print "f''' =", fppp;
print "g (=y''') =", g;

// Work in J^5 (= polynomial ring with x, y, x', y', ..., x^(5), y^(5))
J5 := Jet(P, 5);
print "\nJ5 rank =", Rank(J5);
print "J5 variables:", Names(J5);

f_5    := Jet(f, 5);
fp_5   := Jet(fp, 5);
fpp_5  := Jet(fpp, 5);
fppp_5 := Jet(fppp, 5);
g_5    := Jet(g, 5);

print "\nGenerators of [f] truncated to J5 (no saturation):";
print "  Jet(f, 5)   =", f_5;
print "  Jet(f', 5)  =", fp_5;
print "  Jet(f'', 5) =", fpp_5;
print "  Jet(f''', 5)=", fppp_5;

// =========== REGIME A: <f, f', f''> in J5 ==========
print "\n========= REGIME A: <f, f', f''> in J5 =========";
I_A := ideal< J5 | [f_5, fp_5, fpp_5] >;
print "y''' in <f, f', f''>?", g_5 in I_A;

// =========== REGIME B: <f, f', f'', f'''> in J5 ==========
print "\n========= REGIME B: <f, f', f'', f'''> in J5 =========";
I_B := ideal< J5 | [f_5, fp_5, fpp_5, fppp_5] >;
print "y''' in <f, f', f'', f'''>?", g_5 in I_B;

// NOTE: regime C (saturation by Separant(f''', y''') = 1+x') is the natural
// next test; if you saturate, y''' DOES enter the ideal. Verified by hand:
// f''' = (1+x')*y''' + (other monomials not involving y'''). The polynomial
// notebooks (finite + infinite) build a non-saturated polynomial ideal, so
// the canonical answer to "y''' in the polynomial diffideal of f?" is NO.

exit;
