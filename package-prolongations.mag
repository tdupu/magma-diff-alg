/*
Taylor Dupuy -- Spring 2025

This gives a way of talking about differential polynomials via prolongation sequences and kernels in the sense of Johnson. This is basically keeping track of jet spaces and how they map to each other. Each jet ring both has a derivative and a map to the subsequent jet space. We have defined a prolongation element to be an element whichh is in one of these spaces and then allowed ourselves to add, multiply, etc elements by going to jet rings of deep enough order and doing it there. This approach is slower than the RngDiffPol but it makes accessing the functions like Grobner bases to RngMPol a lot easier.

Basic reference for this material:

Buium, Differential Algebra and Diophantine Geometry
Chapter 3, section 2, page 60

*/

Q:=RationalField();
Z:=Integers();

/*
Kernels are morphisms of R-algebras A->B and a derivation d:A->B that extends a derivations on the base.
*/
declare type KerJ;
declare attributes KerJ: delta,map;

/*
Prolongations are A->B->C with A->B and B->C kernels.
*/

declare type Prol;
declare attributes Prol: ker1, ker2;

/*
Sequences of Prolongations
*/

declare type RngMPolProlSeq[RngMPolProlSeqElt];
declare attributes RngMPolProlSeq: sequence,term_order,rngdiffpol;
declare attributes RngMPolProlSeqElt: parent,elt,order;

/*
The convention is that an element order order r will be in the rth jet space.
The order 0 jet space is the original ring.
The order -1 jet space is the base ring.
*/

/*
Universal Kernels:
Given a differential ring A, and some A-algebra B, there is a universal kernel A->B.
*/


/*
--------------------
--------------------
TERM ORDER FUNCTIONS
--------------------
--------------------
*/

/*
Order the monomials and then figure out which variable they correspond to.
If lex, then you just put the standard basis vectors in rows corresponding to their order.
If block, then you need to do one block at a time as in the example below:

<"elim", [ 1, 4 ], [ 2, 3 ]>
> MonomialOrderWeightVectors(P);

[ 1, 0, 0, 1 ],
[ 1, 0, 0, 0 ],
[ 0, 1, 1, 0 ],
[ 0, 1, 0, 0 ]

We will have much larger blocks though.
First there will be max_order[1]+1 variables corresp to x1 and its ders.
Second there will be max_order[2]+1 variables corresp to x2 and its ders.
...
If we have a block order [[3],[1],[2,4]] then this corresponds to a block order
[ [3,n3],...,[3,0] ], [ [1,n1],...,[1,0] ], [ [2,j],[4,j] ] ordered according to j first then according to 2]
*/

////////////////////
intrinsic pair_to_std(nvars::RngIntElt,pair::SeqEnum)->RngIntElt
////////////////////
{Given a pair [i,j] return the lexicographic index of x_i^(j) in the standard ordering}
/*
[std_to_pair(2,i) : i in [1..6]];
*/
    i:=pair[1];
    j:=pair[2];
    return i+j*nvars;
end intrinsic;

////////////////////
intrinsic std_to_pair(nvars::RngIntElt,m::RngIntElt)->SeqEnum
////////////////////
{Given an index k return the pair [i,j] corresponding to the variable x_i^(j) in the standard ordering}
/*
[pair_to_std(2,x) : x in [[1,0],[2,0],[1,1],[2,1],[1,2],[2,2]]];
*/
    if m eq 1 then
        return [1,0];
    else
        pair0:=std_to_pair(nvars,m-1);
        i:=pair0[1];
        j:=pair0[2];
        if i eq nvars then
            return [1,j+1];
        else
            return [i+1,j];
        end if;
    end if;
end intrinsic;

////////////////////
function dblocks_to_blocks_pair(nvars,r,dblocks)
////////////////////
/*
dblocks:=[ [1,2],[3,4] ];
dblocks:=[ [1,2,3,4]]; //pure orderly lexicographic
dblocks:=[[1],[2],[3],[4]]; //pure elimination
*/
    function single_block(r,dblock)
        return [ [ [x,r-i] : x in dblock ] : i in [0..r]];
    end function;
    
    return &cat [single_block(r,dblock) : dblock in dblocks];
end function;

////////////////////
function dblocks_to_blocks_std(nvars,r,dblocks)
////////////////////
/*
dblocks:=[ [1,2],[3,4] ];
dblocks:=[ [1,2,3,4]]; //pure orderly lexicographic
dblocks:=[[1],[2],[3],[4]]; //pure elimination
*/
    blocks_p:=dblocks_to_blocks_pair(nvars,r,dblocks);
    blocks_s:=[ [pair_to_std(nvars,x) : x in block]: block in blocks_p];
    return blocks_s;
end function;

////////////////////
function trace_order_blocks(nvars,r,T)
////////////////////
    lab:=T[1];
    data:=T[2];
    if lab eq "dblocks" then
        labr:="elim";
        blocks:=dblocks_to_blocks_std(nvars,r,data);
        Tr:=<labr,blocks>;
        return Tr;
    else
        error "Not implemented";
    end if;
end function;

////////////////////
function weight_matrix(blocks)
////////////////////
    V:=RSpace(Z,#&cat(blocks));
    B:=Basis(V);

    function weights_for_block(block)
        row1:=&+[B[b]: b in block];
        later_rows:=[B[block[i]]: i in [1..#block-1]];
        return [row1] cat later_rows;
    end function;

    return Matrix(&cat[weights_for_block(block): block in blocks]);
end function;

////////////////////
function trace_order_weight(nvars,r,T)
////////////////////
    if T[1] eq "dblocks" then
        blocks:=dblocks_to_blocks_std(nvars,r,T[2]);
        M:=weight_matrix(blocks);
        weights:=&cat[Eltseq(r):r in Rows(M)];
        return <"weight",weights>;
    else
        error "Not implemented";
    end if;
end function;


/*
--------------------
--------------------
Kernels, Prolongations, Prolongation Sequences
--------------------
--------------------
*/

//////////////////////
intrinsic Diff(f::RngDiffElt)->RngDiffElt
//////////////////////
{Differentiate and element of a differential ring.}
    P:=Parent(f);
    D:=Derivation(P);
    return D(f);
end intrinsic;

//////////////////////
intrinsic JKernel(f::Map,delta::Map)->KerJ
//////////////////////
{Given a ring homomorphism and a derivation of the ring homomorphism, construct a Kernel in the sense of Johnson.}
    my_kernel:=New(KerJ);
    require Domain(f) eq Domain(delta): "The domains of the map and the derivation be the same";
    require Codomain(f) eq Codomain(delta):"The codomains of the map and the derivation must be the same";
    my_kernel`delta:=delta;
    my_kernel`map:=f;
    return my_kernel;
end intrinsic;

//////////////////////
intrinsic JKernel(P::Rng)->KerJ
//////////////////////
{Create the universal Johnson kernel for a ring defined over a differential ring. If the base is not a differential ring, it is given the structure of a differential ring with a trivial derivation.}
    B:=BaseRing(P);
    if Type(B) eq RngDiff then
        delta:=map<B->P|f:->P!Diff(f)>;
        incl:=hom<B->P|f:->P!f>;
    else
        incl:=hom<B->P|f:->P!f>;
        delta:=map<B->P|f:->P!0>;
    end if;
    
    return JKernel(incl,delta);
end intrinsic;

//////////////////////
intrinsic 'eq'(k1::KerJ,k2::KerJ)->BoolElt
//////////////////////
{Return the morphism of rings in the Johnson kernel.}
    return ( (map(k1) eq map(k2)) and (derivation(k1) eq derivation(k2)));
end intrinsic;

//////////////////////
intrinsic Hash(k1::KerJ)->BoolElt
//////////////////////
{Return the morphism of rings in the Johnson kernel.}
    return [Hash(map(k1)),Hash(derivation(k1))];
end intrinsic;

//////////////////////
intrinsic map(my_kernel::KerJ)->Map
//////////////////////
{Return the morphism of rings in the Johnson kernel.}
    return my_kernel`map;
end intrinsic;

//////////////////////
intrinsic derivation(my_kernel::KerJ)->Map
//////////////////////
{Return the derivation of the Johnson kernel.}
    return my_kernel`delta;
end intrinsic;

//////////////////////
intrinsic domain(my_kernel::KerJ)->Map
//////////////////////
{}
    return Domain(map(my_kernel));
end intrinsic;

//////////////////////
intrinsic codomain(my_kernel::KerJ)->Map
//////////////////////
{}
    return Codomain(map(my_kernel));
end intrinsic;


/*
Universal Prolongations:
Given f:A->B with D:A->B then there is a universal prolongation which is the quotient of the symmetric algebra of B by d(f(a))-D(a) where d is the Kahler differentia and a in A.
*/

//////////////////////
intrinsic Print(X::KerJ)
//////////////////////
{}
//    printf "An affine Johnson kernel from %o to %o", domain(X),codomain(X);
end intrinsic;


//////////////////////
intrinsic Prolongation(ker1::KerJ,ker2::KerJ)->Prol
//////////////////////
{}
//require domain(ker2) eq codomain(ker1): "The codomain of the first kernel must be the domain of the second kernel";
    my_prol:=New(Prol);
    my_prol`ker1:=ker1;
    my_prol`ker2:=ker2;
    return my_prol;
end intrinsic;

//////////////////////
intrinsic Hash(k1::KerJ)->BoolElt
//////////////////////
{Return the morphism of rings in the Johnson kernel.}
    return [Hash(map(k1)),Hash(derivation(k1))];
end intrinsic;

//////////////////////
intrinsic first(prol::Prol)->KerJ
//////////////////////
{}
    return prol`ker1;
end intrinsic;

//////////////////////
intrinsic second(prol::Prol)->KerJ
//////////////////////
{}
    return prol`ker2;
end intrinsic;

//////////////////////
intrinsic Print(prol::Prol)
//////////////////////
{Printing statement for prolongations}
//    printf "A prolongation from %o to %o to %o", domain(first(prol)), codomain(first(prol)), codomain(second(prol));
end intrinsic;

//////////////////////
intrinsic Prolongation(B::RngMPol: term_order:=<"dblocks",[]>)->Prol
//////////////////////
{For a polynomials ring return its first prolongation sequence.}
    if term_order[1] eq "dblocks" then
        ker1:=JKernel(B);
        nvars:=Ngens(B);
        if #term_order[2] eq 0 then
            TO:=<"dblocks",[[i]:i in [1..nvars]]>;
        else
            TO:=term_order;
        end if;
       
        TO1:=trace_order_weight(nvars,1,TO);
        jet1:=PolynomialRing(BaseRing(B),2*nvars,TO1[1],TO1[2]);

        incl:=hom<B->jet1| [jet1.i : i in [1..Ngens(B)]]>;
        delta:=map<B->jet1|g:->&+[incl(Derivative(g,B.i))*jet1.(i+Ngens(B)) : i in [1..Ngens(B)]]>;
        ker2:=JKernel(incl,delta);
        
        my_prol:=Prolongation(ker1,ker2);
        return my_prol;
    else
        error "term order not implemented";
    end if;
end intrinsic;

intrinsic 'eq'(prol1::Prol,prol2::Prol)->BoolElt
{}
    return (first(prol1) eq first(prol2)) and (second(prol1) eq second(prol2));

end intrinsic;

////////////////////
intrinsic ProlongationSequence(B::RngMPol : term_order:=<"dblocks",[]>)->RngMPolProlSeq
////////////////////
{Make a single prolongation sequence involving the base ring and the first jet space.}
    if term_order[1] eq "dblocks" then
        if #term_order[2] eq 0 then
            num_vars:=Ngens(B);
            TO:=<"dblocks",[[i] : i in [1..num_vars]]>;
        else
            TO:=term_order;
        end if;
        prol_seq:=New(RngMPolProlSeq);
        prol_seq`sequence:=[Prolongation(B:term_order:=TO)];
        prol_seq`term_order:=TO;
        return prol_seq;
    else
        error "Term order not implemented";
    end if;
end intrinsic;

////////////////////
intrinsic 'eq'(P1::RngMPolProlSeq,P2::RngMPolProlSeq)->BoolElt
////////////////////
{}
    return sequence(P1) eq sequence(P2);
end intrinsic;


function next_names(names)
/*
This is used for defining jet rings of polynomials.
*/
    return [Sprintf("Diff(%o,)",n) :n in names];
end function;

function jet_r_names(names,r)
/*
This is used for defining jet rings of polynomials.
*/
    return [Sprintf("Diff(%o,%o)",n,r) :n in names];
end function;

////////////////////
intrinsic ProlongationSequence(B::RngMPol,r::RngIntElt)->RngMPolProlSeq
////////////////////
{Create a prolongation sequence up to jet spaces of order r.
If r<=0 it returns a prolongation sequence of length 1.}
    P:=ProlongationSequence(B);
    if r gt 1 then
        Extend(P,r);
        return P;
    else
        return P;
    end if;
end intrinsic;

////////////////////
intrinsic sequence(P::RngMPolProlSeq)->SeqEnum
////////////////////
{}
    return P`sequence;

end intrinsic;

/*
intrinsic `[]`(M::RngMPolProlSeq, i::RngIntElt, j::RngIntElt) -> RngMPol
{Allows you to access the sequence elements}
   return 0;
end intrinsic;
*/

////////////////////
intrinsic Function(M::RngMPolProlSeq, i::RngIntElt) -> JKer
////////////////////
{}
    return sequence(M)[i];
end intrinsic;

////////////////////
intrinsic order(P::RngMPolProlSeq)->RngIntElt
////////////////////
{Return the order to which the prolongation sequence has been computed.}
    return #sequence(P);
end intrinsic;

////////////////////
intrinsic '#'(P::RngMPolProlSeq)->RngIntElt
////////////////////
{Return the order to which the prolongation sequence has been computed.}
    return #sequence(P);
end intrinsic;

////////////////////
intrinsic Extend(P::RngMPolProlSeq)
////////////////////
{Given a prolongation sequence extend the sequence canonically}
    prolongations:=sequence(P);
    r:=#prolongations;
    ker0:=second(prolongations[r]);
    B:=codomain(first(prolongations[1]));
    original_names:=Names(B);
    nvars:=Ngens(B);
    
    first_part:=Names(domain(ker0));
    second_part:=jet_r_names(original_names,(#first_part)/(#original_names));
    names0:=first_part cat second_part;
    jet0:=codomain(ker0);
    AssignNames(~jet0,names0);
    
    TO:=MonomialOrder(P);
    TOr:=trace_order_weight(nvars,r+1,TO);
    jet1:=PolynomialRing(BaseRing(B),(r+2)*nvars,TOr[1],TOr[2]);
    names1:=jet_r_names(original_names,r+1);
    all_names:=names0 cat names1;
    AssignNames(~jet1,all_names);
    f1:=hom<jet0->jet1| [jet1.i : i in [1..Ngens(jet0)]]>;
    delta1:=map<jet0->jet1|g:->&+[f1(Derivative(g,jet0.i))*jet1.(i+Ngens(B)) : i in [1..Ngens(jet0)]]>;
    ker1:=JKernel(f1,delta1);
    prol_new:=Prolongation(ker0,ker1);
    Append(~P`sequence,prol_new);
end intrinsic;

////////////////////
intrinsic Extend(P::RngMPolProlSeq,r::RngIntElt)
////////////////////
{Given a prolongation sequence extend the sequence canonically}
    while order(P) lt r do
        Extend(P);
    end while;
end intrinsic;

////////////////////
intrinsic BaseRing(P::RngMPolProlSeq)->Rng
////////////////////
{Return the "-1" term of the prolongation sequence}
    return domain(first(sequence(P)[1]));
end intrinsic;

////////////////////
intrinsic Jet(P::RngMPolProlSeq,i::RngIntElt)->.
////////////////////
{Return the rth term of the prolongation sequence}
    if i eq -1 then
        return domain(first(sequence(P)[1]));
    else
        if #(P) lt i+1 then
            Extend(P,i+1);
        end if;
        return codomain(first(sequence(P)[i+1]));
    end if;
end intrinsic;

////////////////////
intrinsic IsCoercible(P::RngMPolProlSeq,x::.)->BoolElt,.
////////////////////
{}
    if Type(x) eq RngIntElt then
        y:=New(RngMPolProlSeqElt);
        y`parent:=P;
        y`elt:=BaseRing(P)!x;
        y`order:=-1;
        return true,y;
    
    elif x in Jet(P,-1) then
        y:=New(RngMPolProlSeqElt);
        y`parent:=P;
        y`elt:=x;
        y`order:=-1;
        return true, y;
    elif Type(x) eq RngMPolElt then
        r:=0;
        while r lt order(P) do
            if x in Jet(P,r) then
                y:=New(RngMPolProlSeqElt);
                y`parent:=P;
                y`elt:=x;
                y`order:=r;
                return true,y;
            else
                r:=r+1;
            end if;
        end while;
        return false;
    else
        return false;
    end if;
end intrinsic;

////////////////////
intrinsic Parent(x::RngMPolProlSeqElt)->RngMPolProlSeq
////////////////////
{}
    return x`parent;
end intrinsic;

////////////////////
intrinsic Print(P::RngMPolProlSeq)
////////////////////
{Polynomial prolongation sequence printing}
    printf "A prolongation sequence for a polynomial ring in %o variables over a field.", Ngens(P);
end intrinsic;

////////////////////
intrinsic Print(x::RngMPolProlSeqElt)
////////////////////
{}
    printf "%o",x`elt;
end intrinsic;

////////////////////
intrinsic map(P::RngMPolProlSeq,m::RngIntElt)->Map
////////////////////
{This gives the morphism from Jm to Jm+1}
    require m ge -1: "Must have input bigger than -1. Jet spaces start at -1 which is the base ring.";
    if order(P) lt m then
        Extend(P,m);
    end if;
    
    return map(first(sequence(P)[m+2]));
    
end intrinsic;

////////////////////
intrinsic derivation(P::RngMPolProlSeq,m::RngIntElt)->Map
////////////////////
{This gives the derivative from Jm to Jm+1}
    require m ge -1: "Must have input bigger than -1. Jet spaces start at -1 which is the base ring.";
    if order(P) lt m then
        Extend(P,m);
    end if;
    
    return derivation(first(sequence(P)[m+2]));
    
end intrinsic;

////////////////////
intrinsic map(P::RngMPolProlSeq,m::RngIntElt,n::RngIntElt)->Map
////////////////////
{This gives the morphism from Jm to Jn}
    require m le n: "The map must be from one a lower order jet space to a higher order jet space.";
    if m eq n then
        return map<Jet(P,m)->Jet(P,m)|f:->f>;
    else
        return &*[map(P,i) : i in [m..n-1]];
    end if;
end intrinsic;

intrinsic match_orders(x1::RngMPolProlSeqElt,x2::RngMPolProlSeqElt)->RngMPolProlSeqElt,RngMPolProlSeqElt
{Given two elements bump them up to the same jet ring.}
    P:=Parent(x1);
    require P eq Parent(x2): "Elements must be in the same prolongation sequence";
    n1:=x1`order;
    n2:=x2`order;
    if n1 eq n2 then
        return x1,x2;
    else
        max:=Maximum([n1,n2]);
        f1:=map(P,n1,max);
        f2:=map(P,n2,max);
        y1:=New(RngMPolProlSeqElt);
        y2:=New(RngMPolProlSeqElt);
        y1`parent:=Parent(x1);
        y2`parent:=Parent(x2);
        y1`order:=max;
        y2`order:=max;
        y1`elt:=f1(x1`elt);
        y2`elt:=f2(x2`elt);
        return y1,y2;
    end if;
end intrinsic;
    
////////////////////
intrinsic '+'(x1::RngMPolProlSeqElt,x2::RngMPolProlSeqElt)->RngMPolProlSeqElt
////////////////////
{}
    P:=Parent(x1);
    require P eq Parent(x2): "Elements must be in the same prolongation sequence";
    z1,z2:=match_orders(x1,x2);
    y:=New(RngMPolProlSeqElt);
    y`parent:=Parent(z1);
    y`order:=z1`order;
    y`elt := z1`elt+z2`elt;
    return y;
  
end intrinsic;

////////////////////
intrinsic '+'(x1::RngMPolProlSeqElt,x2::.)->RngMPolProlSeqElt
////////////////////
{}
   return x1+Parent(x1)!x2;
  
end intrinsic;

////////////////////
intrinsic '+'(x2::.,x1::RngMPolProlSeqElt)->RngMPolProlSeqElt
////////////////////
{}
   return x1+x2;
  
end intrinsic;



////////////////////
intrinsic '*'(x1::RngMPolProlSeqElt,x2::RngMPolProlSeqElt)->RngMPolProlSeqElt
////////////////////
{}
    P:=Parent(x1);
    require P eq Parent(x2): "Elements must be in the same prolongation sequence";
    z1,z2:=match_orders(x1,x2);
    y:=New(RngMPolProlSeqElt);
    y`parent:=Parent(z1);
    y`order:=z1`order;
    y`elt := z1`elt*z2`elt;
    return y;
end intrinsic;

////////////////////
intrinsic '*'(x1::RngElt,x2::RngMPolProlSeqElt)->RngMPolProlSeqElt
////////////////////
{}
    P:=Parent(x2);
    return (P!x1)*x2;
end intrinsic;

////////////////////
intrinsic '*'(x2::RngMPolProlSeqElt,x1::RngElt)->RngMPolProlSeqElt
////////////////////
{}
    return x1*x2;
end intrinsic;


////////////////////
intrinsic '-'(x1::RngMPolProlSeqElt,x2::RngMPolProlSeqElt)->RngMPolProlSeqElt
////////////////////
{}
    P:=Parent(x1);
    require P eq Parent(x2): "Elements must be in the same prolongation sequence";
    z1,z2:=match_orders(x1,x2);
    y:=New(RngMPolProlSeqElt);
    y`parent:=Parent(z1);
    y`order:=order`z1;
    y`elt := z1`elt-z2`elt;
    return y;
end intrinsic;

////////////////////
intrinsic '^'(f1::RngMPolProlSeqElt,n::RngIntElt)->BoolElt
////////////////////
{}
    f2:=New(RngMPolProlSeqElt);
    f2`parent:=Parent(f1);
    f2`order:=f1`order;
    f2`elt:=(f1`elt)^n;
    return f2;
end intrinsic;

//////////////////////
intrinsic Diff(f::RngMPolProlSeqElt)->RngMPolProlSeqElt
//////////////////////
{Differentiate and element of a prolongation sequence.}
    P:=Parent(f);
    Df:=New(RngMPolProlSeqElt);
    r:=f`order;
    D:=derivation(P,r);
    Df`parent:=P;
    Df`elt:=D(f`elt);
    Df`order:=f`order+1;
    return Df;
end intrinsic;

//////////////////////
intrinsic Diff(f::RngMPolProlSeqElt,n::RngIntElt)->RngMPolProlSeqElt
//////////////////////
{Differentiate and element of a prolongation sequence.}
    P:=Parent(f);
    if order(P) lt n+f`order+2 then
        Extend(P,n+f`order+2);
    end if;
    
    if n eq 0 then
        return f;
    elif n eq 1 then
        return Diff(f);
    elif n gt 1 then
        return Diff(Diff(f),n-1);
    end if;
end intrinsic;

////////////////////
intrinsic AssignNames(~P::RngMPolProlSeq,s::SeqEnum)
////////////////////
{}
    B:=Jet(P,0);
    AssignNames(~B,s);
    original_names:=s;
    all_names:=s;
    R:=order(P);
    for r in [1..R] do
        jet1:=Jet(P,r);
        new_names:=jet_r_names(original_names,r);
        all_names:=all_names cat new_names;
        AssignNames(~jet1,all_names);
    end for;
end intrinsic;

////////////////////
intrinsic PolynomialRingProlSeq(F::.,num_vars::RngIntElt: term_order:=<"dblocks",[]>)->RngMPolProlSeq
////////////////////
{}
    if term_order[1] eq "dblocks" then
        if #term_order[2] eq 0 then
            TO:=<"dblocks",[ [i] : i in [1..num_vars]]>;
        else
            TO:=term_order;
        end if;
    else
        error "this term order is not implemented";
    end if;
    
    T0:=trace_order_weight(num_vars,0,TO);
    B:=PolynomialRing(F,num_vars,T0[1],T0[2]);
    
    return ProlongationSequence(B : term_order:=TO);
    
end intrinsic;

intrinsic MonomialOrder(P::RngMPolProlSeq)->Tup
{}
    return P`term_order;
end intrinsic;

////////////////////
intrinsic Name(P::RngMPolProl,pair::SeqEnum)->RngMPolProlSeqElt
////////////////////
{}
    i:=pair[1];
    j:=pair[2];
    B:=Jet(P,0);
    return Diff(P!B.i,j);
end intrinsic;

////////////////////
intrinsic Name(P::RngMPolProlSeq,i::RngIntElt)->RngMPolProlSeqElt
////////////////////
{}
    B:=Jet(P,0);
    return P!B.i;
end intrinsic;

////////////////////
intrinsic '.'(P::RngMPolProlSeq,i::RngIntElt)->RngMPolProlSeqElt
////////////////////
{}
    B:=Jet(P,0);
    return P!B.i;
end intrinsic;

////////////////////
intrinsic '.'(P::RngMPolProl,pair::SeqEnum)->RngMPolProlSeqElt
////////////////////
{}
    i:=pair[1];
    j:=pair[2];
    B:=Jet(P,0);
    return Diff(P!B.i,j);
end intrinsic;

////////////////////
intrinsic Ngens(P::RngMPolProlSeq)->RngIntElt
////////////////////
{}
    return Ngens(Jet(P,0));
end intrinsic;

////////////////////
intrinsic 'eq'(f1::RngMPolProlSeqElt,f2::RngMPolProlSeqElt)->BoolElt
////////////////////
{}
    P:=Parent(f1);
    require Parent(f2) eq P: "Elements must have the same parent";
    r1:=f1`order;
    r2:=f2`order;
    max:=Maximum([r1,r2]);
    map1:=map(P,r1,max);
    map2:=map(P,r2,max);
    ff1:=map1(f1`elt);
    ff2:=map2(f2`elt);
    return ff1 eq ff2;
end intrinsic;

intrinsic LeadingTerm(f::RngMPolProlSeqElt)->RngMPolProlSeqElt
{Return the leading term of an element of a prolongation sequence.}
    ltu:=LeadingTerm(f`elt);
    y:=New(RngMPolProlSeqElt);
    P:=Parent(f);
    y`parent:=P;
    y`order:=f`order;
    y`elt:=ltu;
    return y;
end intrinsic;

intrinsic LeadingMonomial(f::RngMPolProlSeqElt)->RngMPolProlSeqElt
{Return the leading term of an element of a prolongation sequence.}
    lm:=LeadingMonomial(f`elt);
    y:=New(RngMPolProlSeqElt);
    P:=Parent(f);
    y`parent:=P;
    y`order:=f`order;
    y`elt:=lm;
    return y;
end intrinsic;

intrinsic LeadingCoefficient(f::RngMPolProlSeqElt)->RngElt
{Return the leading coefficient of an element of a prolongation sequence.}
    lc:=LeadingCoefficient(f`elt);
    return lc;
end intrinsic;

intrinsic Degree(f::RngMPolProlSeqElt)->RngElt
{Return the degree element of a prolongation sequence.}
    return Degree(f`elt);
end intrinsic;

intrinsic Leader(f::RngMPolProlSeqElt)->RngMPolProlSeqElt,RngIntElt
{Return the leader of a differential polynomials which is the leading }
    ltu:=LeadingTerm(f`elt);
    eltu:=Exponents(ltu);
    n:=1;
        while eltu[n] eq 0 do
             n:=n+1;
        end while;
    y:=New(RngMPolProlSeqElt);
    P:=Parent(f);
    num_vars:=Ngens(P);
    pair:=std_to_pair(num_vars,n);
    i:=pair[1];
    j:=pair[2];
    y`parent:=P;
    y`order:=j;
    y`elt:=Jet(P,j).n;
    return y,eltu[n];
end intrinsic;

//%%%%%%%%%%%%%%%%%%%%%%%
intrinsic Coefficients(B::RngMPolProlSeqElt,u::RngMPolProlSeqElt)->RngMPolProlSeqElt
//%%%%%%%%%%%%%%%%%%%%%%%
{}
        B1,u1:=match_orders(B,u);
        P:=Parent(B1);
        return [P!c: c in Coefficients(B1`elt,u`elt)];
end intrinsic;

//%%%%%%%%%%%%%%%%%%%%%%%
intrinsic TopCoeff(B::RngMPolProlSeqElt,u::RngMPolProlSeqElt)->RngMPolProlSeqElt
//%%%%%%%%%%%%%%%%%%%%%%%
{}
        coeffs:=Coefficients(B,u);
        degB:=#coeffs-1;
        IB:=coeffs[#coeffs];
        return IB,degB;
end intrinsic;

//%%%%%%%%%%%%%%%%%%%%%%
intrinsic Initial(B::RngMPolProlSeqElt)->RngMPolProlSeqElt
//%%%%%%%%%%%%%%%%%%%%%%
{}
    lB,degB:=Leader(B);
    return TopCoeff(B,lB),degB;
end intrinsic;

//%%%%%%%%%%%%%%%%%%%
intrinsic Derivative(B::RngMPolProlSeqElt,u::RngMPolProlSeqElt)->RngMPolProlSeqElt
//%%%%%%%%%%%%%%%%%%%
{}
    B1,u1:=match_orders(B,u);
    P:=Parent(B1);
    y:=New(RngMPolProlSeqElt);
    y`parent:=P;
    y`order:=B1`order;
    y`elt:=Derivative(B1`elt,u`elt);
    return y;

end intrinsic;


//%%%%%%%%%%%%%%%%%%%
intrinsic Separant(B::RngMPolProlSeqElt)->RngMPolProlSeqElt
//%%%%%%%%%%%%%%%%%%%
{The partial derivative of a differential polynomial with respect to its leader.}
    lB,dB:=Leader(B);
    return Derivative(B,lB);
end intrinsic;


//%%%%%%%%%%%%%%%%%%%
intrinsic Support(f::RngMPolProlSeqElt)->SeqEnum
//%%%%%%%%%%%%%%%%%%%
{
This is the set of collection of pairs [i,j] that appear in the polynomial.
}
    ngens:=Ngens(Parent(f));
    return [[ std_to_pair(ngens,x) : x in Support(m)] : m in Monomials(f`elt)];
end intrinsic;

