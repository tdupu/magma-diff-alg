intrinsic variableNames(R::RngDiffPol) -> SeqEnum
{}
    if not assigned R`variable_names then
        R`variable_names:=[ Sprintf("x%o",i) : i in [1..Nvariables(R)]];
    end if;
    
    return R`variable_names;
end intrinsic;

intrinsic NumberOfNames(R::RngDiffPol)->RngIntElt
{}
    return Nvariables(R);
end intrinsic;


intrinsic Name(R::RngDiffPol,i::RngIntElt)->RngDiffPolMon
{}
    return R.i;
end intrinsic;

intrinsic Name(R::RngDiffPol,pair::SeqEnum)->RngDiffPolMon
{}
    return R.pair;
end intrinsic;

intrinsic AssignNames(~R::RngDiffPol,s::SeqEnum)
{}
    R`variable_names := s;
end intrinsic;

intrinsic Print(R::RngDiffPol)
{}
    printf "Ordinary Differential Polynomial Ring over %o in %o variables. ", baseRing(R), Nvariables(R);
    
end intrinsic;

intrinsic '.'(R::RngDiffPol,i::RngIntElt) -> RngDiffPolMon
{}
    P:=exponentRing(R);
    one:=P!1;
    e:=[P!0 : i in [1..Nvariables(R)]];
    e[i]:=e[i]+one;
    mon:=monomial(R,e);
    return mon;
end intrinsic;

intrinsic '.'(R::RngDiffPol,pair::SeqEnum) -> RngDiffPolMon
{}
    i:=pair[1];
    j:=pair[2];
    P:=exponentRing(R);
    one:=P!1;
    e:=[P!0 : i in [1..Nvariables(R)]];
    e[i]:=e[i]+P.1^j;
    mon:=monomial(R,e);
    return mon;
end intrinsic;

intrinsic Print(m1::RngDiffPolMon)
{}
    outputs:=[];
    R:=Parent(m1);
    es:=exponent(m1);
    n:=Nvariables(R);
    vs:=variableNames(R);
    
    factors:=[];
    if isOne(m1) then
        printf "1";
    else
        for i in [1..n] do
            for t in Terms(es[i]) do
                m:=Coefficients(t)[1];
                ord:=Degree(t);
                if ord eq 0 and m eq 1 then
                    Append(~factors,Sprintf("%o",vs[i]));
                elif ord eq 0 and m gt 1 then
                    Append(~factors,Sprintf("%o^%o",vs[i],m));
                elif ord gt 0 and m eq 1 then
                    Append(~factors,Sprintf("D^%o(%o)",ord,vs[i]));
                elif ord gt 0 and m gt 1 then
                    Append(~factors,Sprintf("D^%o(%o)^%o",ord,vs[i],m));
                end if;
            end for;
        end for;

        vprintf RngDiffPol, 4: "factors %o \n", factors;
        
        if #factors gt 0 then
            output:=factors[1];
            for i in [2..#factors] do
                output:=output * "*" * factors[i];
            end for;
        else
            output:="";
        end if;

        printf output;
    end if;
end intrinsic;

intrinsic Print(f::RngDiffPolTerm)
{}
    if isOne(f) then
        printf "1";
    elif isConstant(f) then
        printf "%o",coeff(f);
    elif coeff(f) eq 1 then
        printf "%o",monomial(f);
    else
        printf "%o*%o", coeff(f),monomial(f);
    end if;
end intrinsic;

intrinsic Print(f::RngDiffPolElt)
{}
    if isZero(f) then
        printf "0";
    else
        terms:=[t : t in terms(f)];
        //Sort(~terms);
        printed_terms:=[Sprint(t): t in terms];
        output:=printed_terms[1];
        for i in [2..#terms] do
            output:=output * " + " * printed_terms[i];
        end for;
        printf output;
    end if;
end intrinsic;



//##################################################
