declare verbose RngDiffPol, 6;

/*
    vprintf RngDiffPol,x: "my statements"'
    
    --for debugging should be set to x=4 or higher.

*/

ZZ:=IntegerRing();
QQ:=RationalField();

declare type RngDiffPol[RngDiffPolElt];
//declare type RngDiffPolTerm;
//declare type RngDiffPolMon;
declare type RngDiffPolMon: RngDiffPolTerm, RngDiffPolElt;
declare type RngDiffPolTerm: RngDiffPolElt;

declare attributes RngDiffPol:
    base_ring,
    variable_names,
    number_of_variables,
    max_orders,
    derivation,
    coercion_maps,
    exponent_ring,
    term_order,
    polynomial_ring,
    ranking,
    ranking_sequence,
    prolongation_sequence;
    
declare attributes RngDiffPolElt:
    parent,
    terms,
    polynomial;
    
declare attributes RngDiffPolTerm:
    parent,
    coefficient,
    exponent,
    monomial,
    polynomial;

declare attributes RngDiffPolMon:
    parent,
    exponent,
    polynomial,
    coefficient,
    term;
    
//###########################################

/*

This is used instantiate diffentialPolynomialFunction with lex_rank as a parameter.

*/

function mySort(seq,comparison)
    n:=#seq;
    comp:=func<i,j|comparison(seq[i],seq[j])>;
    new_seq:=Sort([1..n],comp);
    return [seq[new_seq[i]] : i in [1..n]];
end function;



    
//#############################
function rank_lex(var1,var2)
//#############################
/*
A comparison function for on pairs [i1,j1], [i2,j2], the MAGMA official documentation
for comparison functions is below:

//The comparison function C must take two arguments and return an integer less than,
//equal to, or greater than 0 according to whether the first argument is less than,
//equal to, or greater than the second argument (e.g.: func<x, y | x - y>).

The basic idea is that we are going to pass rankings to our variables and these can
induce lexicographic term orderings.
*/
    i1:=var1[1];
    j1:=var1[2];
    i2:=var2[1];
    j2:=var2[2];
    order_diff:=j2-j1;
    if order_diff ne 0 then
        return order_diff;
    else
        return i1-i2;
    end if;
end function;

//#############################
function orderly_lex(var1,var2)
//#############################
/*
A comparison function for on pairs [i1,j1], [i2,j2], the MAGMA official documentation
for comparison functions is below:

//The comparison function C must take two arguments and return an integer less than,
//equal to, or greater than 0 according to whether the first argument is less than,
//equal to, or greater than the second argument (e.g.: func<x, y | x - y>).

The basic idea is that we are going to pass rankings to our variables and these can
induce lexicographic term orderings.
*/
    i1:=var1[1];
    j1:=var1[2];
    i2:=var2[1];
    j2:=var2[2];
    order_diff:=j1-j2;
    if order_diff ne 0 then
        return order_diff;
    else
        return i1-i2;
    end if;
end function;

//#############################
//intrinsic orderlyLexRank(var1::SeqEnum,var2::SeqEnum)->RngIntElt
function orderlyLexRank(var1,var2)
//#############################
/*
A comparison function for on pairs [i1,j1], [i2,j2], the MAGMA official documentation
for comparison functions is below:

//The comparison function C must take two arguments and return an integer less than,
//equal to, or greater than 0 according to whether the first argument is less than,
//equal to, or greater than the second argument (e.g.: func<x, y | x - y>).

The basic idea is that we are going to pass rankings to our variables and these can
induce lexicographic term orderings.
*/
if #var1 eq 0 then
    if #var2 eq 0 then
        return 0;
    elif #var2 eq 2 then
        return 1;
    end if;
elif #var2 eq 0 then
    return -1;
else
    i1:=var1[1];
    j1:=var1[2];
    i2:=var2[1];
    j2:=var2[2];
    order_diff:=j2-j1;
    if order_diff ne 0 then
        return order_diff;
    else
        return i1-i2;
    end if;
end if;
end function;

function lexVectorComparison(v1,v2)
    //require #Eltseq(vec1) eq #Eltseq(vec2): "vectors must be of the same size";
    my_vec:=v1-v2;
    for i in [1..#Eltseq(my_vec)] do
        if my_vec[i] gt 0 then
            return my_vec[i];
        elif my_vec[i] lt 0 then
            return my_vec[i];
        end if;
    end for;
    return 0;
end function;

//##################################################
//##################################################
//  MAIN FUNCTION
//##################################################
//##################################################

intrinsic differentialPolynomialRing(R::Rng, n::RngIntElt: term_order:=<"rank",orderlyLexRank>) -> RngDiffPol
{create a differential polynomial ring.}
    P:=New(RngDiffPol);
    P`number_of_variables:=n;
    P`base_ring:=R;
    P`term_order:=term_order;
    
    E<d>:=PolynomialRing(ZZ,1);
    P`exponent_ring:=E;
    
    return P;
end intrinsic;

intrinsic Nvars(R::RngDiffPol)->RngIntElt
{returns the number of differential variables}
    return R`number_of_variables;
end intrinsic;

intrinsic 'eq'(R1::RngDiffPol,R2::RngDiffPol) -> BoolElt
{}
/*
I didn't really think about this.
Really we should compare all of the attributes of the two rings.
*/
    if baseRing(R1) eq baseRing(R2) and Nvars(R1) eq Nvars(R2) then
        if assigned(R1`variable_names) then
            if assigned(R2`variable_names) then
                if R1`variables_names eq R2`variable_names then
                    return true;
                else
                    return false;
                end if;
            else
                return false;
            end if;
        end if;
    else
        return false;
    end if;

end intrinsic;



//##################################################
//##################################################
//  MISC EXTRACTING ATTRIBUTES
//##################################################
//##################################################

/*
RngDiffPol
RngDiffPolMon->RngDiffPolTerm->RngDiffPolElt

coefficient

term

monomial

polynomial

differentialPolynomial
*/

/////////////////////////////
intrinsic Parent(x::RngDiffPolElt)->RngDiffPol
/////////////////////////////
{}
    return x`parent;
end intrinsic;

/////////////////////////////
intrinsic Parent(x::RngDiffPolTerm)->RngDiffPol
/////////////////////////////
{}
    return x`parent;
end intrinsic;

/////////////////////////////
intrinsic Parent(x::RngDiffPolMon)->RngDiffPol
/////////////////////////////
{}
    return x`parent;
end intrinsic;

/////////////////////////////
intrinsic coefficient(t1::RngDiffPolTerm)->RngElt
/////////////////////////////
{}
    return t1`coefficient;
end intrinsic;

/////////////////////////////
intrinsic monomial(t1::RngDiffPolTerm)->RngDiffPolMon
/////////////////////////////
{}
    if not assigned t1`monomial then
        R:=Parent(t1);
        e:=exponent(t1);
        mon:=monomial(R,e);
        t1`monomial:=mon;
    end if;
    
    return t1`monomial;

end intrinsic;

/////////////////////////////
intrinsic monomial(t1::RngDiffPolMon)->RngDiffPolMon
/////////////////////////////
{}
    return t1;

end intrinsic;


/////////////////////////////
intrinsic monomials(dpoly::RngDiffPolElt)->Set
/////////////////////////////
{}
    return {monomial(t) : t in terms(dpoly)};

end intrinsic;


/////////////////////////////
intrinsic exponentRing(R::RngDiffPol)->RngUPol
/////////////////////////////
{}
    return R`exponent_ring;
end intrinsic;

/////////////////////////////
intrinsic exponent(mon::RngDiffPolMon)->SeqEnum[RngUPolElt]
/////////////////////////////
{}
    return mon`exponent;
end intrinsic;

/////////////////////////////
intrinsic exponent(t::RngDiffPolTerm)->SeqEnum[RngUPolElt]
/////////////////////////////
{}
    if not assigned t`exponent then
        t`exponent :=exponent(monomial(t));
    end if;
    
    return t`exponent;
end intrinsic;

/////////////////////////////
intrinsic terms(dpoly::RngDiffPolElt)->SetEnum[RngDiffPolTerm]
/////////////////////////////
{}
    return dpoly`terms;
end intrinsic;

/////////////////////////////
intrinsic terms(m::RngDiffPolMon)->SetEnum[RngDiffPolTerm]
/////////////////////////////
{}
    return {term(m)};
end intrinsic;


/////////////////////////////
intrinsic coeff(f0::RngDiffPolTerm)->RngElt
/////////////////////////////
{}
    return f0`coefficient;
end intrinsic;

/////////////////////////////
intrinsic baseRing(R::RngDiffPol)->Rng
/////////////////////////////
{}
    return R`base_ring;
end intrinsic;

/////////////////////////////
intrinsic maxOrders(R::RngDiffPol)->SeqEnum
/////////////////////////////
{}
    return R`max_orders;
end intrinsic;

/////////////////////////////
intrinsic Nvariables(R::RngDiffPol)->RngIntElt
/////////////////////////////
{}
    return R`number_of_variables;
end intrinsic;

/////////////////////////////
intrinsic polynomialRing(R::RngDiffPol)->RngPol
/////////////////////////////
{}
    return R`polynomial_ring;
end intrinsic;

/////////////////////////////
intrinsic JetRing(R::RngDiffPol,r::RngIntElt)->RngMPol
/////////////////////////////
{}
    return R`polynomial_ring;
end intrinsic;


//##################################################
//##################################################
//  HASHING
//##################################################
//##################################################

/*

equality:
    RngDiffPol
    RngDiffPolMon
    RngDiffPolTerm
    RngDiffPolElt
    
*/

/////////////////////////////
intrinsic 'eq'(R1::RngDiffPol,R2::RngDiffPol)->BoolElt
/////////////////////////////
{}
    return (baseRing(R1) eq baseRing(R2)) and (Nvariables(R1) eq Nvariables(R2));

end intrinsic;

/////////////////////////////
intrinsic 'eq'(m1::RngDiffPolMon,m2::RngDiffPolMon)->BoolElt
/////////////////////////////
{}
    return ((Parent(m1) eq Parent(m2)) and (exponent(m1) eq exponent(m2)));
end intrinsic;

/////////////////////////////
intrinsic 'eq'(term1::RngDiffPolTerm,term2::RngDiffPolTerm)->BoolElt
/////////////////////////////
{}
    return (coefficient(term1) eq coefficient(term2)) and (monomial(term1) eq monomial(term2));
end intrinsic;

/////////////////////////////
intrinsic 'eq'(f1::RngDiffPolElt,f2::RngDiffPolElt)->BoolElt
/////////////////////////////
{}
    return (terms(f1) eq terms(f2));
end intrinsic;


/////////////////////////////
intrinsic isTerm(f::RngDiffPolElt)->BoolElt
/////////////////////////////
{}
    ts:=[t: t in terms(f)];
    if #ts eq 1 then
        return true;
    else
        return false;
    end if;
end intrinsic;

/////////////////////////////
intrinsic term(f::RngDiffPolElt) -> RngDiffPolTerm
/////////////////////////////
{}
    ts:=[t: t in terms(f)];
    require #ts eq 1: "Differential polynomial must be a term";
    return ts[1];
    end intrinsic;

/////////////////////////////
intrinsic isMonomial(p::RngDiffPolElt) -> BoolElt,.
/////////////////////////////
{}
    is_term,term:=isTerm(p);
    if is_term then
        if coeff(term) eq 1 then
            return true,monomial(term);
        else
            return false;
        end if;
    else
        return false;
    end if;
end intrinsic;

/////////////////////////////
intrinsic monomial(f::RngDiffPolElt) -> RngDiffPolMon
/////////////////////////////
{}
    ts:=[t: t in terms(f)];
    require #ts eq 1: "Differential polynomial must be a term";
    t1:=ts[1];
    return monomial(Parent(t1),exponent(t1));
end intrinsic;

/////////////////////////////
intrinsic Hash(m1::RngDiffPolMon)->RngIntElt
/////////////////////////////
{}
    return Hash(exponent(m1));
end intrinsic;

/////////////////////////////
intrinsic Hash(term::RngDiffPolTerm)->RngIntElt
/////////////////////////////
{}
    return Hash(<coefficient(term),monomial(term)>);
end intrinsic;

/////////////////////////////
intrinsic Hash(f::RngDiffPolElt)->RngIntElt
/////////////////////////////
{}
    return Hash(terms(f));
end intrinsic;

/////////////////////////////
intrinsic Hash(R::RngDiffPol)->RngIntElt
/////////////////////////////
{}
    return Hash(<Nvariables(R),baseRing(R)>);
end intrinsic;


//##################################################
//##################################################
//  COERCION
//##################################################
//##################################################

/*
monomial->term->differentialPolynomial
constant->term
*/


/////////////////////////////
intrinsic monomial(R::RngDiffPol, e::SeqEnum[RngElt])->RngDiffPolMon
/////////////////////////////
{}
    require Nvariables(R) eq #e: "the number of exponents needs to be equal to the number of variables";
    require e[1] in exponentRing(R): "entries need to be univariate polynomials with non-negative integer entries";
    
    mon:=New(RngDiffPolMon);
    E:=exponentRing(R);
    mon`exponent:=[E!x: x in e];
    mon`parent:=R;
    mon`coefficient:=baseRing(R)!1;
    
    return mon;
    
end intrinsic;

intrinsic monomial(R::RngDiffPol,seq::SeqEnum)->RngDiffPolMon
{Create a monomial from an element sequence}
/*
f:=3*Diff(x,2)*Diff(y,1)^2+(1/2)*z+2;
sortedTerms(f);
m:=leadingMonomial(f);
monomial(Parent(m),Eltseq_m(m)) eq m;
*/
    return &*[R.seqi[1]^seqi[2] : seqi in seq];
end intrinsic;

/////////////////////////////
intrinsic one(R:RngDiffPol) -> RngDiffPolMon
/////////////////////////////
{}
    
    E:=exponentRing(R);
    return monomial(R,[E!0 : i in [1..Nvariables(R)]]);
end intrinsic;

/////////////////////////////
intrinsic isOne(p::RngDiffPolElt) -> RngDiffPolMon
/////////////////////////////
{}
    mybool:=isTerm(p);
    if mybool then
        myterm:=term(p);
        if coefficient(myterm) eq 1 then
            R:=Parent(myterm);
            return (one(R) eq monomial(myterm));
        else
            return false;
        end if;
    else
        return false;
    end if;
    
end intrinsic;

/////////////////////////////
intrinsic isOne(t::RngDiffPolTerm) -> RngDiffPolMon
/////////////////////////////
{}
    return isOne(differentialPolynomial(t));
end intrinsic;

/////////////////////////////
intrinsic isOne(m::RngDiffPolMon) -> RngDiffPolMon
/////////////////////////////
{}
    return isOne(differentialPolynomial(m));
end intrinsic;

/////////////////////////////
intrinsic term(mon::RngDiffPolMon)->RngDiffPolTerm
/////////////////////////////
{}

    trm:=New(RngDiffPolTerm);
    trm`parent:=Parent(mon);
    trm`coefficient:=baseRing(Parent(mon))!1;
    trm`monomial:=mon;
    
    return trm;
    
end intrinsic;

/////////////////////////////
intrinsic term(R::RngDiffPol,c::RngElt) -> RngDiffPolTerm
/////////////////////////////
{}
    t1:=New(RngDiffPolTerm);
    t1`parent:=R;
    require c ne 0: "can't have a term with a zero coefficient";
    t1`coefficient:=baseRing(R)!c;
    t1`monomial:=one(R);
    return t1;
end intrinsic;

/////////////////////////////
intrinsic isConstant(t::RngDiffPolTerm) -> BoolElt
/////////////////////////////
{}
    if isOne(monomial(t)) then
        return true;
    else
        return false;
    end if;
end intrinsic;

/////////////////////////////
intrinsic zero(R::RngDiffPol) -> RngDiffPolElt
/////////////////////////////
{}
/*
Zero is going to be a differential polynomial with no terms.
*/
    dpoly:=New(RngDiffPolElt);
    dpoly`parent:=R;
    dpoly`terms:={};
    return dpoly;
end intrinsic;

/////////////////////////////
intrinsic isZero(p::RngDiffPolElt) -> BoolElt
/////////////////////////////
{}
/*
Zero is going to be a differential polynomial with no terms.
*/
    if #terms(p) eq 0 then
        return true;
    else
        return false;
    end if;
end intrinsic;



/////////////////////////////
intrinsic differentialPolynomial(t1::RngDiffPolTerm)->RngDiffPolElt
/////////////////////////////
{}
    dpoly:=New(RngDiffPolElt);
    dpoly`parent:=t1`parent;
    dpoly`terms:={t1};
    return dpoly;
    
end intrinsic;

/////////////////////////////
intrinsic differentialPolynomial(t1::RngDiffPolMon)->RngDiffPolElt
/////////////////////////////
{}
    dpoly:=New(RngDiffPolElt);
    dpoly`parent:=t1`parent;
    dpoly`terms:={term(t1)};
    return dpoly;
    
end intrinsic;

/////////////////////////////
intrinsic differentialPolynomial(t1::RngDiffPolElt)->RngDiffPolElt
/////////////////////////////
{}
    return t1;
    
end intrinsic;

/////////////////////////////
intrinsic IsCoercible(R::RngDiffPol,x::.) -> BoolElt,.
/////////////////////////////
{}
    vprintf RngDiffPol,5: "Coercions for RngDiffPol, type %o \n", Type(x);
        
    if Type(x) eq RngDiffPolTerm then
        if Parent(x) eq R then
            return true, differentialPolynomial(x);
        end if;
    elif Type(x) eq RngDiffPolMon then
        t:=term(x);
        if Parent(t) eq R then
            return true, differentialPolynomial(x);
        end if;
    elif Type(x) eq RngIntElt then
        if x eq 0 then
            return true, zero(R);
        else
            return true, differentialPolynomial(term(R,baseRing(R)!x));
        end if;
    elif Type(x) eq SeqEnum then
        if #x eq 0 then
            return true, R!0;
        else
            return true, &+[s[1]*&*[(R.t[1])^t[2] : t in s[2]] : s in x];
        end if;
    elif Type(x) eq RngElt then
        if x in baseRing(R) then
            return true, differentialPolynomial(term(R,baseRing(R)!x));
        end if;
    else
        return false;
    end if;

end intrinsic;

//##################################################
//##################################################
//  MULTIPLICATION
//##################################################
//##################################################
/*
Constant Monomial
Monomial Constant

Monomial Monomial

Term Term

Monomial Term
Term Monomial

Constant Term
Term Constant

Term Polymomial
Polynomial Term

Polynomial Polynomial
*/

/////////////////////////////
intrinsic '*'(c::RngElt,m2::RngDiffPolMon)->.
/////////////////////////////
{}
    vprintf RngDiffPol, 5: "entering multiplication between ring elements and monomials...\n";
    R:=baseRing(Parent(m2));
    
    cR:=R!c;
    
    if cR eq 1 then
        return m2;
    else
        return term(Parent(m2),c)*m2;
    end if;
    
end intrinsic;

/////////////////////////////
intrinsic '*'(m2::RngDiffPolMon,c::RngElt)->.
/////////////////////////////
{}
    return c*m2;
end intrinsic;

/////////////////////////////
intrinsic '*'(m1::RngDiffPolMon,m2::RngDiffPolMon)->RngDiffPolMon
/////////////////////////////
{}
    R:=Parent(m1);
    require Parent(m2) eq R: "The element must be monomials for the same ring";
    
    n:=Nvariables(R);
    e1:=exponent(m1);
    e2:=exponent(m2);
    return monomial(R,[e1[i]+e2[i] : i in [1..n]]);

end intrinsic;

/////////////////////////////
intrinsic '*'(t1::RngDiffPolTerm,t2::RngDiffPolTerm)->RngDiffPolTerm
/////////////////////////////
{}
    R:=Parent(t1);
    require Parent(t2) eq R: "The element must be monomials for the same ring";
    
    t3:=New(RngDiffPolTerm);
    t3`parent:=R;
    t3`coefficient:=coeff(t1)*coeff(t2);
    t3`monomial:=monomial(t1)*monomial(t2);
    return t3;

end intrinsic;

/////////////////////////////
intrinsic '*'(m1::RngDiffPolMon,t1::RngDiffPolTerm)->RngDiffPolTerm
/////////////////////////////
{}
   return term(m1)*t1;
   
end intrinsic;

/////////////////////////////
intrinsic '*'(t1::RngDiffPolTerm,m1::RngDiffPolMon)->RngDiffPolTerm
/////////////////////////////
{}
   return m1*t1;
   
end intrinsic;

/////////////////////////////
intrinsic '*'(c::RngElt,t1::RngDiffPolTerm)->RngDiffPolTerm
/////////////////////////////
{}
    vprintf RngDiffPol, 5: "entering multiplication between ring elements and monomials...\n";
    R:=Parent(t1);
    return term(R,c)*t1;
    
end intrinsic;

/////////////////////////////
intrinsic '*'(t1::RngDiffPolTerm,c::RngElt)->RngDiffPolTerm
/////////////////////////////
{}
    vprint RngDiffPol, 5: "entering multiplication between ring elements and monomials...\n";
    return c*t1;
    
end intrinsic;

/////////////////////////////
intrinsic '*'(t1::RngDiffPolTerm,f::RngDiffPolElt)->RngDiffPolElt
/////////////////////////////
{}
    return differentialPolynomial(t1)*f;
    
end intrinsic;

/////////////////////////////
intrinsic '*'(f::RngDiffPolElt,t1::RngDiffPolTerm)->RngDiffPolElt
/////////////////////////////
{}
    return t1*f;
end intrinsic;

/////////////////////////////
intrinsic '*'(c1::RngElt,f::RngDiffPolElt)->RngDiffPolElt
/////////////////////////////
{}
    return &+[c1*t : t in terms(f)];
end intrinsic;

/////////////////////////////
intrinsic '*'(f::RngDiffPolElt,c1::RngElt)->RngDiffPolElt
/////////////////////////////
{}
    return c1*f;
end intrinsic;

/////////////////////////////
intrinsic '*'(f1::RngDiffPolElt,f2::RngDiffPolElt)->RngDiffPolElt
/////////////////////////////
{}
    R1:=Parent(f1);
    require R1 eq Parent(f2): "The elements must be members of the same ring of differential polynomials";
    T1:=terms(f1);
    T2:=terms(f2);
    return &+[t1*t2 : t1 in T1, t2 in T2];
end intrinsic;


//##################################################
//##################################################
//  DIFFERENTIATION
//##################################################
//##################################################
/*

Monomial -> Polynomial

Term -> Polynomial

Polymomial -> Polynomial

*/

/////////////////////////////
intrinsic Diff(m::RngDiffPolMon)->RngDiffPolElt
/////////////////////////////
{}
    R:=Parent(m);
    E<d>:=exponentRing(R);
    exp:=exponent(m);
    factors:=[];
    for i in [1..#exp] do
        new_exp:=exp;
        ei:=exp[i];
        new_exp[i]:=0;
        for tij in Terms(ei) do
            cij:=Coefficients(tij)[1];
            rij:=Degree(tij);
            ei_new:=ei-tij;
            ei_new:=(cij-1)*d^(rij)+d^(rij+1);
            new_exp[i]:=ei_new;
            moni:=cij*monomial(R,new_exp);
            factors:=factors cat [moni];
        end for;
    end for;
    
    derivative:=&+factors;
    return derivative;
end intrinsic;


/////////////////////////////
intrinsic Diff(t1::RngDiffPolTerm)->RngDiffPolElt
/////////////////////////////
{}
    return coefficient(t1)*Diff(monomial(t1));
end intrinsic;



/////////////////////////////
intrinsic Diff(f1::RngDiffPolElt)->RngDiffPolElt
/////////////////////////////
{}
    T1:=terms(f1);
    return &+[Diff(t1) : t1 in T1];
end intrinsic;

/////////////////////////////
intrinsic Diff(f1::RngDiffPolElt,n::RngIntElt)->RngDiffPolElt
/////////////////////////////
{}
    require n ge 0: "Must take a non-negative number of derivatives";
    
    if n eq 0 then
        return f1;
    elif n eq 1 then
        return Diff(f1);
    else
        return Diff(Diff(f1,n-1));
    end if;
end intrinsic;

/////////////////////////////
intrinsic Diff(f1::RngDiffPolMon,n::RngIntElt)->RngDiffPolElt
/////////////////////////////
{}
    require n ge 0: "Must take a non-negative number of derivatives";
    
    if n eq 0 then
        return f1;
    elif n eq 1 then
        return Diff(f1);
    else
        return Diff(Diff(f1,n-1));
    end if;
    
end intrinsic;

//##################################################
//##################################################
//  EXPONENTIATION
//##################################################
//##################################################

/////////////////////////////
intrinsic '^'(f1::RngDiffPolElt,n::RngIntElt)->RngDiffPolElt
/////////////////////////////
{}

require n ge 0: "n must be a non-negative integer";

R:=Parent(f1);

if n eq 0 then
    return differentialPolynomial(one(R));
else
    return &*[f1 : i in [1..n]];
end if;
   
end intrinsic;

/////////////////////////////
intrinsic '^'(f1::RngDiffPolTerm,n::RngIntElt)->RngDiffPolTerm
/////////////////////////////
{}

require n ge 0: "n must be a non-negative integer";

R:=Parent(f1);

if n eq 0 then
    return term(one(R));
else
    return &*[f1 : i in [1..n]];
end if;
   
end intrinsic;

/////////////////////////////
intrinsic '^'(f1::RngDiffPolMon,n::RngIntElt)->RngDiffPolMon
/////////////////////////////
{}

require n ge 0: "n must be a non-negative integer";

R:=Parent(f1);

if n eq 0 then
    return one(R);
else
    return &*[f1 : i in [1..n]];
end if;
   
end intrinsic;



//##################################################
//##################################################
//  ADDITION
//##################################################
//##################################################
/*
Constant Monomial
Monomial Constant

Monomial Monomial

Term Term

Monomial Term
Term Monomial

Constant Term
Term Constant

Term Polymomial
Polynomial Term

Polynomial Polynomial
*/

/////////////////////////////
intrinsic '+'(m0::RngDiffPolMon,c::RngElt)->RngDiffPolElt
/////////////////////////////
{}
    //---printing---
    vprintf RngDiffPol, 5: "entering addition function for monoid elements and constants...\n";

    R:=Parent(m0);
    B:=baseRing(R);
    return term(m0)+term(R,c);
    
end intrinsic;

/////////////////////////////
intrinsic '+'(c::RngElt,m0::RngDiffPolMon)->RngDiffPolElt
/////////////////////////////
{}
    return m0+c;
end intrinsic;

/////////////////////////////
intrinsic '+'(f0::RngDiffPolMon,g0::RngDiffPolMon)->RngDiffPolElt
/////////////////////////////
{}
    //---printing---
    vprintf RngDiffPol, 5: "entering addition function for monoid elements...\n";

    require Parent(f0) eq Parent(g0): "Must have terms from the same polynomial ring";
    
    //---printing---
    vprintf RngDiffPol, 5: "computing terms...\n term(f0)=%o, term(g0)=%o ...\n", term(f0),term(g0);
    
    return term(f0)+term(g0);
    
end intrinsic;

/////////////////////////////
intrinsic '+'(m1::RngDiffPolMon,t1::RngDiffPolTerm)->RngDiffPolElt
/////////////////////////////
{}
    return term(m1)+t1;
end intrinsic;

/////////////////////////////
intrinsic '+'(t1::RngDiffPolTerm,m1::RngDiffPolMon)->RngDiffPolElt
/////////////////////////////
{}
    return m1+t1;
end intrinsic;

/////////////////////////////
intrinsic '+'(c1::RngElt, t1::RngDiffPolTerm)->RngDiffPolElt
/////////////////////////////
{}
    R:=Parent(t1);
    if c1 eq 0 then
        return t1;
    else
        return term(R,c1)+t1;
    end if;
end intrinsic;

/////////////////////////////
intrinsic '+'(t1::RngDiffPolTerm,c1::RngElt)->RngDiffPolElt
/////////////////////////////
{}
    return c1+t1;
end intrinsic;

/////////////////////////////
intrinsic '+'(f0::RngDiffPolTerm,g0::RngDiffPolTerm)->.
/////////////////////////////
{}
    R:=Parent(f0);
    require Parent(f0) eq Parent(g0): "Must have terms from the same differential polynomial ring";
    
    //---printing---
    vprintf RngDiffPol,5: "inside '+', two RngDiffPolTerm...\n monomial(f0)=%o, monomial(g0)=%o ... \n", monomial(f0),monomial(g0);
    
    if monomial(f0) eq monomial(g0) then
        h:=New(RngDiffPolTerm);
        h`parent:=Parent(f0);
        h`monomial:=monomial(f0);
        h`coefficient:=coefficient(f0)+coefficient(g0);
        if h`coefficient eq 0 then
            return zero(R);
        else
            
            //---printing---
            vprintf RngDiffPol, 5: "we have computed h=%o...\n",h;
            
            return h;
        end if;
    else
    //---printing---
    vprintf RngDiffPol, 5: "two monomials are not same...\n";
        h:=New(RngDiffPolElt);
        h`terms:={f0,g0};
        h`parent:=Parent(f0);
        return h;
    end if;
    
end intrinsic;

/////////////////////////////
intrinsic '+'(t0::RngDiffPolTerm,g0::RngDiffPolElt)->RngDiffPolElt
/////////////////////////////
{}
    require Parent(t0) eq Parent(g0): "The term and differential polynomial must have the same differential polynomial ring.";
    
    if monomial(t0) in monomials(g0) then
        h:=New(RngDiffPolElt);
        h`terms:={ x: x in terms(g0)| monomial(x) ne monomial(t0) } join {x + t0 : x in terms(g0) | monomial(x) eq monomial(t0)};
        h`parent:=Parent(g0);
        return h;
    else
        h:=New(RngDiffPolElt);
        h`terms := {t0} join terms(g0);
        h`parent:=Parent(g0);
        return h;
    end if;

end intrinsic;
    

/////////////////////////////
intrinsic '+'(g0::RngDiffPolElt,f0::RngDiffPolTerm)->RngDiffPolElt
/////////////////////////////
{}
    return f0+g0;
    
end intrinsic;

/////////////////////////////
intrinsic '+'(f1::RngDiffPolElt,f2::RngDiffPolElt)->RngDiffPolElt
/////////////////////////////
{}
    //This can maybe be improved by going to element sequences so there isn't as much sorting
    R:=Parent(f1);
    terms1:=[t: t in terms(f1)];
    
    result:=f2;
    
    for t in terms1 do
        result:=t+result;
    end for;
    
    return result;
end intrinsic;

/////////////////////////////
intrinsic '+'(f1::RngDiffPolElt,c::RngElt)->RngDiffPolElt
/////////////////////////////
{}
    R:=Parent(f1);
    return f1+R!c;
end intrinsic;

/////////////////////////////
intrinsic '+'(c::RngElt,f1::RngDiffPolElt)->RngDiffPolElt
/////////////////////////////
{}
    R:=Parent(f1);
    return f1+R!c;
end intrinsic;


/////////////////////////////
intrinsic '-'(f1::RngDiffPolMon)->RngDiffPolTerm
/////////////////////////////
{}
    return -term(f1);
    
end intrinsic;

/////////////////////////////
intrinsic '-'(f1::RngDiffPolTerm)->RngDiffPolTerm
/////////////////////////////
{}
    f2:=New(RngDiffPolTerm);
    f2`monomial:=monomial(f1);
    f2`coefficient:=-coefficient(f1);
    f2`parent:=Parent(f1);
    return f2;
    
end intrinsic;

/////////////////////////////
intrinsic '-'(f1::RngDiffPolElt)->RngDiffPolElt
/////////////////////////////
{}
    f2:=New(RngDiffPolElt);
    f2`terms:={-t: t in terms(f1)};
    f2`parent:=Parent(f1);
    return f2;
    
end intrinsic;


