//##################################################
//##################################################
//  POLYNOMIAL ALGORITHMS
//##################################################
//##################################################

////////////////////////////////////
intrinsic polynomialTermOrder(R::RngDiffPol)->RngPol
////////////////////////////////////
{}
    //http://magma.maths.usyd.edu.au/magma/handbook/text/1259#14366
    // PolynomialRing(Z, 4, "elim", [1, 4], [2, 3])
    //<"weight", [ 100, 10, 1, 1, 10, 100, 1, 1, 1 ]>
    return <"weight",weights(R)>;
end intrinsic;

/////////////////////////////////
intrinsic NpolynomialVariables(R::RngDiffPol)->RngIntElt
/////////////////////////////////
{}
    max_orders:=maxOrders(R);
    return #max_orders+&+max_orders;
    
end intrinsic;


///////////////////////////////////////
intrinsic weights(R::RngDiffPol,term_order)->SeqEnum
///////////////////////////////////////
{}
    /*
    Order the monomials and then figure out which variable they correspond to.
    If lex, then you just put the standard basis vectors in rows corresponding to their order.
    If block, then you need to do one block at a time as in the example below:
    
    <"elim", [ 1, 4 ], [ 2, 3 ]>
    > MonomialOrderWeightVectors(P);

    [ 1, 0, 0, 1 ],
    [ 1, 0, 0, 0 ],
    [ 0, 1, 1, 0 ],
    [ 0, 1, 0, 0 ]
    
    We will have much larger blocks though.
    First there will be max_order[1]+1 variables corresp to x1 and its ders.
    Second there will be max_order[2]+1 variables corresp to x2 and its ders.
    ...
    If we have a block order [[3],[1],[2,4]] then this corresponds to a block order
    [ [3,n3],...,[3,0] ], [ [1,n1],...,[1,0] ], [ [2,j],[4,j] ] ordered according to j first then according to 2]
    
    */
    max_orders:=maxOrders(R);
    N:=NpolynomialVariables(R);
    
    tup:=monomialOrder(R);
    label:=tup[1];
    data:=tup[2];
    
    if label eq "elim" then
        dblocks:=data;
        blocks:=dblocks_to_blocks(R,dblocks);
        return MonomialOrderWeightVectors(<"elim",Explode(blocks)>);
    elif label eq "rank" then
        //data:=comparison_function;
        seq:=[polynomialIndex(R,pair) : pair in rankingSeq(R)];
        A:=FreeAbelianGroup(N);
        W:=[Eltseq(A.i) : i in seq];
        return W;
    end if;
end intrinsic;


////////////////////////////////////
intrinsic dblocks_to_blocks(R,dblocks::SeqEnum)->SeqEnum
////////////////////////////////////
{}

/*
dblocks:=[ [1,2],[3,4] ];
dblocks:=[ [1,2,3,4]]; //pure lexicographic
dblocks:=[[1],[2],[3],[4]]; //pure elimination

*/
    max_orders:=maxOrders(R);
    return [ &cat[ Reverse([ polynomialIndex(R,[i,j]) : j in [0..max_orders[i]] ]) : i in dblock] : dblock in dblocks];
end intrinsic;

////////////////////////////////////
intrinsic polynomialIndex(R::RngDiffElt,pair::SeqEnum[RngIntElt])->RngIntElt
////////////////////////////////////
{

If the maximum orders are r(1),r(2),...,r(n) with n-variables, then
    index of [i,r]= (r(1)+1)+(r(2)+1)+...+(r(i-1)+1)+r+1
    
}

    i,r:=Explode(pair);
    orders:=maxOrders(R);
    require r le orders[i]: "The order exceeds the bound. Adjust the bound using setMaxOrder.";
    
    A:=&+[orders[j] : j in [1..i-1]];
    B:=(#orders-i)-1;
    C:=r;
    
    return A+B+C;
    
end intrinsic;


////////////////////////////////////
intrinsic monomialOrder(R::RngDiffElt)->Tup
////////////////////////////////////
{}
    return R`term_order;
end intrinsic;

////////////////////////////////////
intrinsic ranking(R::RngDiffPol)->UserProgram
////////////////////////////////////
{
    
}
    //---printing---
    vprintf RngDiffPol, 5: "Requesting the ranking of the ring of differential polynomials... \n";
    


    if not assigned R`ranking then
        //---printing---
        vprintf RngDiffPol, 5: "Ranking has not been assigned... \n";
        
        term_order:=R`term_order;
        label:=term_order[1];
        
        if label eq "rank" then
            
            //---printing---
            vprintf RngDiffPol, 5: "Setting the ranking... \n";
            
            dblocks:=term_order[2];
            setRanking(R, dblocks);
        else
            error "The term order on the differential polynomial ring is not lexicographic induced by a ranking. The first part of the term_order tuple needs to be 'rank' (in quotes) and the second part needs to be a comparison function.";
        end if;
    end if;
    
    
    //---printing---
    vprintf RngDiffPol, 5: "Returning the ranking... \n";
    return R`ranking;
        
    
end intrinsic;


////////////////////////////////////
intrinsic setRanking(R::RngDiffPol, comparison::UserProgram)
////////////////////////////////////
{
    
}
   R`ranking:=comparison;
   setPolynomialRing(~R:term_order:=<"rank",comparison>);

end intrinsic;

////////////////////////////////////
intrinsic setRanking(R::RngDiffPol, dblocks::SeqEnum)
////////////////////////////////////
{
    
}
   R`ranking:=get_ranking(dblocks);
   setPolynomialRing(~R:term_order:=<"rank",ranking>);

end intrinsic;


////////////////////////////////////
intrinsic setPolynomialRing(~R::RngDiffPol:term_order:=Tup)
////////////////////////////////////
{
    
}
    
end intrinsic;


////////////////////////////////////
intrinsic rankingSeq(R::RngDiffPol)->SeqEnum
////////////////////////////////////
{
    
}
    if not assigned R`ranking_sequence then
        orders:=maxOrders(R);
        
        vprintf RngDiffPol, 5: "maxOrders %o ... \n", orders;
        
        all_indices:=[];
        for i in [1..Nvariables(R)] do
            for j in [0..orders[i]] do
                Append(~all_indices,[i,j]);
            end for;
        end for;
        
        comparison_function:=ranking(R);
        Sort(~all_indices,comparison_function);
        R`ranking_sequence:=all_indices;
    end if;
        
    return R`ranking_sequence;
    
end intrinsic;


/////////////////////////////
intrinsic polynomialGenerators(R::RngDiffPol)->SeqEnum
/////////////////////////////
{}
    rs:=maxOrders(R);
    n:=Nvariables(R);
    monomials:=[];
    for i in [1..n] do
        for j in [1..rs[i]] do
            Append(~monomials,Diff(R.i,n));
        end for;
    end for;
    Sort(~monomials);
    
    return monomials;
    
end intrinsic;

/////////////////////////////
intrinsic setMaxOrders(R::RngDiffPol,rs::SeqEnum[RngIntElt])
/////////////////////////////
{}
    rs:=maxOrders(R);
    monomials:=polynomialGenerators(R);
    new_ring:=polynomialRing(R,#monomials : order:=polynomialTermOrder(R));
    
    for i in [1..#monomials] do
        monomials[i]`polynomial:=new_ring.i;
    end for;
    
    R`polynomial_ring:=new_ring;
    
end intrinsic;

intrinsic Eltseq(mon:RngMonElt)->SeqEnum
{}

    e:=exponent(mon);
    n:=Nvariables(Parent(mon));
    
    vprintf RngDiffPol, 4: "%o", mon;
    
    if e eq [0 : i in [1..n]] then
        return [<[],0>];
    else
        return &cat[[<[i,Degree(t)],Coefficients(t)[1]> : t in Terms(e[i])] : i in [1..n]];
    end if;
end intrinsic;

/////////////////////////////
intrinsic orders(mon::RngDiffPolMon)->SeqEnum
/////////////////////////////
{}
    e:=exponent(mon);
    return [Degree(x) : x in e];
end intrinsic;


/////////////////////////////
intrinsic polynomial(mon::RngDiffPolMon)->RngMPolElt
/////////////////////////////
{}
    R:=Parent(mon);
    require orders(mon) le maxOrders(R): "The maximum orders for the polynomial ring need to be increased. Do this using setMaxOrders.";
    
    powers:=[];
    for x in Eltseq(mon) do
        pair:=x[1];
        power:=x[2];
        P:=polynomialRing(R);
        i:=Index(rankingSeq(R),pair);
        Append(~powers,(P.i)^power);
    end for;
    
    return &*powers;
end intrinsic;


/////////////////////////////
intrinsic polynomial(t1::RngDiffPolTerm)->RngMPolElt
/////////////////////////////
{}
    R:=Parent(t1);
    return coefficient(t1)*polynomial(monomial(t1));

end intrinsic;

/////////////////////////////
intrinsic polynomial(dpoly::RngDiffPolElt)->RngDiffPolElt
/////////////////////////////
{}
    if not assigned dpoly`polynomial then
        dpoly`polynomial:=&+[polynomial(term) : term in terms(dpoly)];
    elif not dpoly`polynomial in polynomialRing(Parent(dpoly)) then
        dpoly`polynomial:=&+[polynomial(term) : term in terms(dpoly)];
    end if;
    
    return dpoly`polynomial;
        
end intrinsic;


/////////////////////////////
intrinsic polynomial(dpoly::RngDiffPolElt)->RngDiffPolElt
/////////////////////////////
{}
    if not assigned dpoly`polynomial then
        dpoly`polynomial:=&+[polynomial(term) : term in terms(dpoly)];
    elif not dpoly`polynomial in polynomialRing(Parent(dpoly)) then
        dpoly`polynomial:=&+[polynomial(term) : term in terms(dpoly)];
    end if;
    
    return dpoly`polynomial;
        
end intrinsic;


//###########################
intrinsic get_block_map(blocks::SeqEnum)->UserProgram
//###########################
{}
/*
    
    EXAMPLES:
    
        >blocks:=[[3,2],[1,5],[4]];
        >my_rank:=get_ranking(blocks);
        >my_rank([1,2],[3,2]);
        >my_rank([3,1],[2,1]);
        >my_rank([2,2],[2,1]);
        >my_rank([4,5],[2,1]);
        -1
        2
        1
        -2

*/
    
    function block_map(n,blocks)
    //The comparison function C must take two arguments and return an integer less than,
    //equal to, or greater than 0 according to whether the first argument is less than,
    //equal to, or greater than the second argument (e.g.: func<x, y | x - y>).
        for i in [1..#blocks] do
            if n in blocks[i] then
                return i;
            end if;
        end for;
    end function;
    
    block_map_red:=func<n|block_map(n,blocks)>;
    
    return block_map_red;
    
end intrinsic;

//###########################
intrinsic get_ranking(blocks::SeqEnum)->UserProgram
//###########################
{}
/*
    
    EXAMPLES:
    
        >blocks:=[[3,2],[1,5],[4]];
        >my_rank:=get_ranking(blocks);
        
    The variable is in a later block:
        
        >my_rank([1,2],[3,2]);
        -1
    
    Same block, same order but 3 comes before 2.
        
        >my_rank([3,1],[2,1]);
        2
        
    Same variable but higher order is higher rank.
        
        >my_rank([2,2],[2,1]);
        1
        
    No matter how big you take the derivative, if it is
    in a lower block it will be eliminated.
        >my_rank([4,5],[2,1]);
        -2

*/
    flattened:=&cat[b:b in blocks];
    num_vars:=#flattened;
    
    if not Sort(flattened) eq [1..num_vars] then
        printf "A complete set of numbers needs to appear in the blocks.";
        return 0;
    end if;
    
    
    G:=Sym(#flattened);
    sigma:=G!flattened;
    tau:=sigma^(-1);
    
    block_map:=get_block_map(blocks);
    
    function block_rank(pair1,pair2)
    //The comparison function C must take two arguments and return an integer less than,
    //equal to, or greater than 0 according to whether the first argument is less than,
    //equal to, or greater than the second argument (e.g.: func<x, y | x - y>).
    /*
    If the variable appears in an early block it wins.
    If they are in the same block, use lexicographic rank.
    */
        i1:=pair1[1];
        j1:=pair1[2];
        i2:=pair2[1];
        j2:=pair2[2];
        
        b1:=block_map(i1);
        b2:=block_map(i2);
        
        //ans:=0;
        
        if b1 ne b2 then
            ans:=b2-b1;
        elif b1 eq b2 then
            ii1:=i1^tau;
            ii2:=j1^tau;
            ans:=-rank_lex([ii1,j1],[ii2,j2]);
        end if;
        
        return ans;
        
    end function;
        
    return block_rank;
end intrinsic;
