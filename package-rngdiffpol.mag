intrinsic variableNames(R::RngDiffPol) -> SeqEnum
{}
    if not assigned R`variable_names then
        R`variable_names:=[ Sprintf("x%o",i) : i in [1..Nvariables(R)]];
    end if;
    
    return R`variable_names;
end intrinsic;

intrinsic NumberOfNames(R::RngDiffPol)->RngIntElt
{}
    return Nvariables(R);
end intrinsic;


intrinsic Name(R::RngDiffPol,i::RngIntElt)->RngDiffPolMon
{}
    return R.i;
end intrinsic;

intrinsic Name(R::RngDiffPol,pair::SeqEnum)->RngDiffPolMon
{}
    return R.pair;
end intrinsic;

intrinsic AssignNames(~R::RngDiffPol,s::SeqEnum)
{}
    R`variable_names := s;
end intrinsic;

intrinsic Print(R::RngDiffPol)
{}
    printf "Ordinary Differential Polynomial Ring over %o in %o variables. ", baseRing(R), Nvariables(R);
    
end intrinsic;

intrinsic '.'(R::RngDiffPol,i::RngIntElt) -> RngDiffPolMon
{}
    P:=exponentRing(R);
    one:=P!1;
    e:=[P!0 : i in [1..Nvariables(R)]];
    e[i]:=e[i]+one;
    mon:=monomial(R,e);
    return mon;
end intrinsic;

intrinsic '.'(R::RngDiffPol,pair::SeqEnum) -> RngDiffPolMon
{}
    i:=pair[1];
    j:=pair[2];
    P:=exponentRing(R);
    one:=P!1;
    e:=[P!0 : i in [1..Nvariables(R)]];
    e[i]:=e[i]+P.1^j;
    mon:=monomial(R,e);
    return mon;
end intrinsic;

intrinsic Print(m1::RngDiffPolMon)
{}
    outputs:=[];
    R:=Parent(m1);
    es:=exponent(m1);
    n:=Nvariables(R);
    vs:=variableNames(R);
    
    factors:=[];
    if isOne(m1) then
        printf "1";
    else
        for i in [1..n] do
            for t in Terms(es[i]) do
                m:=Coefficients(t)[1];
                ord:=Degree(t);
                if ord eq 0 and m eq 1 then
                    Append(~factors,Sprintf("%o",vs[i]));
                elif ord eq 0 and m gt 1 then
                    Append(~factors,Sprintf("%o^%o",vs[i],m));
                elif ord gt 0 and m eq 1 then
                    Append(~factors,Sprintf("D^%o(%o)",ord,vs[i]));
                elif ord gt 0 and m gt 1 then
                    Append(~factors,Sprintf("D^%o(%o)^%o",ord,vs[i],m));
                end if;
            end for;
        end for;

        vprintf RngDiffPol, 4: "factors %o \n", factors;
        
        if #factors gt 0 then
            output:=factors[1];
            for i in [2..#factors] do
                output:=output * "*" * factors[i];
            end for;
        else
            output:="";
        end if;

        printf output;
    end if;
end intrinsic;

intrinsic Print(f::RngDiffPolTerm)
{}
    if isOne(f) then
        printf "1";
    elif isConstant(f) then
        printf "%o",coeff(f);
    elif coeff(f) eq 1 then
        printf "%o",monomial(f);
    else
        printf "%o*%o", coeff(f),monomial(f);
    end if;
end intrinsic;

intrinsic Print(f::RngDiffPolElt)
{}
    if isZero(f) then
        printf "0";
    else
        terms:=[t : t in terms(f)];
        //Sort(~terms);
        printed_terms:=[Sprint(t): t in terms];
        output:=printed_terms[1];
        for i in [2..#terms] do
            output:=output * " + " * printed_terms[i];
        end for;
        printf output;
    end if;
end intrinsic;



//##################################################
//##################################################
//  TERM ORDERS
//##################################################
//##################################################

/*
https://magma.maths.usyd.edu.au/magma/handbook/text/118#981

Sort(S) : SeqEnum -> SeqEnum

Given a complete enumerated sequence S whose terms belong to a structure on which lt and eq are defined, create the enumerated sequence formed by (quick-)sorting the terms of S into increasing order.
There are two versions of this: a procedure, where S is replaced by the new sequence, and a function, which returns the new sequence. The procedural version takes a reference ~S to S as an argument.

Note that the procedural version is much more efficient since the sequence S will not be copied.

*/


/*
Something is wrong with the sorting... I tried playing with the universes and all sorts of coercion but that doesn't seem to work so I'm making my own sorting function for monomials which is a hack that bypasses the types.
*/





intrinsic termOrderComparator(m1::RngDiffPolMon,m2::RngDiffPolMon)->RngIntElt
{}
    require Parent(m1) eq Parent(m2): "The parents must be the same";
    R:=Parent(m1);
    
    if m1 eq one(R) then
        return -1;
    else
        tup:=R`term_order;
        order_type:=tup[1];
        require order_type eq "rank": "only lexicographic term orderings subject to a ranking are implemented";
        rank_intrinsic:=tup[2];
        ranking:=func<m1,m2|rank_intrinsic(m1,m2)>;
        
        seq1:=Eltseq_m(m1);
        seq2:=Eltseq_m(m2);
        my_dict:=AssociativeArray();
        keys:=[k : k in ({ s[1]: s in seq1} join {s[1]: s in seq2})];
        dict1:=AssociativeArray();
        dict2:=AssociativeArray();

        for s in seq1 do
            dict1[s[1]]:=s[2];
        end for;

        for k in [k : k in keys | not k in Keys(dict1)] do
            dict1[k]:=0;
        end for;

        for s in seq2 do
            dict2[s[1]]:=s[2];
        end for;

        for k in [k : k in keys | not k in Keys(dict2)] do
            dict2[k]:=0;
        end for;
        
        Sort(~keys,ranking);
        
        lex_vec:=Vector([dict1[k]-dict2[k] : k in keys]);
        trivial_vec:=Vector([0 : k in keys]);
        return lexVectorComparison(lex_vec,trivial_vec);
    end if;
end intrinsic;


////////////////////////////////////
intrinsic 'lt'(f1::RngDiffPolMon,f2::RngDiffPolMon)->BoolElt
///////////////////////////////////
{}
    return termOrderComparator(f1,f2) lt 0;
end intrinsic;

////////////////////////////////////
intrinsic 'le'(f1::RngDiffPolMon,f2::RngDiffPolMon)->BoolElt
///////////////////////////////////
{}
    return termOrderComparator(f1,f2) le 0;
end intrinsic;

////////////////////////////////////
intrinsic 'gt'(f1::RngDiffPolMon,f2::RngDiffPolMon)->BoolElt
///////////////////////////////////
{}
    return termOrderComparator(f1,f2) gt 0;
end intrinsic;

////////////////////////////////////
intrinsic 'ge'(f1::RngDiffPolMon,f2::RngDiffPolMon)->BoolElt
///////////////////////////////////
{}
    return termOrderComparator(f1,f2) ge 0;
end intrinsic;

//------------------------

