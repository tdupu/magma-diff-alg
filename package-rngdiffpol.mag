//##################################################
//  Leading Monomials/Leaders/Separants
//##################################################

intrinsic orders(m::RngDiffPolMon)->SeqEnum
{}
    return [Degree(p) : p in exponent(m)];
end intrinsic;

intrinsic order(m::RngDiffPolMon)->RngIntElt,RngIntElt
{}
    return Maximum(orders(m));
end intrinsic;

intrinsic orders(f::RngDiffPolElt)->SeqEnum
{Get the sequences of orders of differential polynomials with respect to each of the variables.}
    R:=Parent(f);
    ords:=[orders(monomial(t)) : t in terms(f)];
    return [Maximum([ord[j] : ord in ords]): j in [1..Nvariables(R)]];
end intrinsic;

intrinsic order(f::RngDiffPolElt)->SeqEnum
{Get the maximum order of a derivative appearing in a differential polynomial.}
    return Maximum(orders(f));
end intrinsic;

/////////////////////////////
intrinsic sortedTerms(dpoly::RngDiffPolElt)->SetEnum[RngDiffPolTerm]
/////////////////////////////
{}
    my_comparison:=func<x,y|termOrderComparator(monomial(x),monomial(y))>;
    return mySort([t: t in terms(dpoly)],my_comparison);
end intrinsic;

/////////////////////////////
intrinsic sorted(seq::SeqEnum)->SeqEnum
/////////////////////////////
{Given a sequence RngDiffPolTerm sort them according to their term ordering}
    //require &and[Type(x) eq RngDiffPolTerm : x in seq]: "Input not a sequence of terms";
    my_comparison:=func<x,y|termOrderComparator(leadingMonomial(x),leadingMonomial(y))>;
    return mySort(seq,my_comparison);
end intrinsic;


/////////////////////////////
intrinsic leadingTerm(f::RngDiffPolElt)->RngDiffPolTerm
/////////////////////////////
{}
    s:=sortedTerms(f);
    return s[#s];
end intrinsic;

/////////////////////////////
intrinsic leadingTerm(f::RngDiffPolTerm)->RngDiffPolTerm
/////////////////////////////
{}
    return f;
end intrinsic;

/////////////////////////////
intrinsic leadingTerm(f::RngDiffPolMon)->RngDiffPolTerm
/////////////////////////////
{}
    return term(f);
end intrinsic;

/////////////////////////////
intrinsic leadingMonomial(f::RngDiffPolElt)->RngDiffPolMon
/////////////////////////////
{}
    return monomial(leadingTerm(f));
end intrinsic;

/////////////////////////////
intrinsic leadingMonomial(f::RngDiffPolTerm)->RngDiffPolMon
/////////////////////////////
{}
    return monomial(f);
end intrinsic;

/////////////////////////////
intrinsic leadingMonomial(f::RngDiffPolMon)->RngDiffPolMon
/////////////////////////////
{}
    return f;
end intrinsic;


/////////////////////////////
intrinsic leader(f::RngDiffPolElt)->RngDiffPolMon
/////////////////////////////
{}
    m:=leadingMonomial(f);
    s:=sorted([monomial(Parent(m),[<s[1],1>]) : s in Eltseq_m(m)]);
    return s[#s];
end intrinsic;

/////////////////////////////
intrinsic leadingVariable(f::RngDiffPolElt)->RngDiffPolMon
/////////////////////////////
{}
    R:=Parent(f);
    return R.Eltseq_m(leader(f))[1][1][1];
end intrinsic;

/////////////////////////////
intrinsic factor(m::RngDiffPolMon)->SeqEnum
/////////////////////////////
{Factor a monomial into a product of its variables}
    return [ <monomial(Parent(m),[<s[1],1>]),s[2]> : s in Eltseq_m(m)];
end intrinsic;


/////////////////////////////
intrinsic valuation(m::RngDiffPolMon,u::RngDiffPolMon)->RngIntElt
/////////////////////////////
{}
    for f in factor(m) do
        if f[1] eq u then
            return f[2];
        end if;
    end for;

    return 0;
end intrinsic;

/////////////////////////////
intrinsic valuation(t::RngDiffPolTerm,u::RngDiffPolMon)->RngIntElt
/////////////////////////////
{}
    return valuation(monomial(t),u);
end intrinsic;

/////////////////////////////
intrinsic valuation(f::RngDiffPolElt,u::RngDiffPolMon)->RngIntElt
/////////////////////////////
{}
    return Min([valuation(m,u) : m in monomials(f)]);
end intrinsic;


/////////////////////////////
intrinsic '/'(m1::RngDiffPolMon,m2::RngDiffPolMon)->RngDiffPolMon
/////////////////////////////
{}
    require Parent(m1) eq Parent(m2):"elements must have the same parent";
    e:=Eltseq(Vector(exponent(m1))-Vector(exponent(m2)));
    require &and[a ge 0 : a in e]: "Not an integral division";
    R:=Parent(m1);
    return monomial(R,e);
end intrinsic;

/////////////////////////////
intrinsic '/'(t1::RngDiffPolTerm,u::RngDiffPolMon)->RngDiffPolMon
/////////////////////////////
{}
    return coefficient(t1)*(monomial(t1)/u);
end intrinsic;

/////////////////////////////
intrinsic divides(m2::RngDiffPolMon,m1::RngDiffPolMon)->BoolElt
/////////////////////////////
{}
    require Parent(m1) eq Parent(m2):"elements must have the same parent";
    e:=Eltseq(Vector(exponent(m1))-Vector(exponent(m2)));
    return &and[a ge 0 : a in e];
end intrinsic;

/////////////////////////////
intrinsic gcd(m2::RngDiffPolMon,m1::RngDiffPolMon)->RngDiffPolMon
/////////////////////////////
{}
    R:=Parent(m1);
    require R eq Parent(m2):"Monomials not in same ring";
    E:=exponentRing(R);
    d:=E.1;
    ff:=exponent(m1);
    gg:=exponent(m2);
    
    function gcd_poly(f,g)
        m:=Max([Degree(f),Degree(g)]);

        function taylor_coeffs(f)
            return [Integers()!Evaluate(Derivative(f,n,d),[0])/Factorial(n) : n in [0..m]];
        end function;

        coeffs:=[Integers()!Min(taylor_coeffs(f)[i],taylor_coeffs(g)[i]) : i in [1..m+1]];
        return &+[coeffs[i]*d^(i-1) : i in [1..m+1]];
    end function;
    
    len:=#ff;
    new_e:=[gcd_poly(ff[i],gg[i]) : i in [1..len]];
    
    return monomial(R,new_e);
    
end intrinsic;

/*
lcm(m1,m2)=m1*m2/gcd(m1,m2);

*/

intrinsic derivative(f::RngDiffPolElt,u::RngDiffPolMon)->RngDiffPolElt
{Computer the partial derivative with respect to a variable.}
    der:=0;
    for t in terms(f) do
        n:=valuation(t,u);
        if n gt 0 then
           der:=der+n*(t/u^n)*(u)^(n-1);
        end if;
    end for;
    
    return der;
end intrinsic;

intrinsic derivative(f::RngDiffPolElt,n::RngIntElt,u::RngDiffPolMon)->RngDiffPolElt
{Computer the partial derivative with respect to a variable n-times.}
    require n ge 0: "must take a non-negative number of partial derivatives.";
    if n eq 0 then
        return f;
    elif n eq 1 then
        return derivative(f,u);
    elif n gt 1 then
        return derivative(derivative(f,u),n-1,u);
    end if;
end intrinsic;

intrinsic separant(f::RngDiffPolElt)->RngDiffPolElt
{Take the partial derivative of f with respect to its leader.}
    u:=leader(f);
    return derivative(f,u);
end intrinsic;


intrinsic Eltseq_m(mon:RngPolDiffMon)->SeqEnum
{}
/*
We want all the element sequences to be the same to the user.
These element sequences for Rngare going to be special.
*/

    e:=exponent(mon);
    n:=Nvariables(Parent(mon));
    
    vprintf RngDiffPol, 4: "%o", mon;
    
    if e eq [0 : i in [1..n]] then
        return [<[1,0],0>];
    else
        return &cat[[<[i,Degree(t)],Coefficients(t)[1]> : t in Terms(e[i])] : i in [1..n]];
    end if;
end intrinsic;

intrinsic Eltseq(f::RngDiffPolElt)->SeqEnum
{}
    if f eq Parent(f)!0 then
        return [];
    else
        return [ <coeff(t),Eltseq_m(monomial(t))> : t in terms(f)];
    end if;
end intrinsic;

intrinsic Eltseq(f::RngDiffPolMon)->SeqEnum
{}
    return Eltseq(differentialPolynomial(f));
end intrinsic;

intrinsic Eltseq(f::RngDiffPolTerm)->SeqEnum
{}
    return Eltseq(differentialPolynomial(f));
end intrinsic;

/////////////////////////////
intrinsic orders(mon::RngDiffPolMon)->SeqEnum
/////////////////////////////
{}
    e:=exponent(mon);
    return [Degree(x) : x in e];
end intrinsic;

//##################################################
//##################################################
//  POLYNOMIAL ALGORITHMS
//##################################################
//##################################################

//###########################
intrinsic get_block_map(blocks::SeqEnum)->UserProgram
//###########################
{}
/*
    
    EXAMPLES:
    
        >blocks:=[[3,2],[1,5],[4]];
        >my_rank:=get_ranking(blocks);
        >my_rank([1,2],[3,2]);
        >my_rank([3,1],[2,1]);
        >my_rank([2,2],[2,1]);
        >my_rank([4,5],[2,1]);
        -1
        2
        1
        -2

*/
    
    function block_map(n,blocks)
    //The comparison function C must take two arguments and return an integer less than,
    //equal to, or greater than 0 according to whether the first argument is less than,
    //equal to, or greater than the second argument (e.g.: func<x, y | x - y>).
        for i in [1..#blocks] do
            if n in blocks[i] then
                return i;
            end if;
        end for;
    end function;
    
    block_map_red:=func<n|block_map(n,blocks)>;
    
    return block_map_red;
    
end intrinsic;

//###########################
intrinsic get_ranking(blocks::SeqEnum)->UserProgram
//###########################
{}
/*
    
    EXAMPLES:
    
        >blocks:=[[3,2],[1,5],[4]];
        >my_rank:=get_ranking(blocks);
        
    The variable is in a later block:
        
        >my_rank([1,2],[3,2]);
        -1
    
    Same block, same order but 3 comes before 2.
        
        >my_rank([3,1],[2,1]);
        2
        
    Same variable but higher order is higher rank.
        
        >my_rank([2,2],[2,1]);
        1
        
    No matter how big you take the derivative, if it is
    in a lower block it will be eliminated.
        >my_rank([4,5],[2,1]);
        -2

*/
    flattened:=&cat[b:b in blocks];
    num_vars:=#flattened;
    
    if not Sort(flattened) eq [1..num_vars] then
        printf "A complete set of numbers needs to appear in the blocks.";
        return 0;
    end if;
    
    
    G:=Sym(#flattened);
    sigma:=G!flattened;
    tau:=sigma^(-1);
    
    block_map:=get_block_map(blocks);
    
    function block_rank(pair1,pair2)
    //The comparison function C must take two arguments and return an integer less than,
    //equal to, or greater than 0 according to whether the first argument is less than,
    //equal to, or greater than the second argument (e.g.: func<x, y | x - y>).
    /*
    If the variable appears in an early block it wins.
    If they are in the same block, use lexicographic rank.
    */
        i1:=pair1[1];
        j1:=pair1[2];
        i2:=pair2[1];
        j2:=pair2[2];
        
        b1:=block_map(i1);
        b2:=block_map(i2);
        
        //ans:=0;
        
        if b1 ne b2 then
            ans:=b2-b1;
        elif b1 eq b2 then
            ii1:=i1^tau;
            ii2:=j1^tau;
            ans:=-rank_lex([ii1,j1],[ii2,j2]);
        end if;
        
        return ans;
        
    end function;
        
    return block_rank;
end intrinsic;

////////////////////////////////////
intrinsic termOrder(R::RngDiffPol)->Tup
////////////////////////////////////
{}
    return R`term_order;
end intrinsic;

////////////////////////////////////
intrinsic NTraceVariables(R::RngDiffPol,r::RngIntElt)->RngIntElt
////////////////////////////////////
{}
    return (r+1)*Nvariables(R);
end intrinsic;


///////////////////////////////////////
intrinsic traceWeights(R::RngDiffPol,r::RngIntElt)->SeqEnum
///////////////////////////////////////
{}
    /*
    Order the monomials and then figure out which variable they correspond to.
    If lex, then you just put the standard basis vectors in rows corresponding to their order.
    If block, then you need to do one block at a time as in the example below:
    
    <"elim", [ 1, 4 ], [ 2, 3 ]>
    > MonomialOrderWeightVectors(P);

    [ 1, 0, 0, 1 ],
    [ 1, 0, 0, 0 ],
    [ 0, 1, 1, 0 ],
    [ 0, 1, 0, 0 ]
    
    We will have much larger blocks though.
    First there will be max_order[1]+1 variables corresp to x1 and its ders.
    Second there will be max_order[2]+1 variables corresp to x2 and its ders.
    ...
    If we have a block order [[3],[1],[2,4]] then this corresponds to a block order
    [ [3,n3],...,[3,0] ], [ [1,n1],...,[1,0] ], [ [2,j],[4,j] ] ordered according to j first then according to 2]
    */
    N:=NTraceVariables(R,r);
    
    tup:=termOrder(R);
    label:=tup[1];
    data:=tup[2];
    
    if label eq "elim" then
        dblocks:=data;
        blocks:=dblocks_to_blocks(R,dblocks);
        return MonomialOrderWeightVectors(<"elim",Explode(blocks)>);
    elif label eq "rank" then
        seq:=[traceIndex(R,pair) : pair in rankingSeq(R,r)];
        A:=FreeAbelianGroup(#seq);
        W:=[Eltseq(A.seq[i]) : i in [1..#seq]];
        return W;
    end if;
end intrinsic;


////////////////////////////////////
intrinsic dblocks_to_blocks(R::RngDiffPol,r::RngIntElt,dblocks::SeqEnum)->SeqEnum
////////////////////////////////////
{}

/*
dblocks:=[ [1,2],[3,4] ];
dblocks:=[ [1,2,3,4]]; //pure orderly lexicographic
dblocks:=[[1],[2],[3],[4]]; //pure elimination
*/
    return [ &cat[ Reverse([ traceIndex(R,[i,j]) : j in [0..r] ]) : i in dblock] : dblock in dblocks];
end intrinsic;

////////////////////////////////////
intrinsic traceIndex(R::RngDiffPol,pair::SeqEnum[RngIntElt])->RngIntElt
////////////////////////////////////
{
Given a pair [i,j] corresponding to D^i(x_j) compute the index of that variable in the sequence of all of these.
}

/*
If the maximum orders are r(1),r(2),...,r(n) with n-variables, then
    index of [i,r]= (r(1)+1)+(r(2)+1)+...+(r(i-1)+1)+r+1
    
*/

    i,r:=Explode(pair);
    
    A:=r*(i-1);
    B:=(Nvariables(R)-i)-1;
    C:=r;
    
    return A+B+C;
    
end intrinsic;

////////////////////////////////////
intrinsic traceTermOrder(R::RngDiffPol,r::RngIntElt)->RngPol
////////////////////////////////////
{}
    //http://magma.maths.usyd.edu.au/magma/handbook/text/1259#14366
    // PolynomialRing(Z, 4, "elim", [1, 4], [2, 3])
    //<"weight", [ 100, 10, 1, 1, 10, 100, 1, 1, 1 ]>
    return <"weight",traceWeights(R,r)>;
end intrinsic;

////////////////////////////////////
intrinsic ranking(R::RngDiffPol)->UserProgram
////////////////////////////////////
{
    
}
    //---printing---
    vprintf RngDiffPol, 5: "Requesting the ranking of the ring of differential polynomials... \n";
    
    term_order:=termOrder(R);
    label:=term_order[1];
    
    if label eq "rank" then
        if Type(term_order[2]) eq UserProgram then
            //do nothing
        elif Type(term_order[2]) eq SeqEnum then
            //---printing---
            vprintf RngDiffPol, 5: "Setting the ranking from dblocks... \n";
            dblocks:=term_order[2];
            setRanking(R, dblocks);
        end if;
    else
        error "The term order is not induced by a rank. The first part of the term_order tuple needs to be 'rank' (in quotes) and the second part needs to be a comparison function.";
    end if;
    
    rank_comparison:=termOrder(R)[2];
    //---printing---
    vprintf RngDiffPol, 5: "Returning the ranking... \n";
    return rank_comparison;
    
end intrinsic;


////////////////////////////////////
intrinsic setRanking(R::RngDiffPol, comparison::UserProgram)
////////////////////////////////////
{
Set the term order to one for ranking for a given user program.
}
   R`term_order:=<"rank",comparison>;
   
end intrinsic;

////////////////////////////////////
intrinsic setRanking(R::RngDiffPol,dblocks::SeqEnum)
////////////////////////////////////
{
Given blocks defining a ranking set the ranking of R to the term order.
}
   setRanking(R,get_ranking(dblocks));

end intrinsic;


////////////////////////////////////
intrinsic rankingSeq(R::RngDiffPol,r::RngIntElt)->SeqEnum
////////////////////////////////////
{
The element [i,j] corresonds to R.[i,j] and it returns them in order.
The element of lowest index will be of highest order.
}
    all_indices:=[];
    for i in [1..Nvariables(R)] do
        for j in [0..r] do
            Append(~all_indices,[i,j]);
        end for;
    end for;

    Sort(~all_indices,ranking(R));
    return all_indices;
    
end intrinsic;


/////////////////////////////
intrinsic traceGenerators(R::RngDiffPol,r::RngIntElt)->SeqEnum
/////////////////////////////
{}
    n:=Nvariables(R);
    monomials:=[];
    for i in [1..n] do
        for j in [1..r] do
            Append(~monomials,Diff(R.i,n));
        end for;
    end for;
    monomials:=sorted(monomials);
    
    return monomials;
end intrinsic;

/////////////////////////////
intrinsic trace(R::RngDiffPol,r::RngIntElt)->RngMPol
/////////////////////////////
{}
    monomials:=traceGenerators(R,r);
    rthJetRing:=PolynomialRing(baseRing(R),#monomials:order:=traceTermOrder(R,r));
    return rthJetRing;
    
end intrinsic;


/////////////////////////////
intrinsic trace(mon::RngDiffPolMon,r::RngIntElt)->RngMPolElt
/////////////////////////////
{}
    require order(mon) le r: "The differential polynomial order exceeds the trace order";
    R:=Parent(mon);
    P:=trace(R,r);
    
    powers:=[];
    for x in Eltseq_m(mon) do
        pair:=x[1];
        power:=x[2];
        i:=Index(rankingSeq(R,r),pair);
        Append(~powers,(P.i)^power);
    end for;

    return &*powers;
end intrinsic;


/////////////////////////////
intrinsic trace(t1::RngDiffPolTerm,r::RngIntElt)->RngMPolElt
/////////////////////////////
{}
    R:=Parent(t1);
    return coefficient(t1)*trace(monomial(t1),r);

end intrinsic;

/////////////////////////////
intrinsic trace(dpoly::RngDiffPolElt,r::RngIntElt)->RngDiffPolElt
/////////////////////////////
{}
    R:=Parent(dpoly);
    return R!0;
end intrinsic;


