/*
    Taylor Dupuy, Spring 2025
    taylor.dupuy@gmail.com

    Our algorithm is modeled after:

    François Boulier, Daniel Lazard, François Ollivier, Michel Petitot. Representation for the radical of a finitely generated differential ideal. international symposium on Symbolic and algebraic computation 1995, Jul 1995, France. pp.158-166, 10.1145/220346.220367 . hal-00138020v2
    https://hal.science/hal-00138020/document
    Page 162.
    
    This paper has many great theoretical results as well as a great implementation. Some of them are more spelled out in the Humbert paper below.
    
    Hubert, Factorization-free Decomposition Algorithms in Differential Algebra
    J. Symbolic Computation (2000) 29, 641–662 doi:10.1006/jsco.1999.0344

    There is a worse presentation in a new paper here.s

    Boulier,Lazard,Ollivier,Petitot
    Computing representations for radicals of finitely generated differential ideals
    AAECC (2009) 20:73–121
    FIGURE 1, page 96
    
    Oleg Golubitsky,Marina Kondratieva, Marc Moreno Maza, Alexey Ovchinnikov, Bounds for algorithms in differential algebra https://arxiv.org/pdf/math/0702470
    Algorithm 1.
    
    

    
*/

declare verbose RittDivision, 6;

/*
#########################
#########################
Evaluation and Specialization
#########################
#########################
*/

/*
To evaluate a differential polynomial f of order r at phi1,...,phin
we take derivatives of the phi_j up to order r and then plug them into
f as a polynomial.

If f is a differential polynomial with coefficients in a polynomial ring
with a constant derivation then we Specialize(f,my_seq) applies
Evaluate(my_coeff,my_seq) to all of the coefficeints.

The assumption here is the Jet(Parent(f),-1) is a polynomial ring.
The output will be in a new RngMPolProlSeq.

If f is a differential polynomial with coefficients also differential polynomials
then we use Specialize(f,my_seq) runs Evaluate(my_coeff,my_set) on each
of the coefficients.

Note that in the case where the base ring is a differential ring
not every specialization will be a homomorphism. That is, the specialization
of a differential expression will not necessarily be the specialization of a
simplified differential expression.
*/

////////////////////
intrinsic Jet(f::RngMPolProlSeqElt, r::RngIntElt)->RngMPolElt
////////////////////
{Return the corresponding element of the rth jet space.}
    r0:=Order(f);
    require r ge r0: "Cannot map to a lower order jet space than the order of the element";
    P:=Parent(f);
    elt:=(P!Eltseq(f))`elt;
    assert( elt in Jet(P,r0));
    incl:=map(P,r0,r);
    return incl(elt);
end intrinsic;

////////////////////
intrinsic Jet(f::RngMPolProlSeqElt)->RngMPolElt
////////////////////
{Return the corresponding element of the appropriate jet space.}
    return (Parent(f)!Eltseq(f))`elt;
end intrinsic;

////////////////////
intrinsic Jet(F::SeqEnum[RngMPolProlSeqElt],r::RngIntElt)->SeqEnum[RngMPolElt]
////////////////////
{Return the corresponding elements of the appropriate jet space.}
    return [Jet(f,r) : f in F];
end intrinsic;

////////////////////
intrinsic Exp(seq::SeqEnum[RngMPolProlSeqElt],r0::RngIntElt)->SeqEnum[RngMPolProlSeqElt]
////////////////////
{Given a sequence of prolongation sequence elements, take the derivatives of each of them up to order r0 and concatenate them into their standard sequence.}
    expseq:=&cat[[ Diff(s,j) : s in seq] : j in [0..r0]];
    return expseq;
end intrinsic;

////////////////////
intrinsic
 Evaluate(f::RngMPolProlSeqElt,seq::SeqEnum[RngMPolProlSeqElt])->RngMPolProlSeqElt
 ////////////////////
{Plug in elements of a sequence into the prolongation sequence element.}
    P1:=Parent(f);
    n1:=Ngens(P1);
    r1:=Order(f);
    ft:=Jet(f,r1);
    
    Ps:={Parent(s) : s in seq};
    require n1 eq #seq: "The sequence must be the number of generators";
    require #Ps eq 1: "All the elements of the sequence must have the same parent";
    P2:=[P : P in Ps][1];
    
    exp_seq:=Exp(seq,r1);
    r2:=Maximum([Order(s) : s in exp_seq]);
    exp_seq_tr:=[Jet(f,r2) : f in exp_seq];
    return P2!Evaluate(ft,exp_seq_tr);

end intrinsic;

////////////////////
intrinsic Specialize(f::RngMPolProlSeqElt,seq1::SeqEnum)->RngMPolProlSeqElt
////////////////////
{Given a f whose coefficients admit and Evaluate function for the coefficients.}
    return &+[ Parent(f)![<Evaluate(t[1],seq1),t[2]>] : t in Eltseq(f)];
end intrinsic;

/*
#########################
#########################
PseudoDivision
#########################
#########################
*/

////////////////////
intrinsic PseudoDivideStep(f::RngMPolElt,g::RngMPolElt,u::RngMPolElt)->RngMPolElt,RngMPolElt,RngMPolElt
////////////////////
{
Given f and g and a variable u return quo, rem, and sep such that sep*f-quo*g eq rem with the degree of rem lower that the degree of g by one.
}
require Parent(f) eq Parent(g): "The two elements must have the same parents";
require Degree(u) eq 1: "u must be an element of degree one.";

    df:=Degree(f,u);
    dg:=Degree(g,u);

    if dg gt df then
        sep:=1;
        rem:=f;
        quo:=0;
        return Parent(f)!quo,Parent(f)!rem,Parent(f)!sep;
    else
        n:=df-dg;
        lcf:=Coefficients(f,u)[df+1];
        lcg:=Coefficients(g,u)[dg+1];
        lcm:=LeastCommonMultiple(lcg,lcf);
        a:=Parent(f)!lcm/lcf;
        b:=Parent(f)!lcm/lcg;
        rem:=a*f-b*u^n*g;
        quo:=b*u^n;
        sep:=a;
        return Parent(f)!quo,Parent(f)!rem,Parent(f)!sep;
    end if;
end intrinsic;


////////////////////
intrinsic PseudoDivide(f::RngMPolElt,g::RngMPolElt,u::RngMPolElt)->RngMPolElt,RngMPolElt,RngMPolElt
////////////////////
{
Given f and g and a variable u return quo, rem, and sep such that sep*f-quo*g eq rem and the degree of the remainder is less than the degree of g.
}

    quo:=0;
    rem0:=f;
    sep:=1;
    
    //had to add this corner case
    if IsUnit(f) then
        return Parent(f)!quo,Parent(f)!rem0,Parent(f)!sep;
    elif IsUnit(g) then
        return f/g,Parent(f)!0,Parent(f)!1;
    end if;
    
    while Degree(rem0,u) ge Degree(g,u) do
        quo0,rem0,sep0:=PseudoDivideStep(rem0,g,u);
        sep:=sep*sep0;
        quo:=sep0*quo+quo0;
    end while;
    
    rem:=rem0;
    
    Quo:=Parent(f)!quo;
    Rem:=Parent(f)!rem;
    Sep:=Parent(f)!sep;
    
    assert Sep*f eq Quo*g+Rem;
    
    return Quo,Rem,Sep;
end intrinsic;

////////////////////
intrinsic Leader(f::RngMPolElt)->RngMPolElt,RngIntElt
////////////////////
{For a polynomial f in a ring R with a lexicographic order, in the leading monomial, take the variable u that is higher and the term order and its degree.}
    if MonomialOrder(Parent(f))[1] ne "lex" then
        print "WARNING: taking a leader in a term order that is not clearly lexicographic. \n";
    end if;
    u:=LeadingMonomial(&+[m[1] : m in Factorization(LeadingMonomial(f))]);
    return u,Degree(f,u);
end intrinsic;

////////////////////
intrinsic TopCoeff(F::RngMPolElt,u::RngMPolElt)->RngMPolElt
////////////////////
{The is the top coefficient of F when written as a polynmial in u}
    coeffs:=Coefficients(F,u);
    return coeffs[#coeffs];
end intrinsic;

////////////////////
intrinsic Initial(F::RngMPolElt)->RngMPolElt
////////////////////
{The top coefficient of F when written in a polynomial in the leader.}
    return TopCoeff(F,Leader(F));
end intrinsic;

////////////////////
intrinsic IsPseudoReduced(f::RngMPolElt,g::RngMPolElt,u::RngMPolElt)->BoolElt
////////////////////
{
Determine if deg(f,u)>deg(g,u);
}
    return Degree(f,u) lt Degree(g,u);
end intrinsic;

////////////////////
intrinsic IsPseudoReduced(f::RngMPolElt,g::RngMPolElt)->BoolElt
////////////////////
{
Determine if deg(f,u)>deg(g,u) where u is the leader of g.
}
    return IsPseudoReduced(f,g,Leader(g));
end intrinsic;

////////////////////
intrinsic IsPseudoReduced(f::RngMPolElt,G::SeqEnum[RngMPolElt])->BoolElt
////////////////////
{
Determine if deg(f,u)>deg(g,u) where u is the leader of g for all g in G.
}
    return &and[IsPseudoReduced(f,g) : g in G];
end intrinsic;

////////////////////
intrinsic IsTriangularNoSort(G::SeqEnum[RngMPolElt])->BoolElt
////////////////////
{
Determine if a set of element is triangular.
}
    require #G gt 0: "Must have a non-negative number of elements"; //this can be relaxed.
    
    if #G eq 1 then
        return true;
    elif #G eq 2 then
        return IsPseudoReduced(G[2],G[1]);
    else
        return &and[IsPseudoReduced(g,G[1]) : g in G[2..#G]] and IsTriangularNoSort(G[2..#G]);
    end if;
end intrinsic;

////////////////////
intrinsic IsTriangular(G::SeqEnum[RngMPolElt])->BoolElt
////////////////////
{
Determine if a set of polynomials in a ring with lexicographic order is triangular.
}
    G0:=Sort([g : g in G]);
    return IsTriangularNoSort(G0);
end intrinsic;


////////////////////
intrinsic PseudoDivide(f::RngMPolElt,g::RngMPolElt)->RngMPolElt,RngMPolElt,RngMPolElt
////////////////////
{
Given f and g and a variable u return quo, rem, and sep such that sep*f-quo*g eq rem and the degree of the remainder is less than the degree of g.
}
    return PseudoDivide(f,g,Leader(g));
end intrinsic;

////////////////////
intrinsic PseudoDivide(f::RngMPolElt,G::SeqEnum[RngMPolElt])->SeqEnum[RngMPolElt],RngMPolElt,RngMPolElt
////////////////////
{Perform Pseudodivision with respect to a triangular set. This is done recurrsively starting from the bottom part of the triangular set.}
    require IsTriangularNoSort(G): "Must pseudodivide with respect to a sorted triangular sequence.";
    assert #G gt 0;
    if #G eq 1 then
        quo0,rem0,sep0:=PseudoDivide(f,G[1]);
        Quo:=[quo0];
        Rem:=rem0;
        Sep:=sep0;
    else
        G0:=G[2..#G]; //start with the largest element
        quo0,rem0,sep0:=PseudoDivide(f,G0);
        assert sep0*f eq &+[quo0[i]*G0[i] : i in [1..#G0]]+rem0;
        quo1,rem1,sep1:=PseudoDivide(rem0,G[1]);
        assert sep1*rem0 eq quo1*G[1]+rem1;
        
        Quo:=[quo1] cat [sep1*q: q in quo0];
        Rem:=rem1;
        Sep:=sep0*sep1;
    end if;
    
    require IsPseudoReduced(Rem,G): "The output is not pseudoreduced with respect to G";
    //require (Sep*f eq  &+[Quo[i]*G[i]: i in [1..#G]] + Rem): "Sep*f eq \sum Quo[i] G[i] + Rem failed.";
    return Quo,Rem,Sep;
    
end intrinsic;

////////////////////
intrinsic PseudoRemainder(f::RngMPolElt,G::SeqEnum[RngMPolElt])->RngMPolElt
////////////////////
{Perform Pseudodivision with respect to a triangular set then take the remainder.}
    require IsTriangularNoSort(G): "Must pseudodivide with respect to a sorted triangular sequence.";
    Quo,Rem,Sep:=PseudoDivide(f,G);
    return Rem;
end intrinsic;

/*
Macaulay2's original characteristic series code was based off of Singular's which was written by a guy called Messollen:
https://macaulay2.com/doc/Macaulay2/share/doc/Macaulay2/Macaulay2Doc/html/_irreducible__Characteristic__Series.html
https://github.com/Macaulay2/M2/blob/master/M2/Macaulay2/m2/factor.m2
https://www.singular.uni-kl.de/Manual/4-0-3/sing_903.htm#SEC959

There they called them triangular sets, which is actually a nicer name. Singular even gives a nice example I'm going to use to check.

 ring R= 0,(x,y,z,u),dp;
  ideal i=-3zu+y2-2x+2,
          -3x2u-4yz-6xz+2y2+3xy,
          -3z2u-xu+y2z+y;
  print(char_series(i));
==> _[1,1],3x2z-y2+2yz,3x2u-3xy-2y2+2yu,
==> x,     -y+2z,      -2y2+3yu-4

I looked up the singular code. That is what I'm going to follow. That is listed here:
D. Wang, Characteristic Sets and Zero Structure of Polynomial Sets (Lecture Notes). Preprint, RISC-Linz, Johannes Kepler University, November 1989 - June 1995.

*/

////////////////////
intrinsic BasicTriangularSet(S0::SeqEnum[RngMPolElt])->SeqEnum[RngMPolElt]
////////////////////
{
Find a singular best triangular set inside polynomials.
Compare this to BestAutoreducedSet.
}
    S:={s : s in S0};
    QS:={s : s in S};
    BS:={};

    while #QS gt 0 do
        b:=Sort([s : s in QS])[1];
        BS:=BS join {b};
        if b in BaseRing(Parent(b)) then
            QS := {};
        else
            QS:= {q : q in QS | q ne b and IsPseudoReduced(q,b)};
        end if;
    end while;

    return Sort([x : x in BS]);
end intrinsic;


////////////////////
intrinsic CharacteristicSet(S::SeqEnum[RngMPolElt])->SeqEnum[RngMPol]
////////////////////
{
Given a sequence of polynomials, produce a characteristic set for a minimal prime ideal containing the ideal generated by S.
}
    QS:=S;
    RS:=QS;
    while #RS gt 0 do
        CS:=BasicTriangularSet(QS);
        if &or[ f in BaseRing(Parent(f)) : f in CS] then
            RS:=[];
        else
            RS:=[x : x in [PseudoRemainder(q,CS): q in QS | not q in CS ]| x ne 0];
            QS:=QS cat RS;
        end if;
        
    end while;
    
    return Sort(CS);
end intrinsic;

////////////////////
intrinsic CharacteristicSeries(S::SeqEnum[RngMPolElt])->SeqEnum[SeqEnum[RngMPol]]
////////////////////
{This is just below Wang's Theorem 4.1.

Lemma 4.2 of Wang's Notes.
Wang, D.: Characteristic Sets and Zero Structure of Polynomial Sets. Lecture Notes, RISC Linz, 1989

I found this is the bowels of singular.
https://www.singular.uni-kl.de/Manual/4-4/sing_1017.htm#SEC1096

Then found a webpage which contained the actual notes.
http://wang.cc4cm.org/manu.html

Lemma (Wu 1984, Ritt 1932)
b eq Red(b,B) then [b] cat B lower than B.
}
    S0:={@ s : s in S@};
    Phi:={@S0@};
    Psi:={@@};
    while #Phi gt 0 do
        QS:=Phi[1];
        Phi:={@x : x in Phi | x ne QS@};
        CS:={@ y : y in CharacteristicSet([x: x in QS]) @};
        if not &or[ f in BaseRing(Parent(f)) : f in CS] then
            //print "Found a characteristic set... %o \n", CS;
            Psi:=Psi join {@ CS @};
            Phi:=Phi join {@ QS join CS join {@Initial(f)@} : f in CS | not f in BaseRing(Parent(f))@};
        end if;
    end while;
    
    return [[x : x in phi] : phi in Psi]; //BUGGED!
end intrinsic;


/*
#########################
#########################
Ritt's Reduction Algorithms
#########################
#########################
*/


////////////////////
intrinsic Degree(f::RngMPolProlSeqElt,u::RngMPolProlSeqElt)->RngIntElt
////////////////////
{
Get the degree of f with respect to u.
}
    f1,u1:=match_orders(f,u);
    return Degree(f1`elt,u1`elt);
end intrinsic;




////////////////////
intrinsic PseudoDivide(f::RngMPolProlSeqElt,g::RngMPolProlSeqElt,u::RngMPolProlSeqElt)->RngMPolProlSeqElt,RngMPolProlSeqElt,RngMPolProlSeqElt
////////////////////
{Given f and g and a variable u return quo, rem, and sep such that sep*f-quo*g eq rem and the degree of the remainder is less than the degree of g.}

    f1,g1:=match_orders(f,g);
    f1,u1:=match_orders(f1,u);
    quo_elt,rem_elt,sep_elt:=PseudoDivide(f1`elt,g1`elt,u1`elt);
    quo:=Parent(f1)!quo_elt;
    rem:=Parent(f1)!rem_elt;
    sep:=Parent(f1)!sep_elt;
    require sep*f-quo*g eq rem: "The test sep*f-quo*g eq rem fails";
    
    return quo, rem, sep;

end intrinsic;

/*
#########################
#########################
Ritt's Algorithm for Reduction
#########################
#########################
*/


intrinsic IsRittReducedPartial(f::RngMPolProlSeqElt,g::RngMPolProlSeqElt)->BoolElt,RngIntElt
{Determine if a proper derivative of the leader of g appears in f.}
    require Parent(f) eq Parent(g): "The parents of f and g must be equal for this question to make sense.";
    
    //corner case first
    if f eq 0 then
        return true, -1;
        
    //real shit
    else
        i,r:=Explode(Support(Leader(g))[1]);
        set_of_ders:={ x[2] : x in Support(f) | x[1] eq i and x[2] ge r};
        
        if #set_of_ders eq 0 then
            return true,-1;
        else
            difference:=Maximum(set_of_ders)-r;
            if difference eq 0 then
                return true,difference;
            else
                return false,difference;
            end if;
        end if;
    end if;
end intrinsic;


////////////////////
intrinsic IsRittReduced(f::RngMPolProlSeqElt,g::RngMPolProlSeqElt :partial:=false)->BoolElt,RngIntElt
////////////////////
{Given two differential polynomials determine if f is reduced by g by seeing if the leader of g or any of its derivatives appear in f. If it does, then return the true and the number of derivatives you need to take. If it doesn't return false and -1.

There is an option `partial` which when set to `true` determines if any non-zero derivative of the leader of of g appears in f.
}
    //corner case first
    if f eq 0 then
        return true,-1;
    
    //real shit
    else
        ritt_reduced_partial,r:=IsRittReducedPartial(f,g);
        if partial eq true then
            return ritt_reduced_partial,r;
        else
            if not ritt_reduced_partial then
                return ritt_reduced_partial,r;
            else
                lg,dg:=Leader(g);
                df:=Degree(f,lg);
                if df ge dg then
                    return false, 0;
                else
                    return true, -1;
                end if;
            end if;
        end if;
        
    end if;
end intrinsic;

////////////////////
intrinsic IsRittReduced(f::RngMPolProlSeqElt,G::SeqEnum[RngMPolProlSeqElt] :partial:=false)->BoolElt
////////////////////
{Checks IsRittReduced over an entire sequence.
There is an option for partially reducing as well.
}
    return &and[IsRittReduced(f,h :partial:=partial) : h in G];
end intrinsic;

////////////////////
intrinsic RittDivideStep(f::RngMPolProlSeqElt,g::RngMPolProlSeqElt)->AlgWeylElt,RngMPolProlSeqElt,RngMPolProlSeqElt
////////////////////
{Return quo, rem, and sep such that sep*f-quo@g eq rem.
The quo will be an element of the associated Weyl algebra.
The full algorithm is Ritt Divide.
}
    P:=Parent(f);
    W<D>:=WeylAlgebra(P);
    is_reduced,num_ders:=IsRittReduced(f,g); //testing of the parents of f and g occurs here.
    if is_reduced then
        quo:=WeylAlgebra(Parent(f))!0;
        rem:=f;
        sep:=Parent(f)!1;
    else
        u:=Diff(Leader(g),num_ders);
        quo0,rem0,sep0:=PseudoDivide(f,Diff(g,num_ders),u);
        quo:=quo0*D^num_ders;
        rem:=rem0;
        sep:=sep0;
    end if;
    
    require sep*f-quo@g eq rem: "The sep*f-quo@g eq rem formula fails";
    return quo, rem, sep;
end intrinsic;

////////////////////
intrinsic RittDivide(f::RngMPolProlSeqElt,g::RngMPolProlSeqElt : partial:=false)->AlgWeylElt,RngMPolProlSeqElt,RngMPolProlSeqElt
////////////////////
{Return quo, rem, and sep such that sep*f-quo@g eq rem and such that rem is RittReduced with respect to g.
The quo will be an element of the associated Weyl algebra.
Single steps of this algorithms are given by RittDivideStep.

The option `partial` being true, will only divide so that nth derivatives of the leader of g appear in f for n>0.
The default of `partial` is false.
}
    P:=Parent(f);
    W<D>:=WeylAlgebra(P);
    f0:=f;
    
    quo:=W!0;
    rem0:=P!f; //the naming kinda sucks
    sep:=P!1;
    
    while not IsRittReduced(f0,g : partial:=partial) do
        quo0,rem0,sep0:=RittDivideStep(f0,g);
        f0:=rem0;
        sep:=sep*sep0;
        quo:=sep0*quo+quo0; //Multiply previous quotient by new separant.
    end while;
        
    rem:=rem0;
    
    //this shouldn't be necessary but I've been having trouble with constants.
    quo:=W!quo;
    rem:=P!rem;
    sep:=P!sep;
    
    //just to be safe
    
    vprintf RittDivision,5: "f = %o \n g = %o \n quo = %o \n rem = %o \n sep = %o \n", f,g,quo,rem,sep;
    
    require sep*f-quo@g eq rem: "The sep*f-quo@g eq rem formula fails";
    
    return quo,rem,sep;
end intrinsic;



/*
Defn.
A sequence is *autoreduced* if every in the sequence is Ritt-reduced with respect to every other element.

We always order sequences according to the their leader and degree.

Defn.
We call this the *rank*.

Defn.
An autoreduced sequence is *better* than another if
    
    1) they have the elements have the same rank up to a point
    then the next element is better than the previous
 or
    2) they are completely matching in terms of rank but
    one is just longer than the other.

Claim.
Given an ordered sequence of differential polynomials we can find one with is maximal
in the sense that there will not exist a better subsequence.

Let S_n be the full set of elements.
Let S_{n-1} be the set which omits the last, S_{n-2} omit the last two, etc.
We will let M_n denote a choice of best autoreduced subsequence of S_{n-1} that is comparable to M_{n-1}.
(It will have the )

Procedure: M_n = (M_{n-1} + last one or not).

The elements of M_n are automatically Ritt-reduced with respect to the last element of S_n.
Hence, we only need to check if the last element is Ritt-reduced S_n with respect to the elements of M_{m-1}.
If it is we add it. If not, we don't.

Claim.
There can't be anything better than this comparable to M_n.

Proof.
If there was, we could consider M_n' cap S_{n-1}.
This means either they are equal up to a point and then M_n' cap S_{n-1} would be better than M_{n-1}, or that M_n' cap S_{n-1} is just longer than M_{n-1}.
Both of these violate the optimality of M_{n-1}.
Hence the only way that M_n' could be better would be to add a new element.
This is exactly our construction.
*/

////////////////////
intrinsic BasicTriangularSet(S::SeqEnum[RngMPolProlSeqElt])->SeqEnum[RngMPolProlSeqElt]
////////////////////
{Given a sequence of differential polynomials, find a subsequence which is autoreduced starting from the bottom.
See Hubert, Decomposition Algorithms in Differential Algebra, J. Symbolic Computation, 2000
This is used in Algorithm 5.1 of loc. cit.
}
    n:=#S;
    if n eq 0 then
        return [];
    elif n eq 1 then
        return [S[n]];
    else
        Ss:=Sorted(S);

        M0:=BasicTriangularSet(Ss[1..n-1]);
        if IsRittReduced(Ss[n],M0) then
            return M0 cat [ Ss[n] ];
        else
            return M0;
        end if;
    end if;
end intrinsic;

////////////////////
intrinsic IsAutoreducedSorted(Gs::SeqEnum[RngMPolProlSeqElt])->BoolElt
////////////////////
{Supposing that Gs is sorted, determine if it is an autoreduced sequence.}
    if #Gs eq 1 then
        return true;
    else
        G0:=Gs[1..#Gs-1];
        if not IsAutoreducedSorted(G0) then
            return false;
        else
            gn:=Gs[#Gs];
            return IsRittReduced(gn,G0);
        end if;
    end if;
end intrinsic;

////////////////////
intrinsic IsAutoreduced(G::SeqEnum[RngMPolProlSeqElt])->BoolElt
////////////////////
{
Determine if a sequence of polynomial elements is autoreduced.
This in particular implies that it is sorted.
IsAutoreducedSorted is doing the work for this function.
}
    Gs:=Sorted(G);
    return IsAutoreducedSorted(Gs) and G eq Gs;
end intrinsic;



////////////////////
intrinsic RittDivide(f::RngMPolProlSeqElt,G::SeqEnum[RngMPolProlSeqElt] : partial:=false)->SeqEnum[AlgWeylElt],RngMPolProlSeqElt,RngMPolProlSeqElt
////////////////////
{Given an autoreduced sequence perform Ritt's division algorithm with respect to that element.
In the case of Ritt's ordering this is on page 5 of Ritt's Differential Algebra.
Note that division proceeds with the largest element of G for which f is not RittReduced.
}
    require IsAutoreduced(G): "Must RittDivide by an autoreduced sequence. The SeqEnum G is not autoreduced.";
    require #G gt 0: "Must RittDivide by a nonempty autoreduced sequence.";
    if #G eq 1 then
        quo0,rem0,sep0:=RittDivide(f,G[1] : partial:=partial);
        return [quo0],rem0,sep0;
    else
        G0:=G[2..#G]; //start with the largest element
        quo0,rem0,sep0:=RittDivide(f,G0 : partial:=partial);
        quo1,rem1,sep1:=RittDivide(rem0,G[1] : partial:=partial);
        WR:=WeylAlgebra(Parent(f));
        Quo:=[WR!quo1] cat [WR!sep1*q: q in quo0];
        Rem:=rem1;
        Sep:=sep0*sep1;
        
        /*
        If you are Ritt-reduced with respect to some Gi,
        you should be Ritt-reduced with respect to Gj
        for all j>i in the sequence. See loc. cit.
        */
        
        vprintf RittDivision, 4: "rem1 = %o\n G0 = %o\n ", rem1, G0;
        require IsRittReduced(rem1,G0: partial:=partial): "rem1 is not Ritt-reduced with respect to the first elements.";
        require (Sep*f - &+[Quo[i]@G[i]: i in [1..#G]] eq Rem): "Failure of sep*f-quo*G eq rem";
        
        return Quo,Rem,Sep;
    end if;
end intrinsic;

////////////////////
intrinsic RittRemainder(f::RngMPolProlSeqElt,G::SeqEnum[RngMPolProlSeqElt] :partial:=false)->SeqEnumRngMPolSeqElt
////////////////////
{Given an autoreduced sequence G perform Ritt's division algorithm with respect to G on f.
}
    vprintf RittDivision, 4: "f = %o\n G = %o\n ", f, G;
    Quo,Rem,Sep:=RittDivide(f,G :partial:=partial);
    return Rem;
end intrinsic;


////////////////////
intrinsic RittDividePartial(f::RngMPolProlSeqElt,G::SeqEnum[RngMPolProlSeqElt])->SeqEnum[AlgWeylElt],RngMPolProlSeqElt,RngMPolProlSeqElt
////////////////////
{Reduces f with respect to an autoreduced set only to the point where you don't need to take any more derivatives of elements of G. The result will be in the smallest finite order jet ring which contains all of the elements of G.}
    require IsAutoreduced(G): "must divide by an autoreduced set";//maybe can be relaxed.
    WP:=WeylAlgebra(Parent(f));
    n:=#G;
    
    //initialize
    Rem1:=f;
    Quo1:=[WP!0 : i in [1..n]];
    Quo:=[WP!0 : i in [1..n]];
    Sep1:=P!1;
    
    
    for i in [0..n-1] do
        Quo,Rem1,Sep:=RittDivide(Rem1,G[n-i]:partial:=true);
        for j in [k : k in [1..n]|k ne n-i] do
            Quo1[j]:=Sep*Quo1[j];
        end for;
        Quo1[n-i]:=Sep*Quo1[n-i]+Quo;
        Sep1:=Sep*Sep1;
    end for;

    if IsRittReduced(Rem1,G:partial:=true) then
        Quo:=Quo1;
        Rem:=Rem1;
        Sep:=Sep1;
    else
        Quo2,Rem2,Sep2:=ritt_divide_partial(Rem1,G);
        Sep:=Sep2*Sep1;
        for i in [1..n] do
            Quo[i]:=Sep2*Quo1[i]+Quo2[i];
        end for;
        Rem:=Rem2;
    end if;
    
    assert Sep*f eq &+[Quo[i]@G[i] : i in [1..n]]+Rem;
    return Quo,Rem,Sep;
end intrinsic;

/*
#########################
#########################
Grobner Bases: Ollivier's "Standard Basis" Algorithm
#########################
#########################
*/
////////////////////
intrinsic OllivierDivideStep(f::RngMPolProlSeqElt,g::RngMPolProlSeqElt)->AlgWeylElt,RngMPolProlSeqElt
////////////////////
{
A step in the division algorithm of Ollivier.

This algorithm is based off of
    LeadingMonomial(g) eq LeadingMonomial(Initial(g))*lg^dg;
    LeadingMonomial(Diff(g,i)) eq LeadingMonomial(Initial(g))*lg^(dg-1)*Diff(lg,i)
This means we can test for divisibility of the leading monomial by looking at LM(g)/lg dividing LM(f).
Then we can figure out the order.
}
    lg,dg:=Leader(g);

    WP<D>:=WeylAlgebra(Parent(f));
    Mg:=LeadingMonomial(g)/lg;
    if not IsDivisibleBy(LeadingMonomial(f),Mg) then
        //do nothing.
        Quo:=WP!0;
        Rem:=f;
    else
        //i:=Minimum i, Diff(lg,i) divides LM(f)
        //We always want to reduced with respect to low derivatives first.
        pair0:=Support(Leader(g))[1];
        i:=Minimum([ pair[2] : pair in Support(LeadingMonomial(f)) | pair[1] eq pair0[1] and pair[2] ge pair0[2]]);
        if i eq 0 then
            //LM(g) divides LM(f)
            if IsDivisibleBy(LeadingMonomial(f),lg^dg) then
                Quo:=(LeadingTerm(f)/LeadingTerm(g))*WP!1;;
                Rem:=f-Quo@g;
            else
                Quo:=WP!0;
                Rem:=f;
            end if;

            //LM(Diff(g,i)) divides LM(f)
        elif i gt 0 then
            Quo:=(LeadingTerm(f)/LeadingTerm(Diff(g,i)))*D;
            Rem:=f-Quo@g;
        end if;
    end if;
    
        assert f eq Quo@g+Rem;
        return Quo,Rem;

end intrinsic;

////////////////////
intrinsic OllivierDivide(f::RngMPolProlSeqElt,g::RngMPolProlSeqElt)->AlgWeylElt,RngMPolProlSeqElt
////////////////////
{
pg 310, "Reduction Algorithm", Ollivier, Standard Bases of Differential Ideals.
}


    P:=Parent(f);
    WP<D>:=WeylAlgebra(P);
    
    LMf:=LeadingMonomial(f);
    LMg:=LeadingMonomial(g);

    
    if Degree(LMf) lt Degree(LMg) or Weight(LMf) lt Weight(LMg) then
        
        Quo:=WP!0;
        Rem:=f;
        
    else
        
        Quo0,Rem0:=OllivierDivideStep(f,g);
        
        if Rem0 eq f then
           
            Quo:=Quo0;
            Rem:=Rem0;
           
        else
           
           Quo0,Rem0:=OllivierDivideStep(f,g);
           Quo1,Rem1:=OllivierDivide(f-Quo0@g,g);
           Rem:=Rem1;
           Quo:=Quo0+Quo1;
           
        end if;
        
    end if;
    
    assert f eq Quo@g+Rem;
    return Quo,Rem;

end intrinsic;

/*
#########################
#########################
Characteristic Sets: Rosenfeld-Groebner
#########################
#########################
*/

/*

There is an implementation here. This is a good first one to read. It is not recurrsive and I don't like it.
Boulier,Lazard,Ollivier,Petitot
Computing representations for radicals of finitely generated differential ideals
AAECC (2009) 20:73–121
FIGURE 1, page 96
*/

////////////////////
intrinsic MinimalAutoreducedSub(S0::SeqEnum[RngMPolProlSeqElt]:partial:=false)->SeqEnum[RngMPolProlSeqElt]
////////////////////
{
Given an sequence of differential polynomials, find an subset that is autoreduced an minimal.

This algorithm is described on page 5 of Ritt's Differential Algebra book.
}
    
    if #S0 eq 0 then
        return S0;
    else
    
        assert S0 eq Sorted(S0); //must input a sorted sequence

        Constants:=[f : f in S0 | IsUnit(f)]; //Constants;

        if #Constants gt 0 then
            return [Constants[1]];
        else
            g1:=S0[1];
            S1:=[f : f in S0[2..#S0] | IsRittReduced(f,g1 :partial:=partial)];
            if #S1 gt 0 then
                //print "Applying MinimalAutoreducedSub";
                B:=MinimalAutoreducedSub(S1: partial:=partial);
                return Sorted([g1] cat B);
            else
                return [g1];
            end if;
        end if;
    end if;
end intrinsic;

////////////////////
intrinsic NiceAutoreducedStep(G0::SeqEnum[RngMPolProlSeqElt] : partial:=false)->SeqEnum[RngMPolProlSeqElt]
////////////////////
{
This is the main iteration step of NiceAutoreduced.
At each stage the elements are contained in the differential ideal generated by G0 and the saturation of the differential ideal with respect to the output G1 with respect to their initials and separants contains the differential ideal generated by G0.
}
    A0 := MinimalAutoreducedSub(G0: partial:=partial);
    R := [f : f in G0 | not f in A0];
    
    if #R gt 0 then
        Rred := [RittRemainder(f, A0: partial:=partial) : f in R];
        NonzeroR := [r : r in Rred | r ne 0];

        G1 := A0 cat NonzeroR;
        G1sorted := Sorted(G1);

        return G1sorted;
    else
        return G0;
    end if;

end intrinsic;

////////////////////
intrinsic NiceAutoreduced(F::SeqEnum[RngMPolProlSeqElt]: partial:=false)->SeqEnum[RngMPolProlSeqElt]
////////////////////
{Produces an autoreduced sequence from a sequence F contained in the differential ideal generated by F.
}
    G0 := F;
    A0 := MinimalAutoreducedSub(G0 :partial:=partial);
    G1 := NiceAutoreducedStep(G0:partial:=partial);
    A1 := MinimalAutoreducedSub(G1:partial:=partial);

    while A1 ne A0 do
        G0 :=G1;
        A0 :=A1;
        G1 := NiceAutoreducedStep(G0:partial:=partial);
        A1 := MinimalAutoreducedSub(G1:partial:=partial);
    end while;

    return A0;

end intrinsic;

////////////////////
intrinsic CharacteristicSet(F::SeqEnum[RngMPolProlSeqElt]:partial:=false)->SeqEnum[RngMPolProlSeqElt]
////////////////////
{Produced the minimal characteristic set contained in the differential ideal generated by F. The characteristic set has the property that the differential ideal generated by the output sequence A is contained in the differential ideal generated by F and that the saturation of the differential ideal generated by A by initial and separants of elements of A contained the differential ideal generated by F.}
    F0:=Sorted(F);

    A0 := NiceAutoreduced(F0:partial:=partial);
    A1 := NiceAutoreduced(Sorted(A0 cat F0):partial:=partial);
    while A0 ne A1 do
        A0:=A1;
        A1:=NiceAutoreduced(Sorted(A0 cat F0):partial:=partial);
    end while;
   
    return A0;
end intrinsic;

////////////////////
intrinsic CharacteristicSeriesRaw(F0::SeqEnum[RngMPolProlSeqElt],H0::SeqEnum[RngMPolProlSeqElt])->SeqEnum[SeqEnum[RngMPolProlSeqElt]]
////////////////////
{
This is the Rosenfeld-Groebner algorithm.

Given F0 a collection of differential equations and H0 a collection of differential inequations find a collection of [A,S] where A and S is a collection of differential polynomials with s in S non-zero divisors in R/[A] such that the Sat_H0([F0]) is the intersection of Sat_S([A]) for the varying S and A.

Algorithm 1
Golubitsky,Kondratieva,Maza,Ovchinnikov,Bounds for algorithms in differential algebra, Journal of Symbolic Algebra
http://arxiv.org/abs/math/0702470v1

(The published version is much shorter and has less information.)


}

    U:={@ [Sorted(F0),Sorted(H0)] @};
    T:={@ @};
    
    while #U gt 0 do
        F,H:=Explode(U[1]);
        U:={@u : u in U | u ne U[1]@};
        C:=CharacteristicSet(F);
        rems:=[ RittRemainder(f,C): f in F | not f in C];
        Fbar:=Sorted([ f : f in rems | f ne 0]);
        S_C:={@ s : s in {@ Initial(h) : h in C @} join {@ Separant(h) : h in C @} | not IsUnit(s)@};
        Hbar0:= S_C join {@ RittRemainder(h,C) : h in H @}; //add initial, separants, remainders;
        Hbar1:={@ h: h in Hbar0 | not IsUnit(h) @}; //remove the units
        Hbar:=Sorted([h : h in Hbar1]); //make sure it is sorted
        vprintf RittDivision,2: "Fbar=%o \n",Fbar;
        vprintf RittDivision,2: "Hbar=%o \n",Hbar;

        //make sure Fbar has no units and 0 is not in Hbar
        if #[f : f in Fbar | IsUnit(f)] eq 0 and not 0 in Hbar then

            //if everything is reduced we are done
            if #Fbar eq 0 then
            
                 T := T join {@ [C,Hbar] @};
            
            //otherwise we need to make more shit to analyze
            else
                U := U join {@ [Sorted([x : x in T join C]),Hbar] @};
            end if;

        end if;

        U:=U join {@ [Sorted(F cat [h]),H] : h in S_C | not h in H or not IsUnit(h) @};

    end while;

return [t : t in T];

end intrinsic;

////////////////////
intrinsic CharacteristicSeriesRaw(F0::SeqEnum[RngMPolProlSeqElt])->SeqEnum[SeqEnum[RngMPolProlSeqElt]]
////////////////////
{
A shorthand for CharacteristicSeriesRaw(F0::SeqEnum[RngMPolProlSeqElt],H0::SeqEnum[RngMPolProlSeqElt])
}
    return CharacteristicSeriesRaw(F0,[]);
end intrinsic;


////////////////////
intrinsic Saturate(I::RngMPol,ineqns::SeqEnum[RngMPolElt])->RngMPol
////////////////////
{
Given an ideal I, compute the colon ideal for the multiplicatively closed sets generated by ineqns.
}
    I0:=I;
    for g in ineqns do
        I0:=ColonIdeal(I,g);
    end for;
    return I0;
end intrinsic;

////////////////////
intrinsic Order(eqns::SeqEnum[RngMPolProlSeqElt],ineqns::SeqEnum[RngMPolProlSeqElt])->RngIntElt
////////////////////
{Given equations and inequations return the maximum order of all of them}
    return Maximum([Order(f): f in eqns cat ineqns]);
end intrinsic;


////////////////////
intrinsic clean_up(char_series_raw::SeqEnum[SeqEnum])->SeqEnum[SeqEnum[RngMPolProlSeqElt]],SeqEnum[RngMPol]
////////////////////
{
A helper function that determined which of the outputs of the Rosenfeld-Groebner algorithm give unique ideals.

Given equations F=f1,...,fr and ineqns S=g1,..,gs this we determine if Sat_S((F)) is the trivial ideal.
This is the the same localizing R/(F) at S.

The quotient is R[x1,...,xn,y1,..,ys]/(f1,...,fr,y1*g1-1,...,ys*gs-1)
so to determine if this ring is trivial amounts
to determining if 1 is an element of (f1,...,fr,y1*g1-1,...,ys*gs-1)

We actually do this using magmas Saturation which I believe is doing this.
}
    //FIGURE OUT WHICH ORDER TO WORK IN
    ord:=Maximum([Order(sys[1],sys[2]) : sys in char_series_raw]);
    P:=Parent(char_series_raw[1][1][1]); //we should probably test that these are not empty at the beginning
    
    Jr:=Jet(P,ord);
    
    ideals:=[];
    good_list:=[];
        
    for sys in char_series_raw do
        
        //CONVERT TO EQNS OF FINITE ORDER
        eqns:=Jet(sys[1],ord);
        ineqns:=Jet(sys[2],ord);
        
        //CREATE THE SATURATION IDEAL IN FINITE LEVEL
        ideal:=ideal<Jr|eqns>;
        ideal:=Saturate(ideal,ineqns);
        
        //IS THE IDEAL TRIVIAL?
        if not 1 in ideal then
        
            //DID WE ALREADY SEE THIS IDEAL?
            if not ideal in ideals then
                Append(~ideals,ideal);
                Append(~good_list,sys);
            end if;
    
        end if;
    end for;
    
    return good_list,ideals;

end intrinsic;


////////////////////
intrinsic CharacteristicSeries(F0::SeqEnum[RngMPolProlSeqElt],H0::SeqEnum[RngMPolProlSeqElt])->SeqEnum[SeqEnum[RngMPolProlSeqElt]],SeqEnum[RngMPol]
////////////////////
{
See CharacteristicSeries for a complete description.
}

    char_series_raw:=CharacteristicSeriesRaw(F0,H0);
    mylist,ideals:=clean_up(char_series_raw);
    return mylist,ideals;
    
end intrinsic;

////////////////////
intrinsic CharacteristicSeries(F0::SeqEnum[RngMPolProlSeqElt])->SeqEnum[SeqEnum[RngMPolProlSeqElt]],SeqEnum[RngMPol]
////////////////////
{
A shorthand for CharacteristicSeries(F0::SeqEnum[RngMPolProlSeqElt],H0::SeqEnum[RngMPolProlSeqElt])
}
    return CharacteristicSeries(F0,[]);
end intrinsic;
