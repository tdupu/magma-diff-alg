declare verbose RittDivision, 6;

/*
#########################
#########################
Evaluation and Specialization
#########################
#########################
*/

/*
To evaluate a differential polynomial f of order r at phi1,...,phin
we take derivatives of the phi_j up to order r and then plug them into
f as a polynomial.

If f is a differential polynomial with coefficients in a polynomial ring
with a constant derivation then we Specialize(f,my_seq) applies
Evaluate(my_coeff,my_seq) to all of the coefficeints.

The assumption here is the Jet(Parent(f),-1) is a polynomial ring.
The output will be in a new RngMPolProlSeq.

If f is a differential polynomial with coefficients also differential polynomials
then we use Specialize(f,my_seq) runs Evaluate(my_coeff,my_set) on each
of the coefficients.

Note that in the case where the base ring is a differential ring
not every specialization will be a homomorphism. That is, the specialization
of a differential expression will not necessarily be the specialization of a
simplified differential expression.
*/

////////////////////
intrinsic Jet(f::RngMPolProlSeqElt, r::RngIntElt)->RngMPolElt
////////////////////
{Return the corresponding element of the rth jet space.}
    r0:=Order(f);
    require r ge r0: "Cannot map to a lower order jet space than the order of the element";
    P:=Parent(f);
    elt:=(P!Eltseq(f))`elt;
    assert( elt in Jet(P,r0));
    incl:=map(P,r0,r);
    return incl(elt);
end intrinsic;

////////////////////
intrinsic Jet(f::RngMPolProlSeqElt)->RngMPolElt
////////////////////
{Return the corresponding element of the appropriate jet space.}
    return (Parent(f)!Eltseq(f))`elt;
end intrinsic;

////////////////////
intrinsic Exp(seq::SeqEnum[RngMPolProlSeqElt],r0::RngIntElt)->SeqEnum[RngMPolProlSeqElt]
////////////////////
{Given a sequence of prolongation sequence elements, take the derivatives of each of them up to order r0 and concatenate them into their standard sequence.}
    expseq:=&cat[[ Diff(s,j) : s in seq] : j in [0..r0]];
    return expseq;
end intrinsic;

////////////////////
intrinsic
 Evaluate(f::RngMPolProlSeqElt,seq::SeqEnum[RngMPolProlSeqElt])->RngMPolProlSeqElt
 ////////////////////
{Plug in elements of a sequence into the prolongation sequence element.}
    P1:=Parent(f);
    n1:=Ngens(P1);
    r1:=Order(f);
    ft:=Jet(f,r1);
    
    Ps:={Parent(s) : s in seq};
    require n1 eq #seq: "The sequence must be the number of generators";
    require #Ps eq 1: "All the elements of the sequence must have the same parent";
    P2:=[P : P in Ps][1];
    
    exp_seq:=Exp(seq,r1);
    r2:=Maximum([Order(s) : s in exp_seq]);
    exp_seq_tr:=[Jet(f,r2) : f in exp_seq];
    return P2!Evaluate(ft,exp_seq_tr);

end intrinsic;

////////////////////
intrinsic Specialize(f::RngMPolProlSeqElt,seq1::SeqEnum)->RngMPolProlSeqElt
////////////////////
{Given a f whose coefficients admit and Evaluate function for the coefficients.}
    return &+[ Parent(f)![<Evaluate(t[1],seq1),t[2]>] : t in Eltseq(f)];
end intrinsic;

/*
#########################
#########################
PseudoDivision
#########################
#########################
*/

////////////////////
intrinsic PseudoDivideStep(f::RngMPolElt,g::RngMPolElt,u::RngMPolElt)->RngMPolElt,RngMPolElt,RngMPolElt
////////////////////
{
Given f and g and a variable u return quo, rem, and sep such that sep*f-quo*g eq rem with the degree of rem lower that the degree of g by one.
}
require Parent(f) eq Parent(g): "The two elements must have the same parents";
require Degree(u) eq 1: "u must be an element of degree one.";

    df:=Degree(f,u);
    dg:=Degree(g,u);

    if dg gt df then
        sep:=1;
        rem:=f;
        quo:=0;
        return Parent(f)!quo,Parent(f)!rem,Parent(f)!sep;
    else
        n:=df-dg;
        lcf:=Coefficients(f,u)[df+1];
        lcg:=Coefficients(g,u)[dg+1];
        lcm:=LeastCommonMultiple(lcg,lcf);
        a:=Parent(f)!lcm/lcf;
        b:=Parent(f)!lcm/lcg;
        rem:=a*f-b*u^n*g;
        quo:=b;
        sep:=a;
        return Parent(f)!quo,Parent(f)!rem,Parent(f)!sep;
    end if;
end intrinsic;


////////////////////
intrinsic PseudoDivide(f::RngMPolElt,g::RngMPolElt,u::RngMPolElt)->RngMPolElt,RngMPolElt,RngMPolElt
////////////////////
{
Given f and g and a variable u return quo, rem, and sep such that sep*f-quo*g eq rem and the degree of the remainder is less than the degree of g.
}

    f0:=f;
    g0:=g;
    
    quo:=0;
    rem:=f;
    sep:=1;
    
    while Degree(f0,u) ge Degree(g0,u) do
        quo0,rem0,sep0:=PseudoDivideStep(f0,g0,u);
        f0:=rem0;
        sep:=sep*sep0;
        quo:=quo+quo0;
    end while;
    
    rem:=rem0;
    
    return Parent(f)!quo, Parent(f)!rem, Parent(f)!sep;
end intrinsic;


/*
#########################
#########################
Grobner Bases: Ollivier's "Standard Basis" Algorithm
#########################
#########################
*/

////////////////////
intrinsic Reduction(f::RngMPolProlSeqElt,g::RngMPolProlSeqElt,r::RngIntElt)->RngMPolProlSeqElt
////////////////////
{}
/*
Ollivier's Standard Basis paper.
*/
    LMf:=LeadingMonomial(f);
    LMg:=LeadingMonomial(g);
    if Degree(LMf) gt Degree(LMg) or Weight(LMf) gt Weight(LMg) then
        return f;
    elif Divides(LMg,LMf) then
        LCf:=LeadingCoefficient(f);
        LCg:=LeadingCoefficient(g);
        return Reduction(f-(LCf/LCg)*(LMf/LMg)*g,g,1);
    else
        f2:=Reduction(f,Diff(g,1),1);
        if f2 ne f then
            return Reduction(f2,g,1);
        end if;
    end if;
end intrinsic;

////////////////////
intrinsic Reduction(f::RngMPolProlSeqElt,g::RngMPolProlSeqElt)->RngMPolProlSeqElt
////////////////////
{}
    return Reduction(f,g,1);
end intrinsic;


